{
    "package": "rust-hello-world",
    "version": "0.0.0",
    "type": "host",
    "download": [
        {
            "kind": "git",
            "sha256": "e0fa23f1a3cb1eb1407165bd2fc36d2f6e6ad728",
            "url": "https://github.com/meta-rust/rust-hello-world.git"
        }
    ],
    "dependencies": [
        "*:*:native/_",
        "*:*:native/rust"
    ],
    "build": {
        "steps": [
            "*:*:cargo build --target $RUST_TRIPLET --release",
            "*:*:mkdir -p $STAGING_DIR$PREFIX/bin",
            "*:*:cp ./target/$RUST_TRIPLET/release/rust-hello-world $STAGING_DIR$PREFIX/bin"
        ]
    }
}