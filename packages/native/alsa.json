{
    "package": "native/alsa",
    "version": "1.2.14",
    "type": "native",
    "download": [
        {
            "kind": "tar.bz2",
            "sha256": "be9c88a0b3604367dd74167a2b754a35e142f670292ae47a2fdef27a2ee97a32",
            "url": "https://www.alsa-project.org/files/pub/lib/alsa-lib-1.2.14.tar.bz2"
        }
    ],
    "dependencies": [
        "linux_*:*:native/_/_",
        "linux_*:*:native/bash",
        "linux_*:*:native/coreutils",
        "linux_*:*:native/findutils",
        "linux_*:*:native/gawk",
        "linux_*:*:native/grep",
        "linux_*:*:native/make",
        "linux_*:*:native/pkgconf",
        "linux_*:*:native/sed"
    ],
    "build": {
        "env": [],
        "steps": [
            "linux_*:*:bash ./configure --prefix=$NATIVEPREFIX --enable-shared --disable-static --disable-python --disable-dependency-tracking --enable-option-checking",
            "linux_*:*:make -j$NUM_CORES",
            "linux_*:*:make DESTDIR=$STAGING_DIR install",
            "linux_*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/lib/pkgconfig && if [ -d $STAGING_DIR$NATIVEPREFIX/share/pkgconfig ]; then mv $STAGING_DIR$NATIVEPREFIX/share/pkgconfig/*.pc $STAGING_DIR$NATIVEPREFIX/lib/pkgconfig/ 2>/dev/null || true; fi",
            "linux_*:*:rm -rf $STAGING_DIR$NATIVEPREFIX/share/doc $STAGING_DIR$NATIVEPREFIX/share/man $STAGING_DIR$NATIVEPREFIX/lib/*.la"
        ]
    }
}