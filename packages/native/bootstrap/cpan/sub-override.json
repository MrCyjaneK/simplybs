{
    "package": "native/bootstrap/cpan/sub-override",
    "version": "0.09",
    "type": "native",
    "download": [
        {
            "kind": "tar.gz",
            "sha256": "939a67c1f729968e0cc81b74958db750e1bdb7c020bee1a263332f422c2e25b5",
            "url": "https://cpan.metacpan.org/authors/id/O/OV/OVID/Sub-Override-0.09.tar.gz"
        }
    ],
    "dependencies": [
        "*:native/bootstrap/make",
        "*:native/bootstrap/perl"
    ],
    "build": {
        "env": [
            "*:PATH=$PREFIX/native/bootstrap/bin:$PATH"
        ],
        "steps": [
            "*:$PREFIX/native/bootstrap/bin/perl Makefile.PL PREFIX=$PREFIX/native/bootstrap",
            "*:make -j$NUM_CORES",
            "*:make DESTDIR=$STAGING_DIR install"
        ]
    }
}