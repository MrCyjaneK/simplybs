{
    "package": "native/perl",
    "version": "5.42.1",
    "type": "native",
    "download": [
        {
            "kind": "tar.gz",
            "sha256": "6f84e6dc8cce97181d1c6aeeb552c13775c91ded3c6c73743c9211af87b16bf8",
            "url": "http://www.cpan.org/src/5.0/perl-5.42.1.tar.gz"
        }
    ],
    "dependencies": [
        "*:*:native/_/_",
        "*:*:native/bash",
        "*:*:native/make",
        "*:*:native/sed"
    ],
    "build": {
        "env": [],
        "steps": [
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/lib $NATIVEPREFIX/lib",
            "*:*:sed -i.bak '/^#ifndef PERL_BUILD_DATE$/,/^#endif$/{/^#ifndef PERL_BUILD_DATE$/!d; s/.*/\\#define PERL_BUILD_DATE \"Jan  1 1970 00:00:01\"/;}' perl.c",
            "*:*:bash ./Configure -des -Dprefix=$NATIVEPREFIX -Duseithreads -Dall_static -Dcc=$CC",
            "*:*:make -j$NUM_CORES CC=$CC",
            "*:*:make DESTDIR=$STAGING_DIR install CC=$CC"
        ]
    }
}