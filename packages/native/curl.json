{
    "package": "native/curl",
    "version": "8.15.0",
    "type": "native",
    "download": [
        {
            "kind": "tar.gz",
            "sha256": "d85cfc79dc505ff800cb1d321a320183035011fa08cb301356425d86be8fc53c",
            "url": "https://curl.se/download/curl-8.15.0.tar.gz"
        }
    ],
    "dependencies": [
        "*:native/libpsl",
        "*:native/make",
        "*:native/openssl"
    ],
    "build": {
        "env": [
            "*:config_opts=--with-openssl"
        ],
        "steps": [
            "*:./configure $config_opts --prefix=$PREFIX/native",
            "*:make -j$NUM_CORES",
            "*:make DESTDIR=$STAGING_DIR install"
        ]
    }
}