{
    "package": "native/crosstool-ng",
    "version": "1.27.0",
    "type": "native",
    "download": [
        {
            "kind": "tar.xz",
            "sha256": "0506ab98fa0ad6d263a555feeb2c7fff9bc24a434635d4b0cdff9137fe5b4477",
            "url": "http://crosstool-ng.org/download/crosstool-ng/crosstool-ng-1.27.0.tar.xz"
        }
    ],
    "dependencies": [
        "all:native/autoconf",
        "all:native/automake",
        "all:native/bash",
        "all:native/bison",
        "all:native/flex",
        "all:native/help2man",
        "all:native/libtool",
        "all:native/m4",
        "all:native/make",
        "all:native/perl",
        "all:native/python@3.11.13",
        "all:native/sed",
        "all:native/texinfo",
        "all:native/zlib"
    ],
    "build": {
        "env": [
            "x86_64-linux-gnu:TOOL_TARGET=x86_64-linux-gnu"
        ],
        "steps": [
            "all:./bootstrap",
            "all:./configure --prefix=$PREFIX/native",
            "all:make -j$NUM_CORES",
            "all:make install DESTDIR=$STAGING_DIR"
        ]
    }
}