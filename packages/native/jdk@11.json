{
    "package": "native/jdk@11",
    "version": "11.0.32.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "30abc58ea74716e0d260bad1e5d6f3545f9a9332",
            "url": "https://git.openjdk.org/jdk11u"
        }
    ],
    "dependencies": [
        "*:*:native/_/_",
        "darwin_*:*:native/_",
        "*:*:native/7zip",
        "*:*:native/autoconf",
        "*:*:native/m4",
        "*:*:native/perl",
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/file",
        "*:*:native/findutils",
        "*:*:native/gawk",
        "*:*:native/grep",
        "*:*:native/gzip",
        "*:*:native/tar",
        "*:*:native/make",
        "*:*:native/pkgconf",
        "*:*:native/sed",
        "*:*:native/unzip",
        "*:*:native/zip",
        "*:*:native/zlib",
        "*:*:native/jdk@11-bin",
        "linux_*:*:native/xorgproto",
        "linux_*:*:native/xtrans",
        "linux_*:*:native/libXau",
        "linux_*:*:native/libXdmcp",
        "linux_*:*:native/libxcb",
        "linux_*:*:native/libX11",
        "linux_*:*:native/libXext",
        "linux_*:*:native/libXfixes",
        "linux_*:*:native/libXrender",
        "linux_*:*:native/libXrandr",
        "linux_*:*:native/libXi",
        "linux_*:*:native/libXtst",
        "linux_*:*:native/libICE",
        "linux_*:*:native/libSM",
        "linux_*:*:native/libXt",
        "linux_*:*:native/cups",
        "linux_*:*:native/freetype",
        "linux_*:*:native/fontconfig",
        "linux_*:*:native/alsa",
        "*:*:native/patch"
    ],
    "build": {
        "env": [
            "*:*:JDK_VERSION=11",
            "*:*:BOOT_JDK=$NATIVEPREFIX/jdk-11"
        ],
        "steps": [
            "*:*:patch -p1 < $PATCH_DIR/jdk/8229258-markoop-jdk11.patch",
            "*:*:bash $PATCH_DIR/jdk/build.sh",
            "*:*:bash $PATCH_DIR/jdk/stage.sh"
        ]
    }
}