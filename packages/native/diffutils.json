{
    "package": "native/diffutils",
    "version": "3.12",
    "type": "native",
    "download": [
        {
            "kind": "tar.xz",
            "sha256": "7c8b7f9fc8609141fdea9cece85249d308624391ff61dedaf528fcb337727dfd",
            "url": "https://ftp.gnu.org/gnu/diffutils/diffutils-3.12.tar.xz"
        }
    ],
    "dependencies": [
        "*:*:native/_/_",
        "*:*:native/autoconf",
        "*:*:native/bash",
        "*:*:native/libiconv",
        "*:*:native/make",
        "*:*:native/perl"
    ],
    "build": {
        "env": [
            "*:*:config_opts=--prefix=$NATIVEPREFIX",
            "*:*:LIBS=-liconv",
            "windows_*:*:config_opts=$config_opts gl_cv_have_weak=no"
        ],
        "steps": [
            "*:*:bash ./configure $config_opts",
            "windows_*:*:bash $PATCH_DIR/native/_/drop-gnulib-wint-wrappers.sh",
            "*:*:make -j$NUM_CORES",
            "*:*:make DESTDIR=$STAGING_DIR install"
        ]
    }
}