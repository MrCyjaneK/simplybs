{
    "package": "native/mpc",
    "version": "1.3.1",
    "type": "native",
    "download": [
        {
            "kind": "tar.gz",
            "sha256": "ab642492f5cf882b74aa0cb730cd410a81edcdbec895183ce930e706c1c759b8",
            "url": "http://ftpmirror.gnu.org/gnu/mpc/mpc-1.3.1.tar.gz"
        }
    ],
    "dependencies": [
        "*:*:native/_/_",
        "*:*:native/bash",
        "*:*:native/gmp_static",
        "*:*:native/make",
        "*:*:native/mpfr"
    ],
    "build": {
        "env": [
            "*:*:config_opts=--prefix=$NATIVEPREFIX",
            "*:*:config_opts=$config_opts --disable-shared",
            "*:*:config_opts=$config_opts --enable-static"
        ],
        "steps": [
            "*:*:bash ./configure $config_opts",
            "*:*:make -j$NUM_CORES",
            "*:*:make DESTDIR=$STAGING_DIR install"
        ]
    }
}