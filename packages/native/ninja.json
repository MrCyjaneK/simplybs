{
    "package": "native/ninja",
    "version": "1.13.1",
    "type": "native",
    "download": [
        {
            "kind": "tar.gz",
            "sha256": "f0055ad0369bf2e372955ba55128d000cfcc21777057806015b45e4accbebf23",
            "url": "https://github.com/ninja-build/ninja/archive/refs/tags/v1.13.1.tar.gz"
        }
    ],
    "dependencies": [
        "*:*:native/_/_",
        "*:*:native/python@3.11",
        "*:*:native/coreutils"
    ],
    "build": {
        "env": [],
        "steps": [
            "*:*:python3 ./configure.py --bootstrap",
