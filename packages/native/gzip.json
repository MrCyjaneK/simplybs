{
    "package": "native/gzip",
    "version": "1.14",
    "type": "native",
    "download": [
        {
            "kind": "tar.xz",
            "sha256": "01a7b881bd220bfdf615f97b8718f80bdfd3f6add385b993dcf6efd14e8c0ac6",
            "url": "http://ftpmirror.gnu.org/gnu/gzip/gzip-1.14.tar.xz"
        }
    ],
    "dependencies": [
        "*:*:native/_/_",
        "*:*:native/bash",
        "*:*:native/make"
    ],
    "build": {
        "env": [
            "*:*:config_opts=--prefix=$NATIVEPREFIX",
            "windows_*:*:config_opts=$config_opts gl_cv_have_weak=no"
        ],
        "steps": [
            "*:*:bash ./configure $config_opts",
            "windows_*:*:bash $PATCH_DIR/native/_/drop-gnulib-wint-wrappers.sh",
            "*:*:make -j$NUM_CORES",
            "*:*:make DESTDIR=$STAGING_DIR install"
        ]
    }
}