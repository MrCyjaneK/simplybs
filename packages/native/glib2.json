{
    "package": "native/glib2",
    "version": "2.86",
    "type": "native",
    "download": [
        {
            "kind": "tar.xz",
            "sha256": "d4e2b5d791d5015ffd8c6971ad8e975a0a55c1a14926cdb25cf843ff00682260",
            "url": "https://download.gnome.org/sources/glib/2.86/glib-2.86.4.tar.xz"
        }
    ],
    "dependencies": [
        "*:*:native/bison",
        "*:*:native/flex",
        "*:*:native/gettext",
        "*:*:native/libiconv",
        "*:*:native/meson",
        "*:*:native/ninja",
        "*:*:native/pcre2",
        "*:*:native/pkgconf",
        "*:*:native/python@3.14"
    ],
    "build": {
        "env": [],
        "steps": [
