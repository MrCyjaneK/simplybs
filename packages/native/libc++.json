{
    "package": "native/libc++",
    "version": "21.1.3",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "450f52eec88f728c89a9efd667dbeaf2dad93826",
            "url": "https://github.com/llvm/llvm-project"
        }
    ],
    "dependencies": [
        "*:*:native/cmake",
        "*:*:native/ninja"
    ],
    "build": {
        "env": [
            "*:*:config_opts=-DLLVM_ENABLE_RUNTIMES='libunwind;libcxx;libcxxabi'",
            "*:*:config_opts=$config_opts -DCMAKE_BUILD_TYPE=Release",
            "*:*:config_opts=$config_opts -DLIBCXX_ENABLE_SHARED=OFF",
            "*:*:config_opts=$config_opts -DLIBCXX_ENABLE_STATIC=ON",
            "*:*:config_opts=$config_opts -DLIBCXX_INCLUDE_TESTS=OFF",
            "*:*:config_opts=$config_opts -DCMAKE_INSTALL_PREFIX=$NATIVEPREFIX"
        ],
        "steps": [
            "*:*:mkdir build && cd build",
            "*:*:cd build && cmake -G Ninja ../runtimes $config_opts",
            "*:*:cd build && ninja unwind cxx cxxabi",
            "*:*:cd build && DESTDIR=$STAGING_DIR ninja install-unwind",
            "*:*:cd build && DESTDIR=$STAGING_DIR ninja install-cxx",
            "*:*:cd build && DESTDIR=$STAGING_DIR ninja install-cxxabi"
        ]
    }
}