{
    "package": "native/fontconfig",
    "version": "2.12.6",
    "type": "native",
    "download": [
        {
            "kind": "tar.gz",
            "sha256": "064b9ebf060c9e77011733ac9dc0e2ce92870b574cca2405e11f5353a683c334",
            "url": "https://www.freedesktop.org/software/fontconfig/release/fontconfig-2.12.6.tar.gz"
        }
    ],
    "dependencies": [
        "linux_*:*:native/_/_",
        "linux_*:*:native/bash",
        "linux_*:*:native/coreutils",
        "linux_*:*:native/expat",
        "linux_*:*:native/findutils",
        "linux_*:*:native/freetype",
        "linux_*:*:native/gawk",
        "linux_*:*:native/grep",
        "linux_*:*:native/gperf",
        "linux_*:*:native/make",
        "linux_*:*:native/patch",
        "linux_*:*:native/pkgconf",
        "linux_*:*:native/sed"
    ],
    "build": {
        "env": [],
        "steps": [
            "linux_*:*:patch -p1 < $PATCH_DIR/fontconfig/gperf_header_regen.patch",
            "linux_*:*:bash ./configure --prefix=$NATIVEPREFIX --enable-shared --disable-static --disable-docs --disable-libxml2 --disable-iconv --disable-dependency-tracking --enable-option-checking",
            "linux_*:*:make -j$NUM_CORES",
            "linux_*:*:make DESTDIR=$STAGING_DIR install",
            "linux_*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/lib/pkgconfig && if [ -d $STAGING_DIR$NATIVEPREFIX/share/pkgconfig ]; then mv $STAGING_DIR$NATIVEPREFIX/share/pkgconfig/*.pc $STAGING_DIR$NATIVEPREFIX/lib/pkgconfig/ 2>/dev/null || true; fi",
            "linux_*:*:rm -rf $STAGING_DIR$NATIVEPREFIX/var $STAGING_DIR$NATIVEPREFIX/share/doc $STAGING_DIR$NATIVEPREFIX/share/man $STAGING_DIR$NATIVEPREFIX/lib/*.la"
        ]
    }
}