{
    "package": "native/rsync",
    "version": "3.4.1",
    "type": "native",
    "download": [
        {
            "kind": "tar.gz",
            "sha256": "2924bcb3a1ed8b551fc101f740b9f0fe0a202b115027647cf69850d65fd88c52",
            "url": "https://github.com/RsyncProject/rsync/releases/download/v3.4.1/rsync-3.4.1.tar.gz"
        }
    ],
    "dependencies": [
        "*:*:native/make",
        "*:*:native/python@3.11"
    ],
    "build": {
        "env": [
            "*:*:config_opts=--prefix=$NATIVEPREFIX",
            "*:*:config_opts=$config_opts --disable-xxhash",
            "*:*:config_opts=$config_opts --disable-openssl",
            "*:*:config_opts=$config_opts --disable-zstd",
            "*:*:config_opts=$config_opts --disable-lz4"
        ],
        "steps": [
            "*:*:./configure $config_opts",
            "*:*:make -j$NUM_CORES",
            "*:*:make DESTDIR=$STAGING_DIR install"
        ]
    }
}