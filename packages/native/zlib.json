{
    "package": "native/zlib",
    "version": "1.3.1",
    "type": "native",
    "download": [
        {
            "kind": "tar.gz",
            "sha256": "9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23",
            "url": "http://www.zlib.net/zlib-1.3.1.tar.gz"
        }
    ],
    "dependencies": [
        "*:*:native/libtool",
        "*:*:native/make"
    ],
    "build": {
        "env": [
            "*:*:CFLAGS=$CFLAGS -fPIC",
            "*:*:config_opts=--prefix=$PREFIX/native --static",
            "*:*:LIBTOOL=$PREFIX/native/bin/libtool",
            "*:*:CROSS_PREFIX=$HOST-"
        ],
        "steps": [
            "*:*:./configure $config_opts",
            "*:*:make -j$NUM_CORES",
            "*:*:make DESTDIR=$STAGING_DIR install"
        ]
    }
}