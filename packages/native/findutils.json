{
    "package": "native/findutils",
    "version": "4.10.0",
    "type": "native",
    "download": [
        {
            "kind": "tar.xz",
            "sha256": "1387e0b67ff247d2abde998f90dfbf70c1491391a59ddfecb8ae698789f0a4f5",
            "url": "https://ftp.gnu.org/gnu/findutils/findutils-4.10.0.tar.xz"
        }
    ],
    "dependencies": [
        "*:*:native/make",
        "*:*:native/grep",
        "*:*:native/sed",
        "*:*:native/bash",
        "*:*:native/_/_"
    ],
    "build": {
        "env": [
            "*:*:config_opts=--prefix=$NATIVEPREFIX"
        ],
        "steps": [
            "*:*:bash ./configure $config_opts",
            "*:*:make -j$NUM_CORES",
            "*:*:DESTDIR=$STAGING_DIR make install"
        ]
    }
}