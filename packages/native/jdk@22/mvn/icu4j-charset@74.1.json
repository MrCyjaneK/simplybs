{
    "package": "native/jdk@22/mvn/icu4j-charset@74.1",
    "version": "74.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "9edac7b78327a1cb58db29e2714b15f9fa14e4d7",
            "url": "https://github.com/unicode-org/icu.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/mvn/icu4j@74.1"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/icu4j-charset@74.1",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes $WORKDIR/data",
            "*:*:find icu4j/main/charset/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -encoding UTF-8 -cp $REPO/com/ibm/icu/icu4j/74.1/icu4j-74.1.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:find icu4j/main/charset/src/main/resources -type f 2>/dev/null | while IFS= read -r f; do rel=${f#icu4j/main/charset/src/main/resources/}; mkdir -p $WORKDIR/classes/$(dirname $rel); cp $f $WORKDIR/classes/$rel; done",
            "*:*:ICU_ROOT=$PWD && cd $WORKDIR/data && $JAVA_HOME/bin/jar xf $ICU_ROOT/icu4j/main/shared/data/icudata.jar",
            "*:*:mkdir -p $WORKDIR/classes/com/ibm/icu/impl/data/icudt74b",
            "*:*:cp $WORKDIR/data/com/ibm/icu/impl/data/icudt74b/*.cnv $WORKDIR/data/com/ibm/icu/impl/data/icudt74b/cnvalias.icu $WORKDIR/classes/com/ibm/icu/impl/data/icudt74b/",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/icu4j-charset-74.1.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/ibm/icu/icu4j-charset/74.1",
            "*:*:cp $WORKDIR/icu4j-charset-74.1.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/ibm/icu/icu4j-charset/74.1/icu4j-charset-74.1.jar"
        ]
    }
}