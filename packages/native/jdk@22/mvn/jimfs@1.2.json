{
    "package": "native/jdk@22/mvn/jimfs@1.2",
    "version": "1.2",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "3bc54fae2feb218dcf5427d2626720fc09ef38d1",
            "url": "https://github.com/google/jimfs.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/mvn/guava@31.0.1-jre",
        "*:*:native/jdk@22/mvn/failureaccess@1.0.1",
        "*:*:native/jdk@22/mvn/jsr305@3.0.2",
        "*:*:native/jdk@22/mvn/checker-qual@3.12.0",
        "*:*:native/jdk@22/mvn/j2objc-annotations@1.3"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/jimfs@1.2",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes $WORKDIR/stubs/org/checkerframework/checker/nullness/compatqual $WORKDIR/stubs/com/google/auto/service $WORKDIR/stubs/com/ibm/icu/lang",
            "*:*:printf '%s\\n' 'package org.checkerframework.checker.nullness.compatqual;' 'import java.lang.annotation.*;' '@Retention(RetentionPolicy.CLASS) @Target({ElementType.TYPE_USE, ElementType.TYPE_PARAMETER, ElementType.FIELD, ElementType.METHOD, ElementType.PARAMETER, ElementType.LOCAL_VARIABLE})' 'public @interface NullableDecl {}' >$WORKDIR/stubs/org/checkerframework/checker/nullness/compatqual/NullableDecl.java",
            "*:*:printf '%s\\n' 'package org.checkerframework.checker.nullness.compatqual;' 'import java.lang.annotation.*;' '@Retention(RetentionPolicy.CLASS) @Target({ElementType.TYPE_USE, ElementType.TYPE_PARAMETER, ElementType.FIELD, ElementType.METHOD, ElementType.PARAMETER, ElementType.LOCAL_VARIABLE})' 'public @interface NonNullDecl {}' >$WORKDIR/stubs/org/checkerframework/checker/nullness/compatqual/NonNullDecl.java",
            "*:*:printf '%s\\n' 'package com.google.auto.service;' 'import java.lang.annotation.*;' '@Retention(RetentionPolicy.SOURCE) @Target(ElementType.TYPE)' 'public @interface AutoService { Class<?>[] value(); }' >$WORKDIR/stubs/com/google/auto/service/AutoService.java",
            "*:*:printf '%s\\n' 'package com.ibm.icu.lang;' 'public class UCharacter { public static String foldCase(String s, boolean aggressive) { return s.toLowerCase(); } }' >$WORKDIR/stubs/com/ibm/icu/lang/UCharacter.java",
            "*:*:$JAVA_HOME/bin/javac --release 8 -d $WORKDIR/classes $WORKDIR/stubs/org/checkerframework/checker/nullness/compatqual/NullableDecl.java $WORKDIR/stubs/org/checkerframework/checker/nullness/compatqual/NonNullDecl.java $WORKDIR/stubs/com/google/auto/service/AutoService.java $WORKDIR/stubs/com/ibm/icu/lang/UCharacter.java",
            "*:*:find jimfs/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $WORKDIR/classes:$REPO/com/google/guava/guava/31.0.1-jre/guava-31.0.1-jre.jar:$REPO/com/google/guava/failureaccess/1.0.1/failureaccess-1.0.1.jar:$REPO/com/google/code/findbugs/jsr305/3.0.2/jsr305-3.0.2.jar:$REPO/org/checkerframework/checker-qual/3.12.0/checker-qual-3.12.0.jar:$REPO/com/google/j2objc/j2objc-annotations/1.3/j2objc-annotations-1.3.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:mkdir -p $WORKDIR/classes/META-INF/services",
            "*:*:echo com.google.common.jimfs.JimfsFileSystemProvider >$WORKDIR/classes/META-INF/services/java.nio.file.spi.FileSystemProvider",
            "*:*:rm -rf $WORKDIR/classes/org/checkerframework $WORKDIR/classes/com/google/auto $WORKDIR/classes/com/ibm",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/jimfs-1.2.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/jimfs/jimfs/1.2",
            "*:*:cp $WORKDIR/jimfs-1.2.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/jimfs/jimfs/1.2/jimfs-1.2.jar"
        ]
    }
}