{
    "package": "native/jdk@22/mvn/jopt-simple@4.6",
    "version": "4.6",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "60979e99102ad93a0e42d9f3a03ad29e1ec0f55c",
            "url": "https://github.com/jopt-simple/jopt-simple.git"
        }
    ],
    "dependencies": [
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/jopt-simple@4.6"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/jopt-simple-4.6.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/net/sf/jopt-simple/jopt-simple/4.6",
            "*:*:cp $WORKDIR/jopt-simple-4.6.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/net/sf/jopt-simple/jopt-simple/4.6/jopt-simple-4.6.jar"
        ]
    }
}