{
    "package": "native/jdk@22/mvn/antlr4-runtime@4.12.0",
    "version": "4.12.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "a2c349f9bf268cf75aaf8cddff90a767e703d489",
            "url": "https://github.com/antlr/antlr4.git"
        }
    ],
    "dependencies": [
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/antlr4-runtime@4.12.0"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find runtime/Java/src/org -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/antlr4-runtime-4.12.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/antlr/antlr4-runtime/4.12.0",
            "*:*:cp $WORKDIR/antlr4-runtime-4.12.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/antlr/antlr4-runtime/4.12.0/antlr4-runtime-4.12.0.jar"
        ]
    }
}