{
    "package": "native/jdk@22/mvn/jline-builtins@3.23.0",
    "version": "3.23.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "cc57d0bab938742459e414400e4241ef261edcbe",
            "url": "https://github.com/jline/jline3.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/mvn/jline-native@3.23.0",
        "*:*:native/jdk@22/mvn/jline-terminal@3.23.0",
        "*:*:native/jdk@22/mvn/jline-reader@3.23.0",
        "*:*:native/jdk@22/mvn/jline-style@3.23.0"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/jline-builtins@3.23.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes $WORKDIR/uchardet/org/mozilla/universalchardet",
            "*:*:printf '%s\\n' 'package org.mozilla.universalchardet;' 'public class UniversalDetector {' '  public UniversalDetector(Object hint) {}' '  public void handleData(byte[] buf, int offset, int length) {}' '  public void dataEnd() {}' '  public String getDetectedCharset() { return null; }' '}' >$WORKDIR/uchardet/org/mozilla/universalchardet/UniversalDetector.java",
            "*:*:$JAVA_HOME/bin/javac --release 8 -d $WORKDIR/uchardet $WORKDIR/uchardet/org/mozilla/universalchardet/UniversalDetector.java",
            "*:*:find builtins/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $WORKDIR/uchardet:$REPO/org/jline/jline-reader/3.23.0/jline-reader-3.23.0.jar:$REPO/org/jline/jline-style/3.23.0/jline-style-3.23.0.jar:$REPO/org/jline/jline-terminal/3.23.0/jline-terminal-3.23.0.jar:$REPO/org/jline/jline-native/3.23.0/jline-native-3.23.0.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:find builtins/src/main/resources -type f 2>/dev/null | while IFS= read -r f; do rel=${f#builtins/src/main/resources/}; mkdir -p $WORKDIR/classes/$(dirname $rel); cp $f $WORKDIR/classes/$rel; done",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/jline-builtins-3.23.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/jline/jline-builtins/3.23.0",
            "*:*:cp $WORKDIR/jline-builtins-3.23.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/jline/jline-builtins/3.23.0/jline-builtins-3.23.0.jar"
        ]
    }
}