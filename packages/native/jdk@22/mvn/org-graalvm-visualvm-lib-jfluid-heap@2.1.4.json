{
    "package": "native/jdk@22/mvn/org-graalvm-visualvm-lib-jfluid-heap@2.1.4",
    "version": "2.1.4",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "53e1c5580792637c5a964bc5193e4fc2e9f00095",
            "url": "https://github.com/oracle/visualvm.git"
        }
    ],
    "dependencies": [
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/org-graalvm-visualvm-lib-jfluid-heap@2.1.4"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find visualvm/libs.profiler/lib.profiler.heap/src -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/org-graalvm-visualvm-lib-jfluid-heap-2.1.4.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/graalvm/visualvm/modules/org-graalvm-visualvm-lib-jfluid-heap/2.1.4",
            "*:*:cp $WORKDIR/org-graalvm-visualvm-lib-jfluid-heap-2.1.4.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/graalvm/visualvm/modules/org-graalvm-visualvm-lib-jfluid-heap/2.1.4/org-graalvm-visualvm-lib-jfluid-heap-2.1.4.jar"
        ]
    }
}