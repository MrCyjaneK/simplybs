{
    "package": "native/jdk@22/mvn/jline-terminal@3.23.0",
    "version": "3.23.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "cc57d0bab938742459e414400e4241ef261edcbe",
            "url": "https://github.com/jline/jline3.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/mvn/jline-native@3.23.0"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/jline-terminal@3.23.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find terminal/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/org/jline/jline-native/3.23.0/jline-native-3.23.0.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:find terminal/src/main/resources -type f 2>/dev/null | while IFS= read -r f; do rel=${f#terminal/src/main/resources/}; mkdir -p $WORKDIR/classes/$(dirname $rel); cp $f $WORKDIR/classes/$rel; done",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/jline-terminal-3.23.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/jline/jline-terminal/3.23.0",
            "*:*:cp $WORKDIR/jline-terminal-3.23.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/jline/jline-terminal/3.23.0/jline-terminal-3.23.0.jar"
        ]
    }
}