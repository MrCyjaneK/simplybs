{
    "package": "native/jdk@22/bootstrap-maven/plexus-xml@3.0.1",
    "version": "3.0.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "86d35785396e1e8a02ce231c6aa9a7042f2ebd66",
            "url": "https://github.com/codehaus-plexus/plexus-xml.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/plexus-xml@3.0.1"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-xml-3.0.1.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-xml/3.0.1",
            "*:*:cp $WORKDIR/plexus-xml-3.0.1.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-xml/3.0.1/plexus-xml-3.0.1.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-xml/3.0.1/plexus-xml-3.0.1.pom"
        ]
    }
}