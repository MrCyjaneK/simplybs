{
    "package": "native/jdk@22/bootstrap-maven/commons-cli@1.11.0",
    "version": "1.11.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "d74613321325f6081fa0206c4ab608ab65d80e2e",
            "url": "https://github.com/apache/commons-cli.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/commons-parent@91"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/commons-cli@1.11.0"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/commons-cli-1.11.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-cli/commons-cli/1.11.0",
            "*:*:cp $WORKDIR/commons-cli-1.11.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-cli/commons-cli/1.11.0/commons-cli-1.11.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-cli/commons-cli/1.11.0/commons-cli-1.11.0.pom"
        ]
    }
}