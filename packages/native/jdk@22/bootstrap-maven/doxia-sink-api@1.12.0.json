{
    "package": "native/jdk@22/bootstrap-maven/doxia-sink-api@1.12.0",
    "version": "1.12.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "281dc2c380cc14ba758d693c5b463186c53c2fb5",
            "url": "https://github.com/apache/maven-doxia.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/doxia@1.12.0",
        "*:*:native/jdk@22/bootstrap-maven/doxia-logging-api@1.12.0"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/doxia-sink-api@1.12.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find doxia-sink-api/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $REPO/org/apache/maven/doxia/doxia-logging-api/1.12.0/doxia-logging-api-1.12.0.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/doxia-sink-api-1.12.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/doxia/doxia-sink-api/1.12.0",
            "*:*:cp $WORKDIR/doxia-sink-api-1.12.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/doxia/doxia-sink-api/1.12.0/doxia-sink-api-1.12.0.jar",
            "*:*:cp doxia-sink-api/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/doxia/doxia-sink-api/1.12.0/doxia-sink-api-1.12.0.pom"
        ]
    }
}