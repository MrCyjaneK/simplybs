{
    "package": "native/jdk@22/bootstrap-maven/svnkit@1.10.11",
    "version": "1.10.11",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "914ea80c67839693464115a78fe5dbaecd3cec98",
            "url": "https://git.tmatesoft.com/repos/svnkit.git"
        },
        {
            "kind": "blob",
            "path": "./svnkit-1.10.11.pom",
            "sha256": "56c9f6d2e4a719c6004398a7c7c9a24167c1f6d387154d494f2aab5cb577a9ea",
            "url": "https://repo1.maven.org/maven2/org/tmatesoft/svnkit/svnkit/1.10.11/svnkit-1.10.11.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/sshd@2.9.2",
        "*:*:native/jdk@22/bootstrap-maven/eddsa@0.3.0",
        "*:*:native/jdk@22/bootstrap-maven/sequence-library@1.0.4",
        "*:*:native/jdk@22/bootstrap-maven/sqljet@1.1.15",
        "*:*:native/jdk@22/bootstrap-maven/antlr-runtime@3.4",
        "*:*:native/jdk@22/bootstrap-maven/jna@5.6.0",
        "*:*:native/jdk@22/bootstrap-maven/trilead-ssh2@1.0.0-build222",
        "*:*:native/jdk@22/bootstrap-maven/jsch.agentproxy@0.0.9",
        "*:*:native/jdk@22/bootstrap-maven/lz4-java@1.4.1",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.32",
        "*:*:native/jdk@22/bootstrap-maven/bouncycastle@1.70"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/svnkit@1.10.11",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find svnkit/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -encoding UTF-8 -cp $REPO/org/apache/sshd/sshd-core/2.9.2/sshd-core-2.9.2.jar:$REPO/org/apache/sshd/sshd-common/2.9.2/sshd-common-2.9.2.jar:$REPO/net/i2p/crypto/eddsa/0.3.0/eddsa-0.3.0.jar:$REPO/de/regnis/q/sequence/sequence-library/1.0.4/sequence-library-1.0.4.jar:$REPO/org/tmatesoft/sqljet/sqljet/1.1.15/sqljet-1.1.15.jar:$REPO/org/antlr/antlr-runtime/3.4/antlr-runtime-3.4.jar:$REPO/net/java/dev/jna/jna/5.6.0/jna-5.6.0.jar:$REPO/net/java/dev/jna/jna-platform/5.6.0/jna-platform-5.6.0.jar:$REPO/com/trilead/trilead-ssh2/1.0.0-build222/trilead-ssh2-1.0.0-build222.jar:$REPO/com/jcraft/jsch.agentproxy.core/0.0.9/jsch.agentproxy.core-0.0.9.jar:$REPO/com/jcraft/jsch.agentproxy.connector-factory/0.0.9/jsch.agentproxy.connector-factory-0.0.9.jar:$REPO/com/jcraft/jsch.agentproxy.svnkit-trilead-ssh2/0.0.9/jsch.agentproxy.svnkit-trilead-ssh2-0.0.9.jar:$REPO/org/lz4/lz4-java/1.4.1/lz4-java-1.4.1.jar:$REPO/org/slf4j/slf4j-api/1.7.32/slf4j-api-1.7.32.jar:$REPO/org/bouncycastle/bcprov-jdk15on/1.70/bcprov-jdk15on-1.70.jar:$REPO/org/bouncycastle/bcutil-jdk15on/1.70/bcutil-jdk15on-1.70.jar:$REPO/org/bouncycastle/bcpkix-jdk15on/1.70/bcpkix-jdk15on-1.70.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:cp -R svnkit/src/main/resources/. $WORKDIR/classes/",
            "*:*:printf '%s\\n' 'svnkit.version=1.10.11' 'build.number=r1.10.11' 'svnkit.version.string=SVN/1.10.0 SVNKit/1.10.11 (http://svnkit.com/) r1.10.11' 'svnkit.version.major=1' 'svnkit.version.minor=10' 'svnkit.version.micro=11' 'svnkit.version.revision=r1.10.11' 'svnkit.svn.version=1.10.0' > $WORKDIR/classes/svnkit.build.properties",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/svnkit-1.10.11.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/tmatesoft/svnkit/svnkit/1.10.11",
            "*:*:cp $WORKDIR/svnkit-1.10.11.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/tmatesoft/svnkit/svnkit/1.10.11/svnkit-1.10.11.jar",
            "*:*:cp svnkit-1.10.11.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/tmatesoft/svnkit/svnkit/1.10.11/svnkit-1.10.11.pom"
        ]
    }
}