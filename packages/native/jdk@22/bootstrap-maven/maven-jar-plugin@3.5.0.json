{
    "package": "native/jdk@22/bootstrap-maven/maven-jar-plugin@3.5.0",
    "version": "3.5.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "68d00f1121da7ca6c04501363e020977bd1ad5ae",
            "url": "https://github.com/apache/maven-jar-plugin.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/org.eclipse.sisu.inject@1.0.0",
        "*:*:native/maven@3.9-bin",
        "*:*:native/jdk@22/bootstrap-maven/pom/maven-plugins@45",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/maven-plugin-annotations@3.15.2",
        "*:*:native/jdk@22/bootstrap-maven/maven-plugin-tools-generators@3.15.2",
        "*:*:native/jdk@22/bootstrap-maven/file-management@3.2.0",
        "*:*:native/jdk@22/bootstrap-maven/maven-archiver@3.6.5",
        "*:*:native/jdk@22/bootstrap-maven/plexus-archiver@4.10.4",
        "*:*:native/jdk@22/bootstrap-maven/commons-io@2.21.0"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/maven-jar-plugin@3.5.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository",
            "*:*:BOOT_LIB=$NATIVEPREFIX/maven-3.9-bootstrap/lib"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes $WORKDIR/pluginxml/META-INF/maven $WORKDIR/pluginxml/META-INF/plexus",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $(printf '%s:' $BOOT_LIB/*.jar)$REPO/org/apache/maven/plugin-tools/maven-plugin-annotations/3.15.2/maven-plugin-annotations-3.15.2.jar:$REPO/org/apache/maven/shared/file-management/3.2.0/file-management-3.2.0.jar:$REPO/org/apache/maven/maven-archiver/3.6.5/maven-archiver-3.6.5.jar:$REPO/org/codehaus/plexus/plexus-archiver/4.10.4/plexus-archiver-4.10.4.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/commons-io/commons-io/2.21.0/commons-io-2.21.0.jar -processorpath $REPO/org/eclipse/sisu/org.eclipse.sisu.inject/1.0.0/org.eclipse.sisu.inject-1.0.0.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar -processor org.eclipse.sisu.space.SisuIndexAPT6 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/java -cp $PLUGINXML_JAR:$(printf '%s:' $BOOT_LIB/*.jar) org.apache.maven.tools.plugin.generator.GeneratePluginXml org.apache.maven.plugins maven-jar-plugin 3.5.0 jar $WORKDIR/classes $WORKDIR/pluginxml/META-INF/maven $(printf '%s:' $BOOT_LIB/*.jar)$REPO/org/apache/maven/plugin-tools/maven-plugin-annotations/3.15.2/maven-plugin-annotations-3.15.2.jar:$REPO/org/apache/maven/shared/file-management/3.2.0/file-management-3.2.0.jar:$REPO/org/apache/maven/maven-archiver/3.6.5/maven-archiver-3.6.5.jar:$REPO/org/codehaus/plexus/plexus-archiver/4.10.4/plexus-archiver-4.10.4.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/commons-io/commons-io/2.21.0/commons-io-2.21.0.jar",
            "*:*:printf '%s\\n' '<?xml version=\"1.0\" encoding=\"UTF-8\"?>' '<component-set>' '  <components>' '    <component>' '      <role>org.apache.maven.artifact.handler.ArtifactHandler</role>' '      <role-hint>jar</role-hint>' '      <implementation>org.apache.maven.artifact.handler.DefaultArtifactHandler</implementation>' '      <configuration>' '        <type>jar</type>' '        <language>java</language>' '        <addedToClasspath>true</addedToClasspath>' '      </configuration>' '    </component>' '    <component>' '      <role>org.apache.maven.artifact.handler.ArtifactHandler</role>' '      <role-hint>test-jar</role-hint>' '      <implementation>org.apache.maven.artifact.handler.DefaultArtifactHandler</implementation>' '      <configuration>' '        <classifier>tests</classifier>' '        <extension>jar</extension>' '        <type>test-jar</type>' '        <packaging>jar</packaging>' '        <language>java</language>' '        <addedToClasspath>true</addedToClasspath>' '      </configuration>' '    </component>' '    <component>' '      <role>org.apache.maven.lifecycle.mapping.LifecycleMapping</role>' '      <role-hint>jar</role-hint>' '      <implementation>org.apache.maven.lifecycle.mapping.DefaultLifecycleMapping</implementation>' '      <configuration>' '        <lifecycles>' '          <lifecycle>' '            <id>default</id>' '            <phases>' '              <process-resources>org.apache.maven.plugins:maven-resources-plugin:3.3.1:resources</process-resources>' '              <compile>org.apache.maven.plugins:maven-compiler-plugin:3.14.0:compile</compile>' '              <process-test-resources>org.apache.maven.plugins:maven-resources-plugin:3.3.1:testResources</process-test-resources>' '              <test-compile>org.apache.maven.plugins:maven-compiler-plugin:3.14.0:testCompile</test-compile>' '              <test>org.apache.maven.plugins:maven-surefire-plugin:3.5.3:test</test>' '              <package>org.apache.maven.plugins:maven-jar-plugin:3.5.0:jar</package>' '              <install>org.apache.maven.plugins:maven-install-plugin:3.1.4:install</install>' '              <deploy>org.apache.maven.plugins:maven-deploy-plugin:3.1.4:deploy</deploy>' '            </phases>' '          </lifecycle>' '        </lifecycles>' '      </configuration>' '    </component>' '  </components>' '</component-set>' > $WORKDIR/pluginxml/META-INF/plexus/components.xml",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/maven-jar-plugin-3.5.0.jar -C $WORKDIR/classes . -C $WORKDIR/pluginxml .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugins/maven-jar-plugin/3.5.0",
            "*:*:cp $WORKDIR/maven-jar-plugin-3.5.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugins/maven-jar-plugin/3.5.0/maven-jar-plugin-3.5.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugins/maven-jar-plugin/3.5.0/maven-jar-plugin-3.5.0.pom"
        ]
    }
}