{
    "package": "native/jdk@22/bootstrap-maven/plexus-velocity@2.2.0",
    "version": "2.2.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "9f68c3673d219d035d887e9cdd09fa07ee399e81",
            "url": "https://github.com/codehaus-plexus/plexus-velocity.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/maven@3.9-bin",
        "*:*:native/jdk@22/bootstrap-maven/pom/plexus@19",
        "*:*:native/jdk@22/bootstrap-maven/velocity-engine-core@2.4",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/plexus-velocity@2.2.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository",
            "*:*:BOOT_LIB=$NATIVEPREFIX/maven-3.9-bootstrap/lib"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $(printf '%s:' $BOOT_LIB/*.jar)$REPO/org/apache/velocity/velocity-engine-core/2.4/velocity-engine-core-2.4.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-velocity-2.2.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-velocity/2.2.0",
            "*:*:cp $WORKDIR/plexus-velocity-2.2.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-velocity/2.2.0/plexus-velocity-2.2.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-velocity/2.2.0/plexus-velocity-2.2.0.pom"
        ]
    }
}