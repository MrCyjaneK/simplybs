{
    "package": "native/jdk@22/bootstrap-maven/JavaEWAH@1.2.3",
    "version": "1.2.3",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "f52f4091c44f1c3a1aff68522d8deaf5126651bb",
            "url": "https://github.com/lemire/javaewah.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/oss-parent@5"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/JavaEWAH@1.2.3"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/JavaEWAH-1.2.3.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/googlecode/javaewah/JavaEWAH/1.2.3",
            "*:*:cp $WORKDIR/JavaEWAH-1.2.3.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/googlecode/javaewah/JavaEWAH/1.2.3/JavaEWAH-1.2.3.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/googlecode/javaewah/JavaEWAH/1.2.3/JavaEWAH-1.2.3.pom"
        ]
    }
}