{
    "package": "native/jdk@22/bootstrap-maven/jcl-over-slf4j@1.7.36",
    "version": "1.7.36",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "e9ee55cca93c2bf26f14482a9bdf961c750d2a56",
            "url": "https://github.com/qos-ch/slf4j.git"
        },
        {
            "kind": "blob",
            "path": "./jcl-over-slf4j-1.7.36.pom",
            "sha256": "bd96243d7d4218cd7cc7d45c0e30fa13480a1a4f91d356edd7dfe93f1ffb68e6",
            "url": "https://repo1.maven.org/maven2/org/slf4j/jcl-over-slf4j/1.7.36/jcl-over-slf4j-1.7.36.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/slf4j-parent@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/jcl-over-slf4j@1.7.36",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find jcl-over-slf4j/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/jcl-over-slf4j-1.7.36.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/slf4j/jcl-over-slf4j/1.7.36",
            "*:*:cp $WORKDIR/jcl-over-slf4j-1.7.36.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/slf4j/jcl-over-slf4j/1.7.36/jcl-over-slf4j-1.7.36.jar",
            "*:*:cp jcl-over-slf4j-1.7.36.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/slf4j/jcl-over-slf4j/1.7.36/jcl-over-slf4j-1.7.36.pom"
        ]
    }
}