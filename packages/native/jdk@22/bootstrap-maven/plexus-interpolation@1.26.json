{
    "package": "native/jdk@22/bootstrap-maven/plexus-interpolation@1.26",
    "version": "1.26",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "159e6971b0e2db261be1d01deb9149f27f8fb752",
            "url": "https://github.com/codehaus-plexus/plexus-interpolation.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/plexus@5.1"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/plexus-interpolation@1.26"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-interpolation-1.26.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-interpolation/1.26",
            "*:*:cp $WORKDIR/plexus-interpolation-1.26.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-interpolation/1.26/plexus-interpolation-1.26.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-interpolation/1.26/plexus-interpolation-1.26.pom"
        ]
    }
}