{
    "package": "native/jdk@22/bootstrap-maven/plexus-xml@3.0.0",
    "version": "3.0.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "636b0c33524edb97a1a9bf6a24a23c23e6ed3fc5",
            "url": "https://github.com/codehaus-plexus/plexus-xml.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/plexus@13"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/plexus-xml@3.0.0"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-xml-3.0.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-xml/3.0.0",
            "*:*:cp $WORKDIR/plexus-xml-3.0.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-xml/3.0.0/plexus-xml-3.0.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-xml/3.0.0/plexus-xml-3.0.0.pom"
        ]
    }
}