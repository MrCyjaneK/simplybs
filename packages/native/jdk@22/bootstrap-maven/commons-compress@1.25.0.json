{
    "package": "native/jdk@22/bootstrap-maven/commons-compress@1.25.0",
    "version": "1.25.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "38dec7fb4690c023ef0af9661e0e1ae4f254a769",
            "url": "https://github.com/apache/commons-compress.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/asm@9.5",
        "*:*:native/jdk@22/bootstrap-maven/pom/commons-parent@64",
        "*:*:native/jdk@22/bootstrap-maven/xz@1.9",
        "*:*:native/jdk@22/bootstrap-maven/zstd-jni@1.5.6-3",
        "*:*:native/jdk@22/bootstrap-maven/dec@0.1.2"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/commons-compress@1.25.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -encoding ISO-8859-1 -cp $REPO/org/tukaani/xz/1.9/xz-1.9.jar:$REPO/com/github/luben/zstd-jni/1.5.6-3/zstd-jni-1.5.6-3.jar:$REPO/org/brotli/dec/0.1.2/dec-0.1.2.jar:$NATIVEPREFIX/lib/graalvm/asm-9.5/asm.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/commons-compress-1.25.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/commons/commons-compress/1.25.0",
            "*:*:cp $WORKDIR/commons-compress-1.25.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/commons/commons-compress/1.25.0/commons-compress-1.25.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/commons/commons-compress/1.25.0/commons-compress-1.25.0.pom"
        ]
    }
}