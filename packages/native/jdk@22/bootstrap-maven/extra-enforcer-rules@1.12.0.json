{
    "package": "native/jdk@22/bootstrap-maven/extra-enforcer-rules@1.12.0",
    "version": "1.12.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "4684a445dad0ef1c700528b667e95c6391838b6f",
            "url": "https://github.com/mojohaus/extra-enforcer-rules.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/org.eclipse.sisu.inject@1.0.0",
        "*:*:native/maven@3.9-bin",
        "*:*:native/jdk@22/bootstrap-maven/pom/mojo-parent@96",
        "*:*:native/jdk@22/bootstrap-maven/maven-enforcer-plugin@3.6.2",
        "*:*:native/jdk@22/bootstrap-maven/maven-common-artifact-filters@3.4.0",
        "*:*:native/jdk@22/bootstrap-maven/commons-codec@1.21.0",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/extra-enforcer-rules@1.12.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository",
            "*:*:BOOT_LIB=$NATIVEPREFIX/maven-3.9-bootstrap/lib"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $(printf '%s:' $BOOT_LIB/*.jar)$REPO/org/apache/maven/enforcer/enforcer-api/3.6.2/enforcer-api-3.6.2.jar:$REPO/org/apache/maven/shared/maven-common-artifact-filters/3.4.0/maven-common-artifact-filters-3.4.0.jar:$REPO/commons-codec/commons-codec/1.21.0/commons-codec-1.21.0.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar -processorpath $REPO/org/eclipse/sisu/org.eclipse.sisu.inject/1.0.0/org.eclipse.sisu.inject-1.0.0.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar -processor org.eclipse.sisu.space.SisuIndexAPT6 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/extra-enforcer-rules-1.12.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/mojo/extra-enforcer-rules/1.12.0",
            "*:*:cp $WORKDIR/extra-enforcer-rules-1.12.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/mojo/extra-enforcer-rules/1.12.0/extra-enforcer-rules-1.12.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/mojo/extra-enforcer-rules/1.12.0/extra-enforcer-rules-1.12.0.pom"
        ]
    }
}