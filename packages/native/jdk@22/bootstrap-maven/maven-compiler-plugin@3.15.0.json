{
    "package": "native/jdk@22/bootstrap-maven/maven-compiler-plugin@3.15.0",
    "version": "3.15.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "9290cb337f199673e02b6beac0fba37d8066d72c",
            "url": "https://github.com/apache/maven-compiler-plugin.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/maven@3.9-bin",
        "*:*:native/jdk@22/bootstrap-maven/pom/maven-plugins@47",
        "*:*:native/jdk@22/bootstrap-maven/asm@9.9.1",
        "*:*:native/jdk@22/bootstrap-maven/maven-shared-utils@3.4.2",
        "*:*:native/jdk@22/bootstrap-maven/maven-shared-incremental@1.1",
        "*:*:native/jdk@22/bootstrap-maven/plexus-java@1.5.2",
        "*:*:native/jdk@22/bootstrap-maven/plexus-compiler@2.16.2",
        "*:*:native/jdk@22/bootstrap-maven/plexus-utils@4.0.2",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/maven-plugin-annotations@3.15.2",
        "*:*:native/jdk@22/bootstrap-maven/maven-plugin-tools-generators@3.15.2"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/maven-compiler-plugin@3.15.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository",
            "*:*:BOOT_LIB=$NATIVEPREFIX/maven-3.9-bootstrap/lib"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes $WORKDIR/pluginxml/META-INF/maven",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $(printf '%s:' $BOOT_LIB/*.jar)$REPO/org/apache/maven/plugin-tools/maven-plugin-annotations/3.15.2/maven-plugin-annotations-3.15.2.jar:$REPO/org/ow2/asm/asm/9.9.1/asm-9.9.1.jar:$REPO/org/apache/maven/shared/maven-shared-utils/3.4.2/maven-shared-utils-3.4.2.jar:$REPO/org/apache/maven/shared/maven-shared-incremental/1.1/maven-shared-incremental-1.1.jar:$REPO/org/codehaus/plexus/plexus-java/1.5.2/plexus-java-1.5.2.jar:$REPO/org/codehaus/plexus/plexus-compiler-api/2.16.2/plexus-compiler-api-2.16.2.jar:$REPO/org/codehaus/plexus/plexus-compiler-manager/2.16.2/plexus-compiler-manager-2.16.2.jar:$REPO/org/codehaus/plexus/plexus-utils/4.0.2/plexus-utils-4.0.2.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/java -cp $PLUGINXML_JAR:$(printf '%s:' $BOOT_LIB/*.jar) org.apache.maven.tools.plugin.generator.GeneratePluginXml org.apache.maven.plugins maven-compiler-plugin 3.15.0 compiler $WORKDIR/classes $WORKDIR/pluginxml/META-INF/maven $(printf '%s:' $BOOT_LIB/*.jar)$REPO/org/apache/maven/plugin-tools/maven-plugin-annotations/3.15.2/maven-plugin-annotations-3.15.2.jar:$REPO/org/ow2/asm/asm/9.9.1/asm-9.9.1.jar:$REPO/org/apache/maven/shared/maven-shared-utils/3.4.2/maven-shared-utils-3.4.2.jar:$REPO/org/apache/maven/shared/maven-shared-incremental/1.1/maven-shared-incremental-1.1.jar:$REPO/org/codehaus/plexus/plexus-java/1.5.2/plexus-java-1.5.2.jar:$REPO/org/codehaus/plexus/plexus-compiler-api/2.16.2/plexus-compiler-api-2.16.2.jar:$REPO/org/codehaus/plexus/plexus-compiler-manager/2.16.2/plexus-compiler-manager-2.16.2.jar:$REPO/org/codehaus/plexus/plexus-utils/4.0.2/plexus-utils-4.0.2.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/maven-compiler-plugin-3.15.0.jar -C $WORKDIR/classes . -C $WORKDIR/pluginxml .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugins/maven-compiler-plugin/3.15.0",
            "*:*:cp $WORKDIR/maven-compiler-plugin-3.15.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugins/maven-compiler-plugin/3.15.0/maven-compiler-plugin-3.15.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugins/maven-compiler-plugin/3.15.0/maven-compiler-plugin-3.15.0.pom"
        ]
    }
}