{
    "package": "native/jdk@22/bootstrap-maven/jsr305@3.0.2",
    "version": "3.0.2",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "d7734b13c61492982784560ed5b4f4bd6cf9bb2c",
            "url": "https://github.com/amaembo/jsr-305.git"
        },
        {
            "kind": "blob",
            "path": "./jsr305-3.0.2.pom",
            "sha256": "19889dbdf1b254b2601a5ee645b8147a974644882297684c798afe5d63d78dfe",
            "url": "https://repo1.maven.org/maven2/com/google/code/findbugs/jsr305/3.0.2/jsr305-3.0.2.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/jsr305@3.0.2"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find ri/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/jsr305-3.0.2.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/code/findbugs/jsr305/3.0.2",
            "*:*:cp $WORKDIR/jsr305-3.0.2.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/code/findbugs/jsr305/3.0.2/jsr305-3.0.2.jar",
            "*:*:cp jsr305-3.0.2.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/code/findbugs/jsr305/3.0.2/jsr305-3.0.2.pom"
        ]
    }
}