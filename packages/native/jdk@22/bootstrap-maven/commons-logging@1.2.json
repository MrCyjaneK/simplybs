{
    "package": "native/jdk@22/bootstrap-maven/commons-logging@1.2",
    "version": "1.2",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "bd26f32b9a24e1c5176da719c95203bba09e401c",
            "url": "https://github.com/apache/commons-logging.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/commons-parent@34"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/commons-logging@1.2"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' ! -name 'module-info.java' ! -name 'Log4JLogger.java' ! -name 'LogKitLogger.java' ! -name 'AvalonLogger.java' ! -name 'Jdk13LumberjackLogger.java' ! -name 'ServletContextCleaner.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/commons-logging-1.2.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-logging/commons-logging/1.2",
            "*:*:cp $WORKDIR/commons-logging-1.2.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-logging/commons-logging/1.2/commons-logging-1.2.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-logging/commons-logging/1.2/commons-logging-1.2.pom"
        ]
    }
}