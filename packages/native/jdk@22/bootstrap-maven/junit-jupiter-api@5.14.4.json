{
    "package": "native/jdk@22/bootstrap-maven/junit-jupiter-api@5.14.4",
    "version": "5.14.4",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "096fd696c1b22780e025a02417d42903e0022862",
            "url": "https://github.com/junit-team/junit-framework.git"
        },
        {
            "kind": "blob",
            "path": "./junit-platform-commons-1.14.4.pom",
            "sha256": "d77be81708cf9836db7a09908e6d9e4d94c527e090bd594cc4af06711b9d853d",
            "url": "https://repo1.maven.org/maven2/org/junit/platform/junit-platform-commons/1.14.4/junit-platform-commons-1.14.4.pom"
        },
        {
            "kind": "blob",
            "path": "./junit-jupiter-api-5.14.4.pom",
            "sha256": "4c175189fd774dcd90cb23cfcab2ce9dbf2f5d0a16d7ef3702e7cfcd6411a762",
            "url": "https://repo1.maven.org/maven2/org/junit/jupiter/junit-jupiter-api/5.14.4/junit-jupiter-api-5.14.4.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/junit-bom@5.14.4",
        "*:*:native/jdk@22/bootstrap-maven/apiguardian-api@1.1.2",
        "*:*:native/jdk@22/bootstrap-maven/opentest4j@1.3.0"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/junit-jupiter-api@5.14.4",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/commons $WORKDIR/api",
            "*:*:find junit-platform-commons/src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/commons.sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/org/apiguardian/apiguardian-api/1.1.2/apiguardian-api-1.1.2.jar -d $WORKDIR/commons @$WORKDIR/commons.sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/junit-platform-commons-1.14.4.jar -C $WORKDIR/commons .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/junit/platform/junit-platform-commons/1.14.4",
            "*:*:cp $WORKDIR/junit-platform-commons-1.14.4.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/junit/platform/junit-platform-commons/1.14.4/junit-platform-commons-1.14.4.jar",
            "*:*:cp junit-platform-commons-1.14.4.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/junit/platform/junit-platform-commons/1.14.4/junit-platform-commons-1.14.4.pom",
            "*:*:cp $PATCH_DIR/maven/JRE-5.14.4.java junit-jupiter-api/src/main/java/org/junit/jupiter/api/condition/JRE.java",
            "*:*:find junit-jupiter-api/src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/api.sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $WORKDIR/junit-platform-commons-1.14.4.jar:$REPO/org/apiguardian/apiguardian-api/1.1.2/apiguardian-api-1.1.2.jar:$REPO/org/opentest4j/opentest4j/1.3.0/opentest4j-1.3.0.jar -d $WORKDIR/api @$WORKDIR/api.sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/junit-jupiter-api-5.14.4.jar -C $WORKDIR/api .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/junit/jupiter/junit-jupiter-api/5.14.4",
            "*:*:cp $WORKDIR/junit-jupiter-api-5.14.4.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/junit/jupiter/junit-jupiter-api/5.14.4/junit-jupiter-api-5.14.4.jar",
            "*:*:cp junit-jupiter-api-5.14.4.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/junit/jupiter/junit-jupiter-api/5.14.4/junit-jupiter-api-5.14.4.pom"
        ]
    }
}