{
    "package": "native/jdk@22/bootstrap-maven/commons-lang@2.4",
    "version": "2.4",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "aa9727e15966bac899aa18733ef85c4aded19f0c",
            "url": "https://github.com/apache/commons-lang.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/sed",
        "*:*:native/jdk@22/bootstrap-maven/pom/commons-parent@9"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/commons-lang@2.4"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:sed -i 's/compareTo(rhs)/compareTo((java.math.BigDecimal)rhs)/' src/java/org/apache/commons/lang/builder/EqualsBuilder.java",
            "*:*:find src/java -name '*.java' ! -path '*/lang/enum/*' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -encoding ISO-8859-1 --release 8 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/commons-lang-2.4.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-lang/commons-lang/2.4",
            "*:*:cp $WORKDIR/commons-lang-2.4.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-lang/commons-lang/2.4/commons-lang-2.4.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-lang/commons-lang/2.4/commons-lang-2.4.pom"
        ]
    }
}