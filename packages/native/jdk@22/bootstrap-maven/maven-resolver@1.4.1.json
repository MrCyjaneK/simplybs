{
    "package": "native/jdk@22/bootstrap-maven/maven-resolver@1.4.1",
    "version": "1.4.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "9417310df326cd4a58b0ef534e6c0e29f7b4cb47",
            "url": "https://github.com/apache/maven-resolver.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/maven-parent@33"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/maven-resolver@1.4.1"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/resolver/maven-resolver/1.4.1",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/resolver/maven-resolver/1.4.1/maven-resolver-1.4.1.pom",
            "*:*:find maven-resolver-api/src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/api.sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/api @$WORKDIR/api.sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/maven-resolver-api-1.4.1.jar -C $WORKDIR/api .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/resolver/maven-resolver-api/1.4.1",
            "*:*:cp $WORKDIR/maven-resolver-api-1.4.1.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/resolver/maven-resolver-api/1.4.1/maven-resolver-api-1.4.1.jar",
            "*:*:cp maven-resolver-api/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/resolver/maven-resolver-api/1.4.1/maven-resolver-api-1.4.1.pom",
            "*:*:find maven-resolver-util/src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/util.sources",
            "*:*:$JAVA_HOME/bin/javac -cp $WORKDIR/maven-resolver-api-1.4.1.jar -d $WORKDIR/util @$WORKDIR/util.sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/maven-resolver-util-1.4.1.jar -C $WORKDIR/util .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/resolver/maven-resolver-util/1.4.1",
            "*:*:cp $WORKDIR/maven-resolver-util-1.4.1.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/resolver/maven-resolver-util/1.4.1/maven-resolver-util-1.4.1.jar",
            "*:*:cp maven-resolver-util/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/resolver/maven-resolver-util/1.4.1/maven-resolver-util-1.4.1.pom"
        ]
    }
}