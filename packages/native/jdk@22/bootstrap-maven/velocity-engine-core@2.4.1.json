{
    "package": "native/jdk@22/bootstrap-maven/velocity-engine-core@2.4.1",
    "version": "2.4.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "c541025518393bc65c394071d97bdb23f26f483b",
            "url": "https://github.com/apache/velocity-engine.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/sed",
        "*:*:native/jdk@22/bootstrap-maven/javacc",
        "*:*:native/jdk@22/bootstrap-maven/commons-lang3@3.17.0",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/velocity-engine-core@2.4.1",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/parser $WORKDIR/gen/org/apache/velocity/runtime $WORKDIR/classes",
            "*:*:sed -e 's/${parser.debug}/false/g' -e 's/${parser.package}/org.apache.velocity.runtime.parser/g' -e 's/${parser.basename}/Standard/g' -e 's/${parser.char.asterisk}/*/g' -e 's/${parser.char.at}/@/g' -e 's/${parser.char.dollar}/$/g' -e 's/${parser.char.hash}/#/g' velocity-engine-core/src/main/parser/Parser.jjt > $WORKDIR/parser/Parser.jjt",
            "*:*:sed -e 's/STATIC=false;/STATIC=false;\\n TOKEN_MANAGER_USES_PARSER=true;/' $WORKDIR/parser/Parser.jjt > $WORKDIR/parser/Parser.jjt.tmp",
            "*:*:mv $WORKDIR/parser/Parser.jjt.tmp $WORKDIR/parser/Parser.jjt",
            "*:*:$JAVA_HOME/bin/java -cp $NATIVEPREFIX/share/java/javacc.jar jjtree -OUTPUT_DIRECTORY=$WORKDIR/parser -NODE_PACKAGE=org.apache.velocity.runtime.parser.node $WORKDIR/parser/Parser.jjt",
            "*:*:$JAVA_HOME/bin/java -cp $NATIVEPREFIX/share/java/javacc.jar javacc -OUTPUT_DIRECTORY=$WORKDIR/parser $WORKDIR/parser/Parser.jj",
            "*:*:printf '%s\\n' 'package org.apache.velocity.runtime;' '' 'public class VelocityEngineVersion' '{' '    public static final String VERSION = \"2.4.1\";' '}' > $WORKDIR/gen/org/apache/velocity/runtime/VelocityEngineVersion.java",
            "*:*:find velocity-engine-core/src/main/java $WORKDIR/gen -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:find $WORKDIR/parser -name '*.java' ! -name 'AST*' ! -name 'Node.java' ! -name 'SimpleNode.java' ! -name 'ParseException.java' ! -name 'CharStream.java' >>$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $REPO/org/apache/commons/commons-lang3/3.17.0/commons-lang3-3.17.0.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:cp -R velocity-engine-core/src/main/resources/. $WORKDIR/classes/",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/velocity-engine-core-2.4.1.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/velocity/velocity-engine-core/2.4.1",
            "*:*:cp $WORKDIR/velocity-engine-core-2.4.1.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/velocity/velocity-engine-core/2.4.1/velocity-engine-core-2.4.1.jar",
            "*:*:cp velocity-engine-core/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/velocity/velocity-engine-core/2.4.1/velocity-engine-core-2.4.1.pom"
        ]
    }
}