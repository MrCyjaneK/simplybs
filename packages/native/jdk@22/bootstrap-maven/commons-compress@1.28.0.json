{
    "package": "native/jdk@22/bootstrap-maven/commons-compress@1.28.0",
    "version": "1.28.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "852d9c23b94127feafc1649d9c7f13d4df338845",
            "url": "https://github.com/apache/commons-compress.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/asm@9.5",
        "*:*:native/jdk@22/bootstrap-maven/pom/commons-parent@85",
        "*:*:native/jdk@22/bootstrap-maven/commons-codec@1.19.0",
        "*:*:native/jdk@22/bootstrap-maven/commons-io@2.20.0",
        "*:*:native/jdk@22/bootstrap-maven/commons-lang3@3.18.0",
        "*:*:native/jdk@22/bootstrap-maven/xz@1.10",
        "*:*:native/jdk@22/bootstrap-maven/zstd-jni@1.5.7-6",
        "*:*:native/jdk@22/bootstrap-maven/dec@0.1.2"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/commons-compress@1.28.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -encoding ISO-8859-1 -cp $REPO/commons-codec/commons-codec/1.19.0/commons-codec-1.19.0.jar:$REPO/commons-io/commons-io/2.20.0/commons-io-2.20.0.jar:$REPO/org/apache/commons/commons-lang3/3.18.0/commons-lang3-3.18.0.jar:$REPO/org/tukaani/xz/1.10/xz-1.10.jar:$REPO/com/github/luben/zstd-jni/1.5.7-6/zstd-jni-1.5.7-6.jar:$REPO/org/brotli/dec/0.1.2/dec-0.1.2.jar:$NATIVEPREFIX/lib/graalvm/asm-9.5/asm.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/commons-compress-1.28.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/commons/commons-compress/1.28.0",
            "*:*:cp $WORKDIR/commons-compress-1.28.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/commons/commons-compress/1.28.0/commons-compress-1.28.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/commons/commons-compress/1.28.0/commons-compress-1.28.0.pom"
        ]
    }
}