{
    "package": "native/jdk@22/bootstrap-maven/plexus-utils@1.5.5",
    "version": "1.5.5",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "d631aa1ef1f0091942971796b51f1c2c3887f95f",
            "url": "https://github.com/codehaus-plexus/plexus-utils.git"
        },
        {
            "kind": "blob",
            "path": "./plexus-utils-1.5.5.pom",
            "sha256": "f860675cad10e561bfa175d5717e2d8617d40c62321086ca4a85c006a0fa30d1",
            "url": "https://repo1.maven.org/maven2/org/codehaus/plexus/plexus-utils/1.5.5/plexus-utils-1.5.5.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/plexus@1.0.11"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/plexus-utils@1.5.5"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' ! -name 'module-info.java' ! -path '*/interpolation/*' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -encoding ISO-8859-1 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-utils-1.5.5.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/1.5.5",
            "*:*:cp $WORKDIR/plexus-utils-1.5.5.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/1.5.5/plexus-utils-1.5.5.jar",
            "*:*:cp plexus-utils-1.5.5.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/1.5.5/plexus-utils-1.5.5.pom"
        ]
    }
}