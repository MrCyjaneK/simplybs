{
    "package": "native/jdk@22/bootstrap-maven/plexus-component-annotations@1.5.5",
    "version": "1.5.5",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "b2212a6adcab0e601475788fbe102da06a3aea9a",
            "url": "https://github.com/codehaus-plexus/plexus-containers.git"
        },
        {
            "kind": "blob",
            "path": "./plexus-component-annotations-1.5.5.pom",
            "sha256": "815f3ec316b8c5fa701385fdf4009bfb51e07d780e8f6a6e2afe720c52d7e292",
            "url": "https://repo1.maven.org/maven2/org/codehaus/plexus/plexus-component-annotations/1.5.5/plexus-component-annotations-1.5.5.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/plexus-containers@1.5.5"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/plexus-component-annotations@1.5.5"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find plexus-component-annotations/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-component-annotations-1.5.5.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-component-annotations/1.5.5",
            "*:*:cp $WORKDIR/plexus-component-annotations-1.5.5.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-component-annotations/1.5.5/plexus-component-annotations-1.5.5.jar",
            "*:*:cp plexus-component-annotations-1.5.5.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-component-annotations/1.5.5/plexus-component-annotations-1.5.5.pom"
        ]
    }
}