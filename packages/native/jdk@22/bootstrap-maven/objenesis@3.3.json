{
    "package": "native/jdk@22/bootstrap-maven/objenesis@3.3",
    "version": "3.3",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "15c04843c5aabbe31052aa5ac33c7c2c5e6dc8c6",
            "url": "https://github.com/easymock/objenesis.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/objenesis-parent@3.3"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/objenesis@3.3"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find main/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -XDignore.symbol.file -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/objenesis-3.3.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/objenesis/objenesis/3.3",
            "*:*:cp $WORKDIR/objenesis-3.3.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/objenesis/objenesis/3.3/objenesis-3.3.jar",
            "*:*:cp main/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/objenesis/objenesis/3.3/objenesis-3.3.pom"
        ]
    }
}