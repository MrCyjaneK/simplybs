{
    "package": "native/jdk@22/bootstrap-maven/asm@9.8",
    "version": "9.8",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "c55dc7bdd8e47a22d22ce74f9c66a1ea08e29050",
            "url": "https://gitlab.ow2.org/asm/asm.git"
        },
        {
            "kind": "blob",
            "path": "./asm-9.8.pom",
            "sha256": "c1367c3bb383d7619e7f797e38df7513885f2eef04ae7b5908f68222657b5baa",
            "url": "https://repo1.maven.org/maven2/org/ow2/asm/asm/9.8/asm-9.8.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/ow2@1.5.1"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/asm@9.8"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find asm/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/asm-9.8.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/ow2/asm/asm/9.8",
            "*:*:cp $WORKDIR/asm-9.8.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/ow2/asm/asm/9.8/asm-9.8.jar",
            "*:*:cp asm-9.8.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/ow2/asm/asm/9.8/asm-9.8.pom"
        ]
    }
}