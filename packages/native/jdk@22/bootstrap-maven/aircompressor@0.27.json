{
    "package": "native/jdk@22/bootstrap-maven/aircompressor@0.27",
    "version": "0.27",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "e139a31be059855a5a70f6994a4ecaa0adbbea7a",
            "url": "https://github.com/airlift/aircompressor.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/aircompressor@0.27"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' ! -path '*/hadoop/*' ! -name '*Codec.java' ! -name '*Hadoop*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/aircompressor-0.27.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/io/airlift/aircompressor/0.27",
            "*:*:cp $WORKDIR/aircompressor-0.27.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/io/airlift/aircompressor/0.27/aircompressor-0.27.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/io/airlift/aircompressor/0.27/aircompressor-0.27.pom"
        ]
    }
}