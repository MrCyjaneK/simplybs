{
    "package": "native/jdk@22/bootstrap-maven/plexus-utils@1.4.5",
    "version": "1.4.5",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "57c0bcc2ea35e58ec7dc0476504180c5ad0a4593",
            "url": "https://github.com/codehaus-plexus/plexus-utils.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/plexus@1.0.11"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/plexus-utils@1.4.5"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -encoding ISO-8859-1 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-utils-1.4.5.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/1.4.5",
            "*:*:cp $WORKDIR/plexus-utils-1.4.5.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/1.4.5/plexus-utils-1.4.5.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/1.4.5/plexus-utils-1.4.5.pom"
        ]
    }
}