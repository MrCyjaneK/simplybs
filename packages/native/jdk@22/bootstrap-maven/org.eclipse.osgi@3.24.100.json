    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/sed"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=_compile/org.eclipse.osgi"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes $WORKDIR/ann",
            "*:*:find osgi-ann -name '*.java' >$WORKDIR/ann.sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -d $WORKDIR/ann @$WORKDIR/ann.sources",
            "*:*:find bundles/org.eclipse.osgi/osgi/src bundles/org.eclipse.osgi/felix/src bundles/org.eclipse.osgi/supplement/src bundles/org.eclipse.osgi/container/src -name '*.java' >$WORKDIR/sources",
            "*:*:sed -i -e '/import org.eclipse.pde.api.tools.annotations.NoImplement;/d' -e '/@NoImplement/d' bundles/org.eclipse.osgi/supplement/src/org/eclipse/osgi/report/resolution/ResolutionReport.java",
            "*:*:$JAVA_HOME/bin/javac --release 17 -nowarn -cp $WORKDIR/ann:bundles/org.eclipse.osgi/osgi/j9stubs.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:cp -R bundles/org.eclipse.osgi/META-INF $WORKDIR/classes/",
            "*:*:cp bundles/org.eclipse.osgi/systembundle.properties bundles/org.eclipse.osgi/plugin.xml bundles/org.eclipse.osgi/profile.list $WORKDIR/classes/",
            "*:*:cp bundles/org.eclipse.osgi/*.profile $WORKDIR/classes/",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/org.eclipse.osgi.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/platform/org.eclipse.osgi/3.24.100",
            "*:*:cp $WORKDIR/org.eclipse.osgi.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/platform/org.eclipse.osgi/3.24.100/org.eclipse.osgi-3.24.100.jar",
            "*:*:cp org.eclipse.osgi-3.24.100.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/platform/org.eclipse.osgi/3.24.100/org.eclipse.osgi-3.24.100.pom",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/platform/org.eclipse.osgi/3.18.300",
            "*:*:cp $WORKDIR/org.eclipse.osgi.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/platform/org.eclipse.osgi/3.18.300/org.eclipse.osgi-3.18.300.jar",
            "*:*:cp org.eclipse.osgi-3.18.300.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/platform/org.eclipse.osgi/3.18.300/org.eclipse.osgi-3.18.300.pom"
        ]
    }
