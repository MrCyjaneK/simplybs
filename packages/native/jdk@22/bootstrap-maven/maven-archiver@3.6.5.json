{
    "package": "native/jdk@22/bootstrap-maven/maven-archiver@3.6.5",
    "version": "3.6.5",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "6033a1508e724c76e54c5c1377e3acd22b644dbe",
            "url": "https://github.com/apache/maven-archiver.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/maven@3.9-bin",
        "*:*:native/jdk@22/bootstrap-maven/pom/maven-shared-components@45",
        "*:*:native/jdk@22/bootstrap-maven/plexus-interpolation@1.28",
        "*:*:native/jdk@22/bootstrap-maven/plexus-archiver@4.10.4",
        "*:*:native/jdk@22/bootstrap-maven/plexus-xml@3.0.2"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/maven-archiver@3.6.5",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository",
            "*:*:BOOT_LIB=$NATIVEPREFIX/maven-3.9-bootstrap/lib"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $(printf '%s:' $BOOT_LIB/*.jar)$REPO/org/codehaus/plexus/plexus-interpolation/1.28/plexus-interpolation-1.28.jar:$REPO/org/codehaus/plexus/plexus-archiver/4.10.4/plexus-archiver-4.10.4.jar:$REPO/org/codehaus/plexus/plexus-xml/3.0.2/plexus-xml-3.0.2.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/maven-archiver-3.6.5.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/maven-archiver/3.6.5",
            "*:*:cp $WORKDIR/maven-archiver-3.6.5.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/maven-archiver/3.6.5/maven-archiver-3.6.5.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/maven-archiver/3.6.5/maven-archiver-3.6.5.pom"
        ]
    }
}