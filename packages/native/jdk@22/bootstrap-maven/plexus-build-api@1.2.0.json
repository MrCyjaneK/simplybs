{
    "package": "native/jdk@22/bootstrap-maven/plexus-build-api@1.2.0",
    "version": "1.2.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "903ed6c3e9dc767da4f9ac6cf5a22f0324400bbf",
            "url": "https://github.com/codehaus-plexus/plexus-build-api.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/org.eclipse.sisu.inject@1.0.0",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/plexus-utils@4.0.2",
        "*:*:native/jdk@22/bootstrap-maven/plexus-container-default@2.1.0",
        "*:*:native/jdk@22/bootstrap-maven/plexus-build-api@0.0.7"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/plexus-build-api@1.2.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes/org/codehaus/plexus/build",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/org/codehaus/plexus/plexus-utils/4.0.2/plexus-utils-4.0.2.jar:$REPO/org/codehaus/plexus/plexus-container-default/2.1.0/plexus-container-default-2.1.0.jar:$REPO/org/sonatype/plexus/plexus-build-api/0.0.7/plexus-build-api-0.0.7.jar -processorpath $REPO/org/eclipse/sisu/org.eclipse.sisu.inject/1.0.0/org.eclipse.sisu.inject-1.0.0.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar -processor org.eclipse.sisu.space.SisuIndexAPT6 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:cp src/main/resources/org/codehaus/plexus/build/version.properties $WORKDIR/classes/org/codehaus/plexus/build/version.properties",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-build-api-1.2.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-build-api/1.2.0",
            "*:*:cp $WORKDIR/plexus-build-api-1.2.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-build-api/1.2.0/plexus-build-api-1.2.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-build-api/1.2.0/plexus-build-api-1.2.0.pom"
        ]
    }
}