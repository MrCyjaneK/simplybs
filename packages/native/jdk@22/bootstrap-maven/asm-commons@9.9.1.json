{
    "package": "native/jdk@22/bootstrap-maven/asm-commons@9.9.1",
    "version": "9.9.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "4e6de6cb3dcddb00a2bbf7bbb9ee40f0c15281c5",
            "url": "https://gitlab.ow2.org/asm/asm.git"
        },
        {
            "kind": "blob",
            "path": "./asm-commons-9.9.1.pom",
            "sha256": "def70fa7d3a4bb71660bc661523329579a4bc31ccc96c42d3a5c3b9f76a6b649",
            "url": "https://repo1.maven.org/maven2/org/ow2/asm/asm-commons/9.9.1/asm-commons-9.9.1.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/ow2@1.5.1",
        "*:*:native/jdk@22/bootstrap-maven/asm@9.9.1",
        "*:*:native/jdk@22/bootstrap-maven/asm-tree@9.9.1"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/asm-commons@9.9.1",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find asm-commons/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $REPO/org/ow2/asm/asm/9.9.1/asm-9.9.1.jar:$REPO/org/ow2/asm/asm-tree/9.9.1/asm-tree-9.9.1.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/asm-commons-9.9.1.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/ow2/asm/asm-commons/9.9.1",
            "*:*:cp $WORKDIR/asm-commons-9.9.1.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/ow2/asm/asm-commons/9.9.1/asm-commons-9.9.1.jar",
            "*:*:cp asm-commons-9.9.1.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/ow2/asm/asm-commons/9.9.1/asm-commons-9.9.1.pom"
        ]
    }
}