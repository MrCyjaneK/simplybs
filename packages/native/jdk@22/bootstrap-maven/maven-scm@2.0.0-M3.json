            "path": "./maven-scm-provider-svn-commons-2.0.0-M3.pom",
            "sha256": "63c70254432e2bd887296dba089daea6c9473370600e9c7a97d595ef606491e9",
            "url": "https://repo1.maven.org/maven2/org/apache/maven/scm/maven-scm-provider-svn-commons/2.0.0-M3/maven-scm-provider-svn-commons-2.0.0-M3.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/maven-parent@36",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/plexus-utils@3.5.0",
        "*:*:native/jdk@22/bootstrap-maven/plexus-utils@4.0.2",
        "*:*:native/jdk@22/bootstrap-maven/plexus-xml@3.0.1",
        "*:*:native/jdk@22/bootstrap-maven/plexus-build-api@1.2.0",
        "*:*:native/jdk@22/bootstrap-maven/modello@2.6.0"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/maven-scm@2.0.0-M3",
            "*:*:MODELLO_MODEL_VERSION=1.1.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository",
            "*:*:MODELLO_CP=$NATIVEPREFIX/share/maven/repository/javax/inject/javax.inject/1/javax.inject-1.jar:$NATIVEPREFIX/share/maven/repository/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/4.0.2/plexus-utils-4.0.2.jar:$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-xml/3.0.1/plexus-xml-3.0.1.jar:$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-build-api/1.2.0/plexus-build-api-1.2.0.jar:$NATIVEPREFIX/share/maven/repository/org/codehaus/modello/modello-core/2.6.0/modello-core-2.6.0.jar:$NATIVEPREFIX/share/maven/repository/org/codehaus/modello/modello-plugin-java/2.6.0/modello-plugin-java-2.6.0.jar:$NATIVEPREFIX/share/maven/repository/org/codehaus/modello/modello-plugin-xml/2.6.0/modello-plugin-xml-2.6.0.jar:$NATIVEPREFIX/share/maven/repository/org/codehaus/modello/modello-plugin-xpp3/2.6.0/modello-plugin-xpp3-2.6.0.jar"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/api $WORKDIR/svnc $WORKDIR/svnc-gen",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/scm/maven-scm/2.0.0-M3",
            "*:*:cp maven-scm-2.0.0-M3.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/scm/maven-scm/2.0.0-M3/maven-scm-2.0.0-M3.pom",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/scm/maven-scm-providers/2.0.0-M3",
            "*:*:cp maven-scm-providers-2.0.0-M3.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/scm/maven-scm-providers/2.0.0-M3/maven-scm-providers-2.0.0-M3.pom",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/scm/maven-scm-providers-svn/2.0.0-M3",
            "*:*:cp maven-scm-providers-svn-2.0.0-M3.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/scm/maven-scm-providers-svn/2.0.0-M3/maven-scm-providers-svn-2.0.0-M3.pom",
            "*:*:$JAVA_HOME/bin/javac -cp $MODELLO_CP -d $WORKDIR $PATCH_DIR/maven/RunModello.java",
            "*:*:find maven-scm-api/src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/api.sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/org/codehaus/plexus/plexus-utils/3.5.0/plexus-utils-3.5.0.jar -d $WORKDIR/api @$WORKDIR/api.sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/maven-scm-api-2.0.0-M3.jar -C $WORKDIR/api .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/scm/maven-scm-api/2.0.0-M3",
            "*:*:cp $WORKDIR/maven-scm-api-2.0.0-M3.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/scm/maven-scm-api/2.0.0-M3/maven-scm-api-2.0.0-M3.jar",
            "*:*:cp maven-scm-api-2.0.0-M3.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/scm/maven-scm-api/2.0.0-M3/maven-scm-api-2.0.0-M3.pom",
            "*:*:$JAVA_HOME/bin/java -cp $WORKDIR:$MODELLO_CP RunModello maven-scm-providers/maven-scm-providers-svn/maven-scm-provider-svn-commons/src/main/mdo/svn-settings.mdo 1.1.0 $WORKDIR/svnc-gen java xpp3-reader xpp3-writer",
            "*:*:find maven-scm-providers/maven-scm-providers-svn/maven-scm-provider-svn-commons/src/main/java $WORKDIR/svnc-gen -name '*.java' >$WORKDIR/svnc.sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $WORKDIR/maven-scm-api-2.0.0-M3.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/org/codehaus/plexus/plexus-utils/3.5.0/plexus-utils-3.5.0.jar:$REPO/org/codehaus/plexus/plexus-xml/3.0.1/plexus-xml-3.0.1.jar -d $WORKDIR/svnc @$WORKDIR/svnc.sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/maven-scm-provider-svn-commons-2.0.0-M3.jar -C $WORKDIR/svnc .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/scm/maven-scm-provider-svn-commons/2.0.0-M3",
            "*:*:cp $WORKDIR/maven-scm-provider-svn-commons-2.0.0-M3.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/scm/maven-scm-provider-svn-commons/2.0.0-M3/maven-scm-provider-svn-commons-2.0.0-M3.jar",
            "*:*:cp maven-scm-provider-svn-commons-2.0.0-M3.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/scm/maven-scm-provider-svn-commons/2.0.0-M3/maven-scm-provider-svn-commons-2.0.0-M3.pom"
        ]
    }
}