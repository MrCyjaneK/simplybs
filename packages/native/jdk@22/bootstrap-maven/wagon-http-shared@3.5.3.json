{
    "package": "native/jdk@22/bootstrap-maven/wagon-http-shared@3.5.3",
    "version": "3.5.3",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "20b847446bb60f49af0428d592eadee774b5bff2",
            "url": "https://github.com/apache/maven-wagon.git"
        },
        {
            "kind": "blob",
            "path": "./wagon-http-shared-3.5.3.pom",
            "sha256": "6014b1e64abf455c6834a0918248e15638050f835da12051d33cda7e946d88f8",
            "url": "https://repo1.maven.org/maven2/org/apache/maven/wagon/wagon-http-shared/3.5.3/wagon-http-shared-3.5.3.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/wagon-providers@3.5.3",
        "*:*:native/jdk@22/bootstrap-maven/wagon-provider-api@3.5.3",
        "*:*:native/jdk@22/bootstrap-maven/httpclient@4.5.14",
        "*:*:native/jdk@22/bootstrap-maven/httpcore@4.4.16",
        "*:*:native/jdk@22/bootstrap-maven/plexus-utils@3.3.1",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-simple@1.7.36"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/wagon-http-shared@3.5.3",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find wagon-providers/wagon-http-shared/src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/org/apache/maven/wagon/wagon-provider-api/3.5.3/wagon-provider-api-3.5.3.jar:$REPO/org/apache/httpcomponents/httpclient/4.5.14/httpclient-4.5.14.jar:$REPO/org/apache/httpcomponents/httpcore/4.4.16/httpcore-4.4.16.jar:$REPO/org/codehaus/plexus/plexus-utils/3.3.1/plexus-utils-3.3.1.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/wagon-http-shared-3.5.3.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/wagon/wagon-http-shared/3.5.3",
            "*:*:cp $WORKDIR/wagon-http-shared-3.5.3.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/wagon/wagon-http-shared/3.5.3/wagon-http-shared-3.5.3.jar",
            "*:*:cp wagon-http-shared-3.5.3.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/wagon/wagon-http-shared/3.5.3/wagon-http-shared-3.5.3.pom"
        ]
    }
}