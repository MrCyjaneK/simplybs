{
    "package": "native/jdk@22/bootstrap-maven/j2objc-annotations@1.3",
    "version": "1.3",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "1c1a8b7f1f816e0714c9fff9369e10adecb3b3b6",
            "url": "https://github.com/google/j2objc.git"
        },
        {
            "kind": "blob",
            "path": "./j2objc-annotations-1.3.pom",
            "sha256": "5faca824ba115bee458730337dfdb2fcea46ba2fd774d4304edbf30fa6a3f055",
            "url": "https://repo1.maven.org/maven2/com/google/j2objc/j2objc-annotations/1.3/j2objc-annotations-1.3.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/oss-parent@7"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/j2objc-annotations@1.3"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find annotations/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/j2objc-annotations-1.3.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/j2objc/j2objc-annotations/1.3",
            "*:*:cp $WORKDIR/j2objc-annotations-1.3.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/j2objc/j2objc-annotations/1.3/j2objc-annotations-1.3.jar",
            "*:*:cp j2objc-annotations-1.3.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/j2objc/j2objc-annotations/1.3/j2objc-annotations-1.3.pom"
        ]
    }
}