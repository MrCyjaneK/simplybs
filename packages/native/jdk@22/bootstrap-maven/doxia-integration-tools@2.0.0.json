{
    "package": "native/jdk@22/bootstrap-maven/doxia-integration-tools@2.0.0",
    "version": "2.0.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "0f79ba1c1dad16d1b001a09fdc7eafd1049792d5",
            "url": "https://github.com/apache/maven-doxia-sitetools.git"
        },
        {
            "kind": "blob",
            "path": "./doxia-integration-tools-2.0.0.pom",
            "sha256": "b3707bdb06778745b0304985c340a9847eeda20f4ca7f2902faf6c266cc29653",
            "url": "https://repo1.maven.org/maven2/org/apache/maven/doxia/doxia-integration-tools/2.0.0/doxia-integration-tools-2.0.0.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/maven@3.9-bin",
        "*:*:native/jdk@22/bootstrap-maven/pom/doxia-sitetools@2.0.0",
        "*:*:native/jdk@22/bootstrap-maven/maven-reporting-api@4.0.0",
        "*:*:native/jdk@22/bootstrap-maven/doxia-site-model@2.0.0",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/commons-io@2.16.1",
        "*:*:native/jdk@22/bootstrap-maven/plexus-i18n@1.0-beta-10",
        "*:*:native/jdk@22/bootstrap-maven/plexus-utils@4.0.2",
        "*:*:native/jdk@22/bootstrap-maven/plexus-xml@3.0.1",
        "*:*:native/jdk@22/bootstrap-maven/plexus-interpolation@1.27"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/doxia-integration-tools@2.0.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository",
            "*:*:BOOT_LIB=$NATIVEPREFIX/maven-3.9-bootstrap/lib"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find doxia-integration-tools/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $(printf '%s:' $BOOT_LIB/*.jar)$REPO/org/apache/maven/reporting/maven-reporting-api/4.0.0/maven-reporting-api-4.0.0.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/commons-io/commons-io/2.16.1/commons-io-2.16.1.jar:$REPO/org/apache/maven/doxia/doxia-site-model/2.0.0/doxia-site-model-2.0.0.jar:$REPO/org/codehaus/plexus/plexus-i18n/1.0-beta-10/plexus-i18n-1.0-beta-10.jar:$REPO/org/codehaus/plexus/plexus-utils/4.0.2/plexus-utils-4.0.2.jar:$REPO/org/codehaus/plexus/plexus-xml/3.0.1/plexus-xml-3.0.1.jar:$REPO/org/codehaus/plexus/plexus-interpolation/1.27/plexus-interpolation-1.27.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:cp -R doxia-integration-tools/src/main/resources/. $WORKDIR/classes/",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/doxia-integration-tools-2.0.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/doxia/doxia-integration-tools/2.0.0",
            "*:*:cp $WORKDIR/doxia-integration-tools-2.0.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/doxia/doxia-integration-tools/2.0.0/doxia-integration-tools-2.0.0.jar",
            "*:*:cp doxia-integration-tools-2.0.0.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/doxia/doxia-integration-tools/2.0.0/doxia-integration-tools-2.0.0.pom"
        ]
    }
}