{
    "package": "native/jdk@22/bootstrap-maven/asm@9.6",
    "version": "9.6",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "85cf1aeb0d08be8446f6efbda962817d2a9707dd",
            "url": "https://gitlab.ow2.org/asm/asm.git"
        },
        {
            "kind": "blob",
            "path": "./asm-9.6.pom",
            "sha256": "92eee24bc3c843e4881d46c1dd6505471ee3142facfb466b428cfea5a56c6b60",
            "url": "https://repo1.maven.org/maven2/org/ow2/asm/asm/9.6/asm-9.6.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/ow2@1.5.1"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/asm@9.6"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find asm/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/asm-9.6.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/ow2/asm/asm/9.6",
            "*:*:cp $WORKDIR/asm-9.6.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/ow2/asm/asm/9.6/asm-9.6.jar",
            "*:*:cp asm-9.6.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/ow2/asm/asm/9.6/asm-9.6.pom"
        ]
    }
}