{
    "package": "native/jdk@22/bootstrap-maven/commons-codec@1.16.1",
    "version": "1.16.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "e59fc76531141cb4a36f3031457b9d5f07e5e43f",
            "url": "https://github.com/apache/commons-codec.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/commons-parent@66"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/commons-codec@1.16.1"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/commons-codec-1.16.1.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-codec/commons-codec/1.16.1",
            "*:*:cp $WORKDIR/commons-codec-1.16.1.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-codec/commons-codec/1.16.1/commons-codec-1.16.1.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-codec/commons-codec/1.16.1/commons-codec-1.16.1.pom"
        ]
    }
}