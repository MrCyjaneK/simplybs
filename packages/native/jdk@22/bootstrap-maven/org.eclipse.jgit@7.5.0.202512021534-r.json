        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/org.eclipse.jgit-parent@7.5.0.202512021534-r",
        "*:*:native/jdk@22/bootstrap-maven/JavaEWAH@1.2.3",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@2.0.17",
        "*:*:native/jdk@22/bootstrap-maven/commons-codec@1.20.0"
