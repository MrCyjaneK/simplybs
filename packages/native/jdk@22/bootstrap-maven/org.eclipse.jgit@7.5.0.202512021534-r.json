            "*:*:cp -R org.eclipse.jgit/resources/. $WORKDIR/classes/",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/org.eclipse.jgit-7.5.0.202512021534-r.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/jgit/org.eclipse.jgit/7.5.0.202512021534-r",
            "*:*:cp $WORKDIR/org.eclipse.jgit-7.5.0.202512021534-r.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/jgit/org.eclipse.jgit/7.5.0.202512021534-r/org.eclipse.jgit-7.5.0.202512021534-r.jar",
            "*:*:cp org.eclipse.jgit/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/jgit/org.eclipse.jgit/7.5.0.202512021534-r/org.eclipse.jgit-7.5.0.202512021534-r.pom"
        ]
    }
