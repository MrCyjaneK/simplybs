{
    "package": "native/jdk@22/bootstrap-maven/org.abego.treelayout.core@1.0.3",
    "version": "1.0.3",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "fb5b5326d9fe642b9ca0631c3da739bf775f6374",
            "url": "https://github.com/abego/treelayout.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/oss-parent@7"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/org.abego.treelayout.core@1.0.3"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find org.abego.treelayout/src -name '*.java' ! -path '*/test/*' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/org.abego.treelayout.core-1.0.3.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/abego/treelayout/org.abego.treelayout.core/1.0.3",
            "*:*:cp $WORKDIR/org.abego.treelayout.core-1.0.3.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/abego/treelayout/org.abego.treelayout.core/1.0.3/org.abego.treelayout.core-1.0.3.jar",
            "*:*:cp org.abego.treelayout/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/abego/treelayout/org.abego.treelayout.core/1.0.3/org.abego.treelayout.core-1.0.3.pom"
        ]
    }
}