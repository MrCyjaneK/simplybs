{
    "package": "native/jdk@22/bootstrap-maven/plexus-utils@3.5.0",
    "version": "3.5.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "2b784ba7f518257c2215a34103c38bbda2a45056",
            "url": "https://github.com/codehaus-plexus/plexus-utils.git"
        },
        {
            "kind": "blob",
            "path": "./plexus-utils-3.5.0.pom",
            "sha256": "aa4ea451bb6fa92e9cc96654eef53e334ff4d36a946633e01765fed41e845e03",
            "url": "https://repo1.maven.org/maven2/org/codehaus/plexus/plexus-utils/3.5.0/plexus-utils-3.5.0.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/plexus@10"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/plexus-utils@3.5.0"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-utils-3.5.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/3.5.0",
            "*:*:cp $WORKDIR/plexus-utils-3.5.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/3.5.0/plexus-utils-3.5.0.jar",
            "*:*:cp plexus-utils-3.5.0.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/3.5.0/plexus-utils-3.5.0.pom"
        ]
    }
}