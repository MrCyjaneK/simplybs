{
    "package": "native/jdk@22/bootstrap-maven/slf4j-simple@1.7.36",
    "version": "1.7.36",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "e9ee55cca93c2bf26f14482a9bdf961c750d2a56",
            "url": "https://github.com/qos-ch/slf4j.git"
        },
        {
            "kind": "blob",
            "path": "./slf4j-simple-1.7.36.pom",
            "sha256": "c56b80a0a6bea2a0463e70d0892ae338a9e507e486767a520453409812058d1b",
            "url": "https://repo1.maven.org/maven2/org/slf4j/slf4j-simple/1.7.36/slf4j-simple-1.7.36.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/slf4j-parent@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/slf4j-simple@1.7.36",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find slf4j-simple/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/slf4j-simple-1.7.36.jar -C $WORKDIR/classes .",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/slf4j-simple-1.7.36-sources.jar -C slf4j-simple/src/main/java .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/slf4j/slf4j-simple/1.7.36",
            "*:*:cp $WORKDIR/slf4j-simple-1.7.36.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/slf4j/slf4j-simple/1.7.36/slf4j-simple-1.7.36.jar",
            "*:*:cp slf4j-simple-1.7.36.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/slf4j/slf4j-simple/1.7.36/slf4j-simple-1.7.36.pom",
            "*:*:cp $WORKDIR/slf4j-simple-1.7.36-sources.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/slf4j/slf4j-simple/1.7.36/slf4j-simple-1.7.36-sources.jar"
        ]
    }
}