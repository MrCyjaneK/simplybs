{
    "package": "native/jdk@22/bootstrap-maven/plexus-utils@3.3.1",
    "version": "3.3.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "2229b3556a5f0467ef7b936cc1b031468b9e08b3",
            "url": "https://github.com/codehaus-plexus/plexus-utils.git"
        },
        {
            "kind": "blob",
            "path": "./plexus-utils-3.3.1.pom",
            "sha256": "5e583878df905b5f33a230ef690a52b8f19dab9cc892bedee069f3d8af4e960a",
            "url": "https://repo1.maven.org/maven2/org/codehaus/plexus/plexus-utils/3.3.1/plexus-utils-3.3.1.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/plexus@5.1"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/plexus-utils@3.3.1"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-utils-3.3.1.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/3.3.1",
            "*:*:cp $WORKDIR/plexus-utils-3.3.1.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/3.3.1/plexus-utils-3.3.1.jar",
            "*:*:cp plexus-utils-3.3.1.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/3.3.1/plexus-utils-3.3.1.pom"
        ]
    }
}