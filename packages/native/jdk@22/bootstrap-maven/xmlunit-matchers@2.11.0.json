{
    "package": "native/jdk@22/bootstrap-maven/xmlunit-matchers@2.11.0",
    "version": "2.11.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "02aef5d5950d4f113d26b3bc6d32320a0d1ec6f1",
            "url": "https://github.com/xmlunit/xmlunit.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/xmlunit-parent@2.11.0",
        "*:*:native/jdk@22/bootstrap-maven/xmlunit-core@2.11.0",
        "*:*:native/jdk@22/bootstrap-maven/hamcrest-core@1.3"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/xmlunit-matchers@2.11.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find xmlunit-matchers/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/org/xmlunit/xmlunit-core/2.11.0/xmlunit-core-2.11.0.jar:$REPO/org/hamcrest/hamcrest-core/1.3/hamcrest-core-1.3.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/xmlunit-matchers-2.11.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/xmlunit/xmlunit-matchers/2.11.0",
            "*:*:cp $WORKDIR/xmlunit-matchers-2.11.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/xmlunit/xmlunit-matchers/2.11.0/xmlunit-matchers-2.11.0.jar",
            "*:*:cp xmlunit-matchers/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/xmlunit/xmlunit-matchers/2.11.0/xmlunit-matchers-2.11.0.pom"
        ]
    }
}