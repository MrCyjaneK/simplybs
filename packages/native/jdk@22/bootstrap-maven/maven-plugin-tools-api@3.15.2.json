{
    "package": "native/jdk@22/bootstrap-maven/maven-plugin-tools-api@3.15.2",
    "version": "3.15.2",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "f7ed01b82c390ff629cecdb3cda88ec9346cc92a",
            "url": "https://github.com/apache/maven-plugin-tools.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/maven@3.9-bin",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/plexus-java@1.5.2",
        "*:*:native/jdk@22/bootstrap-maven/maven-reporting-api@3.1.1",
        "*:*:native/jdk@22/bootstrap-maven/httpclient@4.5.14",
        "*:*:native/jdk@22/bootstrap-maven/httpcore@4.4.16",
        "*:*:native/jdk@22/bootstrap-maven/wagon-provider-api@3.5.3",
        "*:*:native/jdk@22/bootstrap-maven/plexus-classworlds@2.6.0"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/maven-plugin-tools-api@3.15.2",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository",
            "*:*:BOOT_LIB=$NATIVEPREFIX/maven-3.9-bootstrap/lib"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find maven-plugin-tools-api/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $(printf '%s:' $BOOT_LIB/*.jar)$REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/org/codehaus/plexus/plexus-java/1.5.2/plexus-java-1.5.2.jar:$REPO/org/apache/maven/reporting/maven-reporting-api/3.1.1/maven-reporting-api-3.1.1.jar:$REPO/org/apache/httpcomponents/httpclient/4.5.14/httpclient-4.5.14.jar:$REPO/org/apache/httpcomponents/httpcore/4.4.16/httpcore-4.4.16.jar:$REPO/org/apache/maven/wagon/wagon-provider-api/3.5.3/wagon-provider-api-3.5.3.jar:$REPO/org/codehaus/plexus/plexus-classworlds/2.6.0/plexus-classworlds-2.6.0.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/maven-plugin-tools-api-3.15.2.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugin-tools/maven-plugin-tools-api/3.15.2",
            "*:*:cp $WORKDIR/maven-plugin-tools-api-3.15.2.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugin-tools/maven-plugin-tools-api/3.15.2/maven-plugin-tools-api-3.15.2.jar",
            "*:*:cp maven-plugin-tools-api/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugin-tools/maven-plugin-tools-api/3.15.2/maven-plugin-tools-api-3.15.2.pom"
        ]
    }
}