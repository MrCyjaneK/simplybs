{
    "package": "native/jdk@22/bootstrap-maven/apache-rat-core@0.16.1",
    "version": "0.16.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "bc422708ba1569b6acf793703c435c78b16ca60c",
            "url": "https://github.com/apache/creadur-rat.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/apache-rat-project@0.16.1",
        "*:*:native/jdk@22/bootstrap-maven/commons-collections4@4.4",
        "*:*:native/jdk@22/bootstrap-maven/commons-lang3@3.14.0",
        "*:*:native/jdk@22/bootstrap-maven/commons-io@2.15.1",
        "*:*:native/jdk@22/bootstrap-maven/commons-compress@1.25.0",
        "*:*:native/jdk@22/bootstrap-maven/commons-cli@1.6.0",
        "*:*:native/jdk@22/bootstrap-maven/commons-beanutils@1.9.4"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/apache-rat-core@0.16.1",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find apache-rat-core/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $REPO/org/apache/commons/commons-collections4/4.4/commons-collections4-4.4.jar:$REPO/org/apache/commons/commons-lang3/3.14.0/commons-lang3-3.14.0.jar:$REPO/commons-io/commons-io/2.15.1/commons-io-2.15.1.jar:$REPO/org/apache/commons/commons-compress/1.25.0/commons-compress-1.25.0.jar:$REPO/commons-cli/commons-cli/1.6.0/commons-cli-1.6.0.jar:$REPO/commons-beanutils/commons-beanutils/1.9.4/commons-beanutils-1.9.4.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:cp -R apache-rat-core/src/main/resources/. $WORKDIR/classes/",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/apache-rat-core-0.16.1.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/rat/apache-rat-core/0.16.1",
            "*:*:cp $WORKDIR/apache-rat-core-0.16.1.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/rat/apache-rat-core/0.16.1/apache-rat-core-0.16.1.jar",
            "*:*:cp apache-rat-core/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/rat/apache-rat-core/0.16.1/apache-rat-core-0.16.1.pom"
        ]
    }
}