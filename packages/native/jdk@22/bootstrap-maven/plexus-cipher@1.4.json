{
    "package": "native/jdk@22/bootstrap-maven/plexus-cipher@1.4",
    "version": "1.4",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "a73d92e2bd4a3cc9dc250c0e4b24cf2313a2682d",
            "url": "https://github.com/sonatype/plexus-cipher.git"
        },
        {
            "kind": "blob",
            "path": "./plexus-cipher-1.4.pom",
            "sha256": "a63a2e23988cca7fac6c93886d6f0506fd26d88d7e8cc0cb89b9c6e0d6c994ad",
            "url": "https://repo1.maven.org/maven2/org/sonatype/plexus/plexus-cipher/1.4/plexus-cipher-1.4.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/sed",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/spice-parent@12"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/plexus-cipher@1.4"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:sed -i '/javax.enterprise.inject.Typed/d; /javax.inject.Named/d; /@Named/d; /@Typed/d' src/main/java/org/sonatype/plexus/components/cipher/DefaultPlexusCipher.java",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-cipher-1.4.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/sonatype/plexus/plexus-cipher/1.4",
            "*:*:cp $WORKDIR/plexus-cipher-1.4.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/sonatype/plexus/plexus-cipher/1.4/plexus-cipher-1.4.jar",
            "*:*:cp plexus-cipher-1.4.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/sonatype/plexus/plexus-cipher/1.4/plexus-cipher-1.4.pom"
        ]
    }
}