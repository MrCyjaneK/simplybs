{
    "package": "native/jdk@22/bootstrap-maven/plexus-utils@3.5.1",
    "version": "3.5.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "8488ff2200964f47114b9dee5604dc3314a2fe8a",
            "url": "https://github.com/codehaus-plexus/plexus-utils.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/plexus@10"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/plexus-utils@3.5.1"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-utils-3.5.1.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/3.5.1",
            "*:*:cp $WORKDIR/plexus-utils-3.5.1.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/3.5.1/plexus-utils-3.5.1.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/3.5.1/plexus-utils-3.5.1.pom"
        ]
    }
}