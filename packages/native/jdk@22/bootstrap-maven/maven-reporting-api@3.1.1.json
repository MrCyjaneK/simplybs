{
    "package": "native/jdk@22/bootstrap-maven/maven-reporting-api@3.1.1",
    "version": "3.1.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "d61224e3318f825673deee76eddc13a8a20be426",
            "url": "https://github.com/apache/maven-reporting-api.git"
        },
        {
            "kind": "blob",
            "path": "./maven-reporting-api-3.1.1.pom",
            "sha256": "74903e91bafbc97bfd43a73daf64e2ee86045563cef43ee8713b588946b1a16c",
            "url": "https://repo1.maven.org/maven2/org/apache/maven/reporting/maven-reporting-api/3.1.1/maven-reporting-api-3.1.1.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/maven-shared-components@34",
        "*:*:native/jdk@22/bootstrap-maven/doxia-sink-api@1.12.0"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/maven-reporting-api@3.1.1",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $REPO/org/apache/maven/doxia/doxia-sink-api/1.12.0/doxia-sink-api-1.12.0.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/maven-reporting-api-3.1.1.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/reporting/maven-reporting-api/3.1.1",
            "*:*:cp $WORKDIR/maven-reporting-api-3.1.1.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/reporting/maven-reporting-api/3.1.1/maven-reporting-api-3.1.1.jar",
            "*:*:cp maven-reporting-api-3.1.1.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/reporting/maven-reporting-api/3.1.1/maven-reporting-api-3.1.1.pom"
        ]
    }
}