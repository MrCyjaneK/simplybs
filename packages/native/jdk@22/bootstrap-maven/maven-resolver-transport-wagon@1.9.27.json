{
    "package": "native/jdk@22/bootstrap-maven/maven-resolver-transport-wagon@1.9.27",
    "version": "1.9.27",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "bac936257dc7daf7eb14b7082551a054f16641db",
            "url": "https://github.com/apache/maven-resolver.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/maven-resolver@1.9.27",
        "*:*:native/jdk@22/bootstrap-maven/wagon-provider-api@3.5.3",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/maven-resolver-transport-wagon@1.9.27",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find maven-resolver-transport-wagon/src/main/java -name '*.java' ! -name 'module-info.java' ! -name 'PlexusWagonConfigurator.java' ! -name 'PlexusWagonProvider.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/org/apache/maven/resolver/maven-resolver-api/1.9.27/maven-resolver-api-1.9.27.jar:$REPO/org/apache/maven/resolver/maven-resolver-spi/1.9.27/maven-resolver-spi-1.9.27.jar:$REPO/org/apache/maven/resolver/maven-resolver-util/1.9.27/maven-resolver-util-1.9.27.jar:$REPO/org/apache/maven/wagon/wagon-provider-api/3.5.3/wagon-provider-api-3.5.3.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/maven-resolver-transport-wagon-1.9.27.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/resolver/maven-resolver-transport-wagon/1.9.27",
            "*:*:cp $WORKDIR/maven-resolver-transport-wagon-1.9.27.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/resolver/maven-resolver-transport-wagon/1.9.27/maven-resolver-transport-wagon-1.9.27.jar",
            "*:*:cp maven-resolver-transport-wagon/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/resolver/maven-resolver-transport-wagon/1.9.27/maven-resolver-transport-wagon-1.9.27.pom"
        ]
    }
}