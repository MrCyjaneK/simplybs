{
    "package": "native/jdk@22/bootstrap-maven/javax.annotation-api@1.3.2",
    "version": "1.3.2",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "5000694c178b93a952510dff6afcc2101e6e0490",
            "url": "https://github.com/javaee/javax.annotation.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/jvnet-parent@3"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/javax.annotation-api@1.3.2"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/javax.annotation-api-1.3.2.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/javax/annotation/javax.annotation-api/1.3.2",
            "*:*:cp $WORKDIR/javax.annotation-api-1.3.2.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/javax/annotation/javax.annotation-api/1.3.2/javax.annotation-api-1.3.2.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/javax/annotation/javax.annotation-api/1.3.2/javax.annotation-api-1.3.2.pom"
        ]
    }
}