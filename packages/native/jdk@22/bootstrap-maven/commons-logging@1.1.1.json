{
    "package": "native/jdk@22/bootstrap-maven/commons-logging@1.1.1",
    "version": "1.1.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "a4f4ec12f83e9d78e2a5dd24186ed004db463048",
            "url": "https://github.com/apache/commons-logging.git"
        },
        {
            "kind": "blob",
            "path": "./commons-logging-1.1.1.pom",
            "sha256": "d0f2e16d054e8bb97add9ca26525eb2346f692809fcd2a28787da8ceb3c35ee8",
            "url": "https://repo1.maven.org/maven2/commons-logging/commons-logging/1.1.1/commons-logging-1.1.1.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/commons-parent@5"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/commons-logging@1.1.1"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/java -name '*.java' ! -name 'Log4JLogger.java' ! -name 'LogKitLogger.java' ! -name 'AvalonLogger.java' ! -name 'Jdk13LumberjackLogger.java' ! -name 'ServletContextCleaner.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/commons-logging-1.1.1.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-logging/commons-logging/1.1.1",
            "*:*:cp $WORKDIR/commons-logging-1.1.1.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-logging/commons-logging/1.1.1/commons-logging-1.1.1.jar",
            "*:*:cp commons-logging-1.1.1.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-logging/commons-logging/1.1.1/commons-logging-1.1.1.pom"
        ]
    }
}