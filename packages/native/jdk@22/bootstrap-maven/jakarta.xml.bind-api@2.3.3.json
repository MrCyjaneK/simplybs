{
    "package": "native/jdk@22/bootstrap-maven/jakarta.xml.bind-api@2.3.3",
    "version": "2.3.3",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "fd06b2b050cf612695ec7f0c372815e3910de154",
            "url": "https://github.com/eclipse-ee4j/jaxb-api.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/jakarta.xml.bind-api-parent@2.3.3",
        "*:*:native/jdk@22/bootstrap-maven/jakarta.activation-api@1.2.2"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/jakarta.xml.bind-api@2.3.3",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find jaxb-api/src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/jakarta/activation/jakarta.activation-api/1.2.2/jakarta.activation-api-1.2.2.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/jakarta.xml.bind-api-2.3.3.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/jakarta/xml/bind/jakarta.xml.bind-api/2.3.3",
            "*:*:cp $WORKDIR/jakarta.xml.bind-api-2.3.3.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/jakarta/xml/bind/jakarta.xml.bind-api/2.3.3/jakarta.xml.bind-api-2.3.3.jar",
            "*:*:cp jaxb-api/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/jakarta/xml/bind/jakarta.xml.bind-api/2.3.3/jakarta.xml.bind-api-2.3.3.pom"
        ]
    }
}