{
    "package": "native/jdk@22/bootstrap-maven/jsoup@1.22.1",
    "version": "1.22.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "8dd66febe8d5e2221a63f4d1228a2a35df81c148",
            "url": "https://github.com/jhy/jsoup.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/jspecify@1.0.0",
        "*:*:native/jdk@22/bootstrap-maven/re2j@1.8"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/jsoup@1.22.1",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/org/jspecify/jspecify/1.0.0/jspecify-1.0.0.jar:$REPO/com/google/re2j/re2j/1.8/re2j-1.8.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/jsoup-1.22.1.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/jsoup/jsoup/1.22.1",
            "*:*:cp $WORKDIR/jsoup-1.22.1.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/jsoup/jsoup/1.22.1/jsoup-1.22.1.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/jsoup/jsoup/1.22.1/jsoup-1.22.1.pom"
        ]
    }
}