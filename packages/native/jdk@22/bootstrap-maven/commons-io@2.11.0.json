{
    "package": "native/jdk@22/bootstrap-maven/commons-io@2.11.0",
    "version": "2.11.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "8985de8fe74f6622a419b37a6eed0dbc484dc128",
            "url": "https://github.com/apache/commons-io.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/commons-parent@52"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/commons-io@2.11.0"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/commons-io-2.11.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-io/commons-io/2.11.0",
            "*:*:cp $WORKDIR/commons-io-2.11.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-io/commons-io/2.11.0/commons-io-2.11.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-io/commons-io/2.11.0/commons-io-2.11.0.pom"
        ]
    }
}