{
    "package": "native/jdk@22/bootstrap-maven/plexus-resources@1.3.1",
    "version": "1.3.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "449698ff6048d0cb19ed0c1b4c62dbcbec181989",
            "url": "https://github.com/codehaus-plexus/plexus-resources.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/org.eclipse.sisu.inject@1.0.0",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/plexus-xml@3.0.1",
        "*:*:native/jdk@22/bootstrap-maven/plexus-utils@4.0.2",
        "*:*:native/jdk@22/bootstrap-maven/pom/plexus@23"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/plexus-resources@1.3.1",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/org/codehaus/plexus/plexus-utils/4.0.2/plexus-utils-4.0.2.jar:$REPO/org/codehaus/plexus/plexus-xml/3.0.1/plexus-xml-3.0.1.jar -processorpath $REPO/org/eclipse/sisu/org.eclipse.sisu.inject/1.0.0/org.eclipse.sisu.inject-1.0.0.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar -processor org.eclipse.sisu.space.SisuIndexAPT6 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-resources-1.3.1.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-resources/1.3.1",
            "*:*:cp $WORKDIR/plexus-resources-1.3.1.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-resources/1.3.1/plexus-resources-1.3.1.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-resources/1.3.1/plexus-resources-1.3.1.pom"
        ]
    }
}