{
    "package": "native/jdk@22/bootstrap-maven/plexus-utils@3.6.0",
    "version": "3.6.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "b7230bd6243248c3866ae9c9380408e8d7568545",
            "url": "https://github.com/codehaus-plexus/plexus-utils.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/plexus@19"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/plexus-utils@3.6.0"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-utils-3.6.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/3.6.0",
            "*:*:cp $WORKDIR/plexus-utils-3.6.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/3.6.0/plexus-utils-3.6.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/3.6.0/plexus-utils-3.6.0.pom"
        ]
    }
}