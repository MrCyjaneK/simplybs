            "*:*:cp trilead-ssh2-1.0.0-build217.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/trilead/trilead-ssh2/1.0.0-build217/trilead-ssh2-1.0.0-build217.pom"
