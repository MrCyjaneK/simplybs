{
    "package": "native/jdk@22/bootstrap-maven/plexus-component-annotations@2.0.0",
    "version": "2.0.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "4f0fabaf9984fb2647af9fdc67144b43d460950b",
            "url": "https://github.com/codehaus-plexus/plexus-containers.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/plexus-containers@2.0.0"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/plexus-component-annotations@2.0.0"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find plexus-component-annotations/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-component-annotations-2.0.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-component-annotations/2.0.0",
            "*:*:cp $WORKDIR/plexus-component-annotations-2.0.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-component-annotations/2.0.0/plexus-component-annotations-2.0.0.jar",
            "*:*:cp plexus-component-annotations/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-component-annotations/2.0.0/plexus-component-annotations-2.0.0.pom"
        ]
    }
}