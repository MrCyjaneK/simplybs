{
    "package": "native/jdk@22/bootstrap-maven/plexus-interpolation@1.28",
    "version": "1.28",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "6c5b841d25dc35ed825a16d20138650acf23eae2",
            "url": "https://github.com/codehaus-plexus/plexus-interpolation.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/plexus@20"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/plexus-interpolation@1.28"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-interpolation-1.28.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-interpolation/1.28",
            "*:*:cp $WORKDIR/plexus-interpolation-1.28.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-interpolation/1.28/plexus-interpolation-1.28.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-interpolation/1.28/plexus-interpolation-1.28.pom"
        ]
    }
}