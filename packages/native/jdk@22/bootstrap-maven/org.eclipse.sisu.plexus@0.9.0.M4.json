{
    "package": "native/jdk@22/bootstrap-maven/org.eclipse.sisu.plexus@0.9.0.M4",
    "version": "0.9.0.M4",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "c9ee92dde343bf5935eabfa028016988fb462ac7",
            "url": "https://github.com/eclipse-sisu/sisu-project.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/sed",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/guice@4.0",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/plexus-component-annotations@2.1.0",
        "*:*:native/jdk@22/bootstrap-maven/plexus-classworlds@2.6.0",
        "*:*:native/jdk@22/bootstrap-maven/plexus-utils@3.5.1",
        "*:*:native/jdk@22/bootstrap-maven/plexus-xml@3.0.0",
        "*:*:native/jdk@22/bootstrap-maven/asm@9.8"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/org.eclipse.sisu.plexus@0.9.0.M4",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/sisu/sisu-inject/0.9.0.M4",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/sisu/sisu-inject/0.9.0.M4/sisu-inject-0.9.0.M4.pom",
            "*:*:cp $PATCH_DIR/maven/sisu-inject-0.9.0.M3-Implementations.java org.eclipse.sisu.inject/src/main/java/org/eclipse/sisu/inject/Implementations.java",
            "*:*:sed -i 's/javax.enterprise.inject.Typed/org.eclipse.sisu.Typed/g' org.eclipse.sisu.inject/src/main/java/org/eclipse/sisu/space/QualifiedTypeBinder.java",
            "*:*:find org.eclipse.sisu.inject/src/main/java -name '*.java' ! -path '*/launch/*' ! -path '*/osgi/*' ! -name 'BundleClassSpace.java' >$WORKDIR/inject.sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/com/google/inject/guice/4.0/guice-4.0.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/org/ow2/asm/asm/9.8/asm-9.8.jar -d $WORKDIR/inject @$WORKDIR/inject.sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/org.eclipse.sisu.inject-0.9.0.M4.jar -C $WORKDIR/inject .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/sisu/org.eclipse.sisu.inject/0.9.0.M4",
            "*:*:cp $WORKDIR/org.eclipse.sisu.inject-0.9.0.M4.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/sisu/org.eclipse.sisu.inject/0.9.0.M4/org.eclipse.sisu.inject-0.9.0.M4.jar",
            "*:*:cp org.eclipse.sisu.inject/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/sisu/org.eclipse.sisu.inject/0.9.0.M4/org.eclipse.sisu.inject-0.9.0.M4.pom",
            "*:*:find org.eclipse.sisu.plexus/src/main/java -name '*.java' ! -name 'PlexusBundlePlan.java' ! -name 'PlexusTestCase.java' >$WORKDIR/plexus.sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $WORKDIR/org.eclipse.sisu.inject-0.9.0.M4.jar:$REPO/com/google/inject/guice/4.0/guice-4.0.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/org/codehaus/plexus/plexus-component-annotations/2.1.0/plexus-component-annotations-2.1.0.jar:$REPO/org/codehaus/plexus/plexus-classworlds/2.6.0/plexus-classworlds-2.6.0.jar:$REPO/org/codehaus/plexus/plexus-utils/3.5.1/plexus-utils-3.5.1.jar:$REPO/org/codehaus/plexus/plexus-xml/3.0.0/plexus-xml-3.0.0.jar -d $WORKDIR/plexus @$WORKDIR/plexus.sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/org.eclipse.sisu.plexus-0.9.0.M4.jar -C $WORKDIR/plexus .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/sisu/org.eclipse.sisu.plexus/0.9.0.M4",
            "*:*:cp $WORKDIR/org.eclipse.sisu.plexus-0.9.0.M4.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/sisu/org.eclipse.sisu.plexus/0.9.0.M4/org.eclipse.sisu.plexus-0.9.0.M4.jar",
            "*:*:cp org.eclipse.sisu.plexus/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/sisu/org.eclipse.sisu.plexus/0.9.0.M4/org.eclipse.sisu.plexus-0.9.0.M4.pom"
        ]
    }
}