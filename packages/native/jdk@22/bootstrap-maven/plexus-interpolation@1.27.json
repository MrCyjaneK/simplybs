{
    "package": "native/jdk@22/bootstrap-maven/plexus-interpolation@1.27",
    "version": "1.27",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "f44266e74556c30fddcae4b20ee477e7e64a5204",
            "url": "https://github.com/codehaus-plexus/plexus-interpolation.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/plexus-interpolation@1.27"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-interpolation-1.27.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-interpolation/1.27",
            "*:*:cp $WORKDIR/plexus-interpolation-1.27.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-interpolation/1.27/plexus-interpolation-1.27.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-interpolation/1.27/plexus-interpolation-1.27.pom"
        ]
    }
}