{
    "package": "native/jdk@22/bootstrap-maven/guice@4.0",
    "version": "4.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "5a209e98e0dedf3dbb2cc657514e7daf1707296c",
            "url": "https://github.com/google/guice.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/sed",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/guice-parent@4.0",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1",
        "*:*:native/jdk@22/bootstrap-maven/aopalliance@1.0",
        "*:*:native/jdk@22/bootstrap-maven/guava@31.0.1-jre",
        "*:*:native/jdk@22/bootstrap-maven/asm@9.9.1",
        "*:*:native/jdk@22/bootstrap-maven/cglib@2.2.2"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/guice@4.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find core/src -name '*.java' -exec sed -i 's/Objects.toStringHelper/com.google.common.base.MoreObjects.toStringHelper/g' {} +",
            "*:*:find core/src -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/aopalliance/aopalliance/1.0/aopalliance-1.0.jar:$REPO/com/google/guava/guava/31.0.1-jre/guava-31.0.1-jre.jar:$REPO/org/ow2/asm/asm/9.9.1/asm-9.9.1.jar:$REPO/cglib/cglib/2.2.2/cglib-2.2.2.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/guice-4.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/inject/guice/4.0",
            "*:*:cp $WORKDIR/guice-4.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/inject/guice/4.0/guice-4.0.jar",
            "*:*:cp core/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/inject/guice/4.0/guice-4.0.pom"
        ]
    }
}