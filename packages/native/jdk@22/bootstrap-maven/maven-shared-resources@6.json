{
    "package": "native/jdk@22/bootstrap-maven/maven-shared-resources@6",
    "version": "6",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "96d16734b2ca46b91bbae9cd0f1596b4bfbb4862",
            "url": "https://github.com/apache/maven-shared-resources.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/maven-shared-components@42"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/maven-shared-resources@6"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:cp -R src/main/resources/. $WORKDIR/classes/",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/maven-shared-resources-6.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/shared/maven-shared-resources/6",
            "*:*:cp $WORKDIR/maven-shared-resources-6.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/shared/maven-shared-resources/6/maven-shared-resources-6.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/shared/maven-shared-resources/6/maven-shared-resources-6.pom"
        ]
    }
}