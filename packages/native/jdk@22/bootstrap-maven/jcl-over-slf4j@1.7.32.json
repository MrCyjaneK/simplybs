{
    "package": "native/jdk@22/bootstrap-maven/jcl-over-slf4j@1.7.32",
    "version": "1.7.32",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "0d8774854f4ebb0807bcb69867c13f1e991fcde5",
            "url": "https://github.com/qos-ch/slf4j.git"
        },
        {
            "kind": "blob",
            "path": "./jcl-over-slf4j-1.7.32.pom",
            "sha256": "5f18eac2c5458ffcc402415610c3b78e499002168bf8ec8fe2efe1de506a2756",
            "url": "https://repo1.maven.org/maven2/org/slf4j/jcl-over-slf4j/1.7.32/jcl-over-slf4j-1.7.32.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/slf4j-parent@1.7.32",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.32"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/jcl-over-slf4j@1.7.32",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find jcl-over-slf4j/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $REPO/org/slf4j/slf4j-api/1.7.32/slf4j-api-1.7.32.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/jcl-over-slf4j-1.7.32.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/slf4j/jcl-over-slf4j/1.7.32",
            "*:*:cp $WORKDIR/jcl-over-slf4j-1.7.32.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/slf4j/jcl-over-slf4j/1.7.32/jcl-over-slf4j-1.7.32.jar",
            "*:*:cp jcl-over-slf4j-1.7.32.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/slf4j/jcl-over-slf4j/1.7.32/jcl-over-slf4j-1.7.32.pom"
        ]
    }
}