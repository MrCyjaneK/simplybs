{
    "package": "native/jdk@22/bootstrap-maven/logback-core@1.2.13",
    "version": "1.2.13",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "2648b9e7fbb47426c89b9c93b411c07484e8f277",
            "url": "https://github.com/qos-ch/logback.git"
        },
        {
            "kind": "blob",
            "path": "./logback-core-1.2.13.pom",
            "sha256": "6a1402ecf487bb827315da679e1306e357b2aed2448578a8de058d5af39de9be",
            "url": "https://repo1.maven.org/maven2/ch/qos/logback/logback-core/1.2.13/logback-core-1.2.13.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/logback-parent@1.2.13",
        "*:*:native/jdk@22/bootstrap-maven/janino@3.0.6",
        "*:*:native/jdk@22/bootstrap-maven/commons-compiler@3.0.6"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/logback-core@1.2.13",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find logback-core/src/main/java -name '*.java' ! -name 'SMTPAppenderBase.java' ! -name 'LoginAuthenticator.java' ! -name 'ViewStatusMessagesServletBase.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/org/codehaus/janino/commons-compiler/3.0.6/commons-compiler-3.0.6.jar:$REPO/org/codehaus/janino/janino/3.0.6/janino-3.0.6.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:if [ -d logback-core/src/main/resources ]; then cp -R logback-core/src/main/resources/. $WORKDIR/classes/; fi",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/logback-core-1.2.13.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/ch/qos/logback/logback-core/1.2.13",
            "*:*:cp $WORKDIR/logback-core-1.2.13.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/ch/qos/logback/logback-core/1.2.13/logback-core-1.2.13.jar",
            "*:*:cp logback-core-1.2.13.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/ch/qos/logback/logback-core/1.2.13/logback-core-1.2.13.pom"
        ]
    }
}