{
    "package": "native/jdk@22/bootstrap-maven/maven-scm-provider-svnjava@2.3.0",
    "version": "2.3.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "e70e5dd7e583d0e0f07f374dfaa36f59fbbbb09e",
            "url": "https://github.com/olamy/maven-scm-provider-svnjava.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/oss-parent@9",
        "*:*:native/jdk@22/bootstrap-maven/maven-scm@2.0.0-M3",
        "*:*:native/jdk@22/bootstrap-maven/svnkit@1.10.10",
        "*:*:native/jdk@22/bootstrap-maven/trilead-ssh2@1.0.0-build222",
        "*:*:native/jdk@22/bootstrap-maven/jna@5.12.1",
        "*:*:native/jdk@22/bootstrap-maven/plexus-utils@3.5.0",
        "*:*:native/jdk@22/bootstrap-maven/commons-lang@2.6",
        "*:*:native/jdk@22/bootstrap-maven/commons-io@2.11.0",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/maven-scm-provider-svnjava@2.3.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/org/apache/maven/scm/maven-scm-api/2.0.0-M3/maven-scm-api-2.0.0-M3.jar:$REPO/org/apache/maven/scm/maven-scm-provider-svn-commons/2.0.0-M3/maven-scm-provider-svn-commons-2.0.0-M3.jar:$REPO/org/tmatesoft/svnkit/svnkit/1.10.10/svnkit-1.10.10.jar:$REPO/com/trilead/trilead-ssh2/1.0.0-build222/trilead-ssh2-1.0.0-build222.jar:$REPO/net/java/dev/jna/jna/5.12.1/jna-5.12.1.jar:$REPO/org/codehaus/plexus/plexus-utils/3.5.0/plexus-utils-3.5.0.jar:$REPO/commons-lang/commons-lang/2.6/commons-lang-2.6.jar:$REPO/commons-io/commons-io/2.11.0/commons-io-2.11.0.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:cp -R src/main/resources/. $WORKDIR/classes/",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/maven-scm-provider-svnjava-2.3.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/code/maven-scm-provider-svnjava/maven-scm-provider-svnjava/2.3.0",
            "*:*:cp $WORKDIR/maven-scm-provider-svnjava-2.3.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/code/maven-scm-provider-svnjava/maven-scm-provider-svnjava/2.3.0/maven-scm-provider-svnjava-2.3.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/code/maven-scm-provider-svnjava/maven-scm-provider-svnjava/2.3.0/maven-scm-provider-svnjava-2.3.0.pom"
        ]
    }
}