{
    "package": "native/jdk@22/bootstrap-maven/failureaccess@1.0.3",
    "version": "1.0.3",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "6b1a22f80cd9496f20913c5efbc656c9c4c5f912",
            "url": "https://github.com/google/guava.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/failureaccess@1.0.3"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find futures/failureaccess/src -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/failureaccess-1.0.3.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/guava/failureaccess/1.0.3",
            "*:*:cp $WORKDIR/failureaccess-1.0.3.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/guava/failureaccess/1.0.3/failureaccess-1.0.3.jar",
            "*:*:cp futures/failureaccess/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/guava/failureaccess/1.0.3/failureaccess-1.0.3.pom"
        ]
    }
}