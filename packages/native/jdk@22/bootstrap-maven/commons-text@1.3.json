{
    "package": "native/jdk@22/bootstrap-maven/commons-text@1.3",
    "version": "1.3",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "4ac48357180c9222f032dd8b055d90e1192e4a47",
            "url": "https://github.com/apache/commons-text.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/commons-parent@45",
        "*:*:native/jdk@22/bootstrap-maven/commons-lang3@3.14.0"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/commons-text@1.3",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/org/apache/commons/commons-lang3/3.14.0/commons-lang3-3.14.0.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/commons-text-1.3.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/commons/commons-text/1.3",
            "*:*:cp $WORKDIR/commons-text-1.3.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/commons/commons-text/1.3/commons-text-1.3.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/commons/commons-text/1.3/commons-text-1.3.pom"
        ]
    }
}