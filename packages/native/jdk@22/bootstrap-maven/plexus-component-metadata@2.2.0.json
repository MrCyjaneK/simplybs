{
    "package": "native/jdk@22/bootstrap-maven/plexus-component-metadata@2.2.0",
    "version": "2.2.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "2b1502b4cf2e6c2ecd381f515c38bfe335d4e3bb",
            "url": "https://github.com/codehaus-plexus/plexus-containers.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/maven@3.9-bin",
        "*:*:native/jdk@22/bootstrap-maven/pom/plexus-containers@2.2.0",
        "*:*:native/jdk@22/bootstrap-maven/plexus-component-annotations@2.2.0",
        "*:*:native/jdk@22/bootstrap-maven/plexus-utils@3.5.1",
        "*:*:native/jdk@22/bootstrap-maven/qdox@2.0.3",
        "*:*:native/jdk@22/bootstrap-maven/jdom2@2.0.6.1",
        "*:*:native/jdk@22/bootstrap-maven/asm@9.6",
        "*:*:native/jdk@22/bootstrap-maven/maven-plugin-annotations@3.15.2",
        "*:*:native/jdk@22/bootstrap-maven/maven-plugin-tools-generators@3.15.2"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/plexus-component-metadata@2.2.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository",
            "*:*:BOOT_LIB=$NATIVEPREFIX/maven-3.9-bootstrap/lib"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes $WORKDIR/pluginxml/META-INF/maven $WORKDIR/pluginxml/META-INF/plexus",
            "*:*:find plexus-component-metadata/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $(printf '%s:' $BOOT_LIB/*.jar)$REPO/org/codehaus/plexus/plexus-component-annotations/2.2.0/plexus-component-annotations-2.2.0.jar:$REPO/org/codehaus/plexus/plexus-utils/3.5.1/plexus-utils-3.5.1.jar:$REPO/com/thoughtworks/qdox/qdox/2.0.3/qdox-2.0.3.jar:$REPO/org/jdom/jdom2/2.0.6.1/jdom2-2.0.6.1.jar:$REPO/org/ow2/asm/asm/9.6/asm-9.6.jar:$REPO/org/apache/maven/plugin-tools/maven-plugin-annotations/3.15.2/maven-plugin-annotations-3.15.2.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/java -cp $PLUGINXML_JAR:$(printf '%s:' $BOOT_LIB/*.jar) org.apache.maven.tools.plugin.generator.GeneratePluginXml org.codehaus.plexus plexus-component-metadata 2.2.0 plexus-component-metadata $WORKDIR/classes $WORKDIR/pluginxml/META-INF/maven $(printf '%s:' $BOOT_LIB/*.jar)$REPO/org/codehaus/plexus/plexus-component-annotations/2.2.0/plexus-component-annotations-2.2.0.jar:$REPO/org/codehaus/plexus/plexus-utils/3.5.1/plexus-utils-3.5.1.jar:$REPO/com/thoughtworks/qdox/qdox/2.0.3/qdox-2.0.3.jar:$REPO/org/jdom/jdom2/2.0.6.1/jdom2-2.0.6.1.jar:$REPO/org/ow2/asm/asm/9.6/asm-9.6.jar:$REPO/org/apache/maven/plugin-tools/maven-plugin-annotations/3.15.2/maven-plugin-annotations-3.15.2.jar",
            "*:*:cp plexus-component-metadata/src/main/resources/META-INF/plexus/components.xml $WORKDIR/pluginxml/META-INF/plexus/components.xml",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-component-metadata-2.2.0.jar -C $WORKDIR/classes . -C $WORKDIR/pluginxml .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-component-metadata/2.2.0",
            "*:*:cp $WORKDIR/plexus-component-metadata-2.2.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-component-metadata/2.2.0/plexus-component-metadata-2.2.0.jar",
            "*:*:cp plexus-component-metadata/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-component-metadata/2.2.0/plexus-component-metadata-2.2.0.pom"
        ]
    }
}