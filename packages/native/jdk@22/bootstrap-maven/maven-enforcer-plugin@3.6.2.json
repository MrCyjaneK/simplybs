{
    "package": "native/jdk@22/bootstrap-maven/maven-enforcer-plugin@3.6.2",
    "version": "3.6.2",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "82ba7700115bdf5ec8f267741a9e232adf91b51e",
            "url": "https://github.com/apache/maven-enforcer.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/org.eclipse.sisu.inject@1.0.0",
        "*:*:native/maven@3.9-bin",
        "*:*:native/jdk@22/bootstrap-maven/pom/enforcer@3.6.2",
        "*:*:native/jdk@22/bootstrap-maven/jsr305@3.0.2",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/plexus-utils@4.0.2",
        "*:*:native/jdk@22/bootstrap-maven/plexus-xml@3.0.1",
        "*:*:native/jdk@22/bootstrap-maven/maven-plugin-annotations@3.15.2",
        "*:*:native/jdk@22/bootstrap-maven/maven-plugin-tools-generators@3.15.2",
        "*:*:native/jdk@22/bootstrap-maven/maven-resolver@1.9.23",
        "*:*:native/jdk@22/bootstrap-maven/commons-codec@1.19.0",
        "*:*:native/jdk@22/bootstrap-maven/commons-io@2.20.0",
        "*:*:native/jdk@22/bootstrap-maven/commons-lang3@3.19.0",
        "*:*:native/jdk@22/bootstrap-maven/bsh@2.0b6"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/maven-enforcer-plugin@3.6.2",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository",
            "*:*:BOOT_LIB=$NATIVEPREFIX/maven-3.9-bootstrap/lib",
            "*:*:BOOT_BOOT=$NATIVEPREFIX/maven-3.9-bootstrap/boot"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find enforcer-api/src/main/java -name '*.java' >$WORKDIR/api.sources",
            "*:*:$JAVA_HOME/bin/javac -cp $(printf '%s:' $BOOT_LIB/*.jar $BOOT_BOOT/*.jar)$REPO/com/google/code/findbugs/jsr305/3.0.2/jsr305-3.0.2.jar -d $WORKDIR/api @$WORKDIR/api.sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/enforcer-api-3.6.2.jar -C $WORKDIR/api .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/enforcer/enforcer-api/3.6.2",
            "*:*:cp $WORKDIR/enforcer-api-3.6.2.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/enforcer/enforcer-api/3.6.2/enforcer-api-3.6.2.jar",
            "*:*:cp enforcer-api/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/enforcer/enforcer-api/3.6.2/enforcer-api-3.6.2.pom",
            "*:*:find enforcer-rules/src/main/java -name '*.java' >$WORKDIR/rules.sources",
            "*:*:$JAVA_HOME/bin/javac -cp $(printf '%s:' $BOOT_LIB/*.jar $BOOT_BOOT/*.jar)$WORKDIR/enforcer-api-3.6.2.jar:$REPO/com/google/code/findbugs/jsr305/3.0.2/jsr305-3.0.2.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/apache/maven/resolver/maven-resolver-api/1.9.23/maven-resolver-api-1.9.23.jar:$REPO/org/apache/maven/resolver/maven-resolver-util/1.9.23/maven-resolver-util-1.9.23.jar:$REPO/commons-codec/commons-codec/1.19.0/commons-codec-1.19.0.jar:$REPO/commons-io/commons-io/2.20.0/commons-io-2.20.0.jar:$REPO/org/apache/commons/commons-lang3/3.19.0/commons-lang3-3.19.0.jar:$REPO/org/apache-extras/beanshell/bsh/2.0b6/bsh-2.0b6.jar:$REPO/org/codehaus/plexus/plexus-utils/4.0.2/plexus-utils-4.0.2.jar:$REPO/org/codehaus/plexus/plexus-xml/3.0.1/plexus-xml-3.0.1.jar -processorpath $REPO/org/eclipse/sisu/org.eclipse.sisu.inject/1.0.0/org.eclipse.sisu.inject-1.0.0.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar -processor org.eclipse.sisu.space.SisuIndexAPT6 -d $WORKDIR/rules @$WORKDIR/rules.sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/enforcer-rules-3.6.2.jar -C $WORKDIR/rules .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/enforcer/enforcer-rules/3.6.2",
            "*:*:cp $WORKDIR/enforcer-rules-3.6.2.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/enforcer/enforcer-rules/3.6.2/enforcer-rules-3.6.2.jar",
            "*:*:cp enforcer-rules/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/enforcer/enforcer-rules/3.6.2/enforcer-rules-3.6.2.pom",
            "*:*:find maven-enforcer-plugin/src/main/java -name '*.java' >$WORKDIR/plugin.sources",
            "*:*:$JAVA_HOME/bin/javac -cp $(printf '%s:' $BOOT_LIB/*.jar $BOOT_BOOT/*.jar)$WORKDIR/enforcer-api-3.6.2.jar:$WORKDIR/enforcer-rules-3.6.2.jar:$REPO/org/apache/maven/plugin-tools/maven-plugin-annotations/3.15.2/maven-plugin-annotations-3.15.2.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/org/apache/maven/resolver/maven-resolver-api/1.9.23/maven-resolver-api-1.9.23.jar:$REPO/org/codehaus/plexus/plexus-utils/4.0.2/plexus-utils-4.0.2.jar:$REPO/org/codehaus/plexus/plexus-xml/3.0.1/plexus-xml-3.0.1.jar -processorpath $REPO/org/eclipse/sisu/org.eclipse.sisu.inject/1.0.0/org.eclipse.sisu.inject-1.0.0.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar -processor org.eclipse.sisu.space.SisuIndexAPT6 -d $WORKDIR/plugin @$WORKDIR/plugin.sources",
            "*:*:mkdir -p $WORKDIR/plugin-res/META-INF/maven",
            "*:*:$JAVA_HOME/bin/java -cp $PLUGINXML_JAR:$(printf '%s:' $BOOT_LIB/*.jar) org.apache.maven.tools.plugin.generator.GeneratePluginXml org.apache.maven.plugins maven-enforcer-plugin 3.6.2 enforcer $WORKDIR/plugin $WORKDIR/plugin-res/META-INF/maven $(printf '%s:' $BOOT_LIB/*.jar $BOOT_BOOT/*.jar)$WORKDIR/enforcer-api-3.6.2.jar:$WORKDIR/enforcer-rules-3.6.2.jar:$REPO/org/apache/maven/plugin-tools/maven-plugin-annotations/3.15.2/maven-plugin-annotations-3.15.2.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/org/apache/maven/resolver/maven-resolver-api/1.9.23/maven-resolver-api-1.9.23.jar:$REPO/org/codehaus/plexus/plexus-utils/4.0.2/plexus-utils-4.0.2.jar:$REPO/org/codehaus/plexus/plexus-xml/3.0.1/plexus-xml-3.0.1.jar",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/maven-enforcer-plugin-3.6.2.jar -C $WORKDIR/plugin . -C $WORKDIR/plugin-res .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugins/maven-enforcer-plugin/3.6.2",
            "*:*:cp $WORKDIR/maven-enforcer-plugin-3.6.2.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugins/maven-enforcer-plugin/3.6.2/maven-enforcer-plugin-3.6.2.jar",
            "*:*:cp maven-enforcer-plugin/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugins/maven-enforcer-plugin/3.6.2/maven-enforcer-plugin-3.6.2.pom"
        ]
    }
}