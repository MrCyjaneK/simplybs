{
    "package": "native/jdk@22/bootstrap-maven/doxia-core@1.12.0",
    "version": "1.12.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "281dc2c380cc14ba758d693c5b463186c53c2fb5",
            "url": "https://github.com/apache/maven-doxia.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/doxia@1.12.0",
        "*:*:native/jdk@22/bootstrap-maven/doxia-sink-api@1.12.0",
        "*:*:native/jdk@22/bootstrap-maven/doxia-logging-api@1.12.0",
        "*:*:native/jdk@22/bootstrap-maven/plexus-utils@3.5.1",
        "*:*:native/jdk@22/bootstrap-maven/plexus-component-annotations@2.1.0",
        "*:*:native/jdk@22/bootstrap-maven/commons-lang3@3.14.0",
        "*:*:native/jdk@22/bootstrap-maven/commons-text@1.3",
        "*:*:native/jdk@22/bootstrap-maven/httpclient@4.5.13",
        "*:*:native/jdk@22/bootstrap-maven/httpcore@4.4.14",
        "*:*:native/jdk@22/bootstrap-maven/plexus-container-default@2.1.0"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/doxia-core@1.12.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find doxia-core/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $REPO/org/apache/maven/doxia/doxia-sink-api/1.12.0/doxia-sink-api-1.12.0.jar:$REPO/org/apache/maven/doxia/doxia-logging-api/1.12.0/doxia-logging-api-1.12.0.jar:$REPO/org/codehaus/plexus/plexus-utils/3.5.1/plexus-utils-3.5.1.jar:$REPO/org/codehaus/plexus/plexus-component-annotations/2.1.0/plexus-component-annotations-2.1.0.jar:$REPO/org/codehaus/plexus/plexus-container-default/2.1.0/plexus-container-default-2.1.0.jar:$REPO/org/apache/commons/commons-lang3/3.14.0/commons-lang3-3.14.0.jar:$REPO/org/apache/commons/commons-text/1.3/commons-text-1.3.jar:$REPO/org/apache/httpcomponents/httpclient/4.5.13/httpclient-4.5.13.jar:$REPO/org/apache/httpcomponents/httpcore/4.4.14/httpcore-4.4.14.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/doxia-core-1.12.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/doxia/doxia-core/1.12.0",
            "*:*:cp $WORKDIR/doxia-core-1.12.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/doxia/doxia-core/1.12.0/doxia-core-1.12.0.jar",
            "*:*:cp doxia-core/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/doxia/doxia-core/1.12.0/doxia-core-1.12.0.pom"
        ]
    }
}