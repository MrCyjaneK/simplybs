{
    "package": "native/jdk@22/bootstrap-maven/j2objc-annotations@3.1",
    "version": "3.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "1671e9afb72a16126d448f468db3e582358fba47",
            "url": "https://github.com/google/j2objc.git"
        },
        {
            "kind": "blob",
            "path": "./j2objc-annotations-3.1.pom",
            "sha256": "14570838500034fc1b47c8205ce1c9d6b255c1ccdd2d1afdcdcbf75e89b24a33",
            "url": "https://repo1.maven.org/maven2/com/google/j2objc/j2objc-annotations/3.1/j2objc-annotations-3.1.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/j2objc-annotations@3.1"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find annotations/src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/j2objc-annotations-3.1.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/j2objc/j2objc-annotations/3.1",
            "*:*:cp $WORKDIR/j2objc-annotations-3.1.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/j2objc/j2objc-annotations/3.1/j2objc-annotations-3.1.jar",
            "*:*:cp j2objc-annotations-3.1.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/google/j2objc/j2objc-annotations/3.1/j2objc-annotations-3.1.pom"
        ]
    }
}