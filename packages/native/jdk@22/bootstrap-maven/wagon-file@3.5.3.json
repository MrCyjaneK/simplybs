{
    "package": "native/jdk@22/bootstrap-maven/wagon-file@3.5.3",
    "version": "3.5.3",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "20b847446bb60f49af0428d592eadee774b5bff2",
            "url": "https://github.com/apache/maven-wagon.git"
        },
        {
            "kind": "blob",
            "path": "./wagon-file-3.5.3.pom",
            "sha256": "b89e540a7e432329bb5d93f2dfc578f898960afed66ae6a2dfeaa3d48d32c09c",
            "url": "https://repo1.maven.org/maven2/org/apache/maven/wagon/wagon-file/3.5.3/wagon-file-3.5.3.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/wagon-providers@3.5.3",
        "*:*:native/jdk@22/bootstrap-maven/wagon-provider-api@3.5.3",
        "*:*:native/jdk@22/bootstrap-maven/plexus-utils@3.5.1",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-simple@1.7.36"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/wagon-file@3.5.3",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find wagon-providers/wagon-file/src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/org/apache/maven/wagon/wagon-provider-api/3.5.3/wagon-provider-api-3.5.3.jar:$REPO/org/codehaus/plexus/plexus-utils/3.5.1/plexus-utils-3.5.1.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/wagon-file-3.5.3.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/wagon/wagon-file/3.5.3",
            "*:*:cp $WORKDIR/wagon-file-3.5.3.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/wagon/wagon-file/3.5.3/wagon-file-3.5.3.jar",
            "*:*:cp wagon-file-3.5.3.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/wagon/wagon-file/3.5.3/wagon-file-3.5.3.pom"
        ]
    }
}