{
    "package": "native/jdk@22/bootstrap-maven/org.eclipse.sisu.inject@1.0.0",
    "version": "1.0.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "4e6a00efdf39bcc37362197d96582cd9a9c41a7d",
            "url": "https://github.com/eclipse-sisu/sisu-project.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/sed",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/guice@4.0",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/asm@9.9.1"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/org.eclipse.sisu.inject@1.0.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/sisu/sisu-inject/1.0.0",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/sisu/sisu-inject/1.0.0/sisu-inject-1.0.0.pom",
            "*:*:cp $PATCH_DIR/maven/sisu-inject-0.9.0.M3-Implementations.java org.eclipse.sisu.inject/src/main/java/org/eclipse/sisu/inject/Implementations.java",
            "*:*:sed -i 's/javax.enterprise.inject.Typed/org.eclipse.sisu.Typed/g' org.eclipse.sisu.inject/src/main/java/org/eclipse/sisu/space/QualifiedTypeBinder.java",
            "*:*:find org.eclipse.sisu.inject/src/main/java -name '*.java' ! -path '*/launch/*' ! -path '*/osgi/*' ! -name 'BundleClassSpace.java' >$WORKDIR/inject.sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/com/google/inject/guice/4.0/guice-4.0.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/org/ow2/asm/asm/9.9.1/asm-9.9.1.jar -d $WORKDIR/inject @$WORKDIR/inject.sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/org.eclipse.sisu.inject-1.0.0.jar -C $WORKDIR/inject .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/sisu/org.eclipse.sisu.inject/1.0.0",
            "*:*:cp $WORKDIR/org.eclipse.sisu.inject-1.0.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/sisu/org.eclipse.sisu.inject/1.0.0/org.eclipse.sisu.inject-1.0.0.jar",
            "*:*:cp org.eclipse.sisu.inject/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/eclipse/sisu/org.eclipse.sisu.inject/1.0.0/org.eclipse.sisu.inject-1.0.0.pom"
        ]
    }
}