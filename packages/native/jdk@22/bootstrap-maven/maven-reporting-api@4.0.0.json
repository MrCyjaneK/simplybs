{
    "package": "native/jdk@22/bootstrap-maven/maven-reporting-api@4.0.0",
    "version": "4.0.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "ad877cd9072d6570c3addfd9a6e3b72ce913c56b",
            "url": "https://github.com/apache/maven-reporting-api.git"
        },
        {
            "kind": "blob",
            "path": "./maven-reporting-api-4.0.0.pom",
            "sha256": "2032531f05994121c2fdb5df7235ed548f53d294d0b7ac45e797148d85a30ee2",
            "url": "https://repo1.maven.org/maven2/org/apache/maven/reporting/maven-reporting-api/4.0.0/maven-reporting-api-4.0.0.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/maven-shared-components@43",
        "*:*:native/jdk@22/bootstrap-maven/doxia-sink-api@2.0.0"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/maven-reporting-api@4.0.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $REPO/org/apache/maven/doxia/doxia-sink-api/2.0.0/doxia-sink-api-2.0.0.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/maven-reporting-api-4.0.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/reporting/maven-reporting-api/4.0.0",
            "*:*:cp $WORKDIR/maven-reporting-api-4.0.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/reporting/maven-reporting-api/4.0.0/maven-reporting-api-4.0.0.jar",
            "*:*:cp maven-reporting-api-4.0.0.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/reporting/maven-reporting-api/4.0.0/maven-reporting-api-4.0.0.pom"
        ]
    }
}