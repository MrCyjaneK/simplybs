{
    "package": "native/jdk@22/bootstrap-maven/maven-assembly-plugin@3.8.0",
    "version": "3.8.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "434b3aa2b516cb03fdccdd63548a53013c7368f0",
            "url": "https://github.com/apache/maven-assembly-plugin.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/org.eclipse.sisu.inject@1.0.0",
        "*:*:native/maven@3.9-bin",
        "*:*:native/jdk@22/bootstrap-maven/pom/maven-plugins@45",
        "*:*:native/jdk@22/bootstrap-maven/modello@2.6.0",
        "*:*:native/jdk@22/bootstrap-maven/plexus-build-api@1.2.0",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/maven-plugin-annotations@3.15.2",
        "*:*:native/jdk@22/bootstrap-maven/maven-plugin-tools-generators@3.15.2",
        "*:*:native/jdk@22/bootstrap-maven/maven-resolver@1.4.1",
        "*:*:native/jdk@22/bootstrap-maven/maven-common-artifact-filters@3.4.0",
        "*:*:native/jdk@22/bootstrap-maven/plexus-interpolation@1.29",
        "*:*:native/jdk@22/bootstrap-maven/commons-io@2.21.0",
        "*:*:native/jdk@22/bootstrap-maven/maven-filtering@3.4.0",
        "*:*:native/jdk@22/bootstrap-maven/plexus-io@3.6.0",
        "*:*:native/jdk@22/bootstrap-maven/plexus-archiver@4.10.4",
        "*:*:native/jdk@22/bootstrap-maven/maven-archiver@3.6.5",
        "*:*:native/jdk@22/bootstrap-maven/plexus-utils@4.0.2",
        "*:*:native/jdk@22/bootstrap-maven/plexus-xml@3.0.1",
        "*:*:native/jdk@22/bootstrap-maven/plexus-classworlds@2.6.0"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/maven-assembly-plugin@3.8.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository",
            "*:*:BOOT_LIB=$NATIVEPREFIX/maven-3.9-bootstrap/lib",
            "*:*:MODELLO_CP=$NATIVEPREFIX/share/maven/repository/javax/inject/javax.inject/1/javax.inject-1.jar:$NATIVEPREFIX/share/maven/repository/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-utils/4.0.2/plexus-utils-4.0.2.jar:$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-xml/3.0.1/plexus-xml-3.0.1.jar:$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-build-api/1.2.0/plexus-build-api-1.2.0.jar:$NATIVEPREFIX/share/maven/repository/org/codehaus/modello/modello-core/2.6.0/modello-core-2.6.0.jar:$NATIVEPREFIX/share/maven/repository/org/codehaus/modello/modello-plugin-java/2.6.0/modello-plugin-java-2.6.0.jar:$NATIVEPREFIX/share/maven/repository/org/codehaus/modello/modello-plugin-xml/2.6.0/modello-plugin-xml-2.6.0.jar:$NATIVEPREFIX/share/maven/repository/org/codehaus/modello/modello-plugin-xpp3/2.6.0/modello-plugin-xpp3-2.6.0.jar"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/generated $WORKDIR/classes $WORKDIR/pluginxml/META-INF/maven",
            "*:*:$JAVA_HOME/bin/javac -cp $MODELLO_CP -d $WORKDIR $PATCH_DIR/maven/RunModello.java",
            "*:*:$JAVA_HOME/bin/java -cp $WORKDIR:$MODELLO_CP RunModello src/main/mdo/assembly.mdo 2.2.0 $WORKDIR/generated java xpp3-reader xpp3-writer",
            "*:*:$JAVA_HOME/bin/java -cp $WORKDIR:$MODELLO_CP RunModello src/main/mdo/assembly-component.mdo 2.2.0 $WORKDIR/generated java xpp3-reader xpp3-writer",
            "*:*:find src/main/java $WORKDIR/generated -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $(printf '%s:' $BOOT_LIB/*.jar)$REPO/org/apache/maven/plugin-tools/maven-plugin-annotations/3.15.2/maven-plugin-annotations-3.15.2.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/org/apache/maven/resolver/maven-resolver-api/1.4.1/maven-resolver-api-1.4.1.jar:$REPO/org/apache/maven/resolver/maven-resolver-util/1.4.1/maven-resolver-util-1.4.1.jar:$REPO/org/apache/maven/shared/maven-common-artifact-filters/3.4.0/maven-common-artifact-filters-3.4.0.jar:$REPO/org/codehaus/plexus/plexus-interpolation/1.29/plexus-interpolation-1.29.jar:$REPO/commons-io/commons-io/2.21.0/commons-io-2.21.0.jar:$REPO/org/apache/maven/shared/maven-filtering/3.4.0/maven-filtering-3.4.0.jar:$REPO/org/codehaus/plexus/plexus-io/3.6.0/plexus-io-3.6.0.jar:$REPO/org/codehaus/plexus/plexus-archiver/4.10.4/plexus-archiver-4.10.4.jar:$REPO/org/apache/maven/maven-archiver/3.6.5/maven-archiver-3.6.5.jar:$REPO/org/codehaus/plexus/plexus-utils/4.0.2/plexus-utils-4.0.2.jar:$REPO/org/codehaus/plexus/plexus-xml/3.0.1/plexus-xml-3.0.1.jar:$REPO/org/codehaus/plexus/plexus-classworlds/2.6.0/plexus-classworlds-2.6.0.jar -processorpath $REPO/org/eclipse/sisu/org.eclipse.sisu.inject/1.0.0/org.eclipse.sisu.inject-1.0.0.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar -processor org.eclipse.sisu.space.SisuIndexAPT6 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:if [ -d src/main/resources ]; then cp -R src/main/resources/. $WORKDIR/classes/; fi",
            "*:*:$JAVA_HOME/bin/java -cp $PLUGINXML_JAR:$(printf '%s:' $BOOT_LIB/*.jar) org.apache.maven.tools.plugin.generator.GeneratePluginXml org.apache.maven.plugins maven-assembly-plugin 3.8.0 assembly $WORKDIR/classes $WORKDIR/pluginxml/META-INF/maven $(printf '%s:' $BOOT_LIB/*.jar)$REPO/org/apache/maven/plugin-tools/maven-plugin-annotations/3.15.2/maven-plugin-annotations-3.15.2.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/org/apache/maven/resolver/maven-resolver-api/1.4.1/maven-resolver-api-1.4.1.jar:$REPO/org/apache/maven/resolver/maven-resolver-util/1.4.1/maven-resolver-util-1.4.1.jar:$REPO/org/apache/maven/shared/maven-common-artifact-filters/3.4.0/maven-common-artifact-filters-3.4.0.jar:$REPO/org/codehaus/plexus/plexus-interpolation/1.29/plexus-interpolation-1.29.jar:$REPO/commons-io/commons-io/2.21.0/commons-io-2.21.0.jar:$REPO/org/apache/maven/shared/maven-filtering/3.4.0/maven-filtering-3.4.0.jar:$REPO/org/codehaus/plexus/plexus-io/3.6.0/plexus-io-3.6.0.jar:$REPO/org/codehaus/plexus/plexus-archiver/4.10.4/plexus-archiver-4.10.4.jar:$REPO/org/apache/maven/maven-archiver/3.6.5/maven-archiver-3.6.5.jar:$REPO/org/codehaus/plexus/plexus-utils/4.0.2/plexus-utils-4.0.2.jar:$REPO/org/codehaus/plexus/plexus-xml/3.0.1/plexus-xml-3.0.1.jar:$REPO/org/codehaus/plexus/plexus-classworlds/2.6.0/plexus-classworlds-2.6.0.jar",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/maven-assembly-plugin-3.8.0.jar -C $WORKDIR/classes . -C $WORKDIR/pluginxml .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugins/maven-assembly-plugin/3.8.0",
            "*:*:cp $WORKDIR/maven-assembly-plugin-3.8.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugins/maven-assembly-plugin/3.8.0/maven-assembly-plugin-3.8.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugins/maven-assembly-plugin/3.8.0/maven-assembly-plugin-3.8.0.pom"
        ]
    }
}