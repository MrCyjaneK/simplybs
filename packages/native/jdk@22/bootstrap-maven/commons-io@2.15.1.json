{
    "package": "native/jdk@22/bootstrap-maven/commons-io@2.15.1",
    "version": "2.15.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "dc51644d5adbb0c461efb58380ec51fbca10005d",
            "url": "https://github.com/apache/commons-io.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/findutils",
        "*:*:native/coreutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/commons-parent@65"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/commons-io@2.15.1"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/commons-io-2.15.1.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-io/commons-io/2.15.1",
            "*:*:cp $WORKDIR/commons-io-2.15.1.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-io/commons-io/2.15.1/commons-io-2.15.1.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-io/commons-io/2.15.1/commons-io-2.15.1.pom"
        ]
    }
}