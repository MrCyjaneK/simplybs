{
    "package": "native/jdk@22/bootstrap-maven/bsh@2.0b6",
    "version": "2.0b6",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "7bf2199161b4cfe717d38d412ec6cf3f21751200",
            "url": "https://github.com/beanshell/beanshell.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/bsh@2.0b6"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src asm/src -name '*.java' ! -path '*/servlet/*' ! -name 'AWT*.java' ! -name '*Applet.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/bsh-2.0b6.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache-extras/beanshell/bsh/2.0b6",
            "*:*:cp $WORKDIR/bsh-2.0b6.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache-extras/beanshell/bsh/2.0b6/bsh-2.0b6.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache-extras/beanshell/bsh/2.0b6/bsh-2.0b6.pom"
        ]
    }
}