{
    "package": "native/jdk@22/bootstrap-maven/mockito-core@4.11.0",
    "version": "4.11.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "483e15f9f940716a85f2d58f6c28981136790c4e",
            "url": "https://github.com/mockito/mockito.git"
        },
        {
            "kind": "blob",
            "path": "./mockito-core-4.11.0.pom",
            "sha256": "2bc2e3c8c8b313fdac231f23822225b07831dc899d067072f49d5f8ae37e739a",
            "url": "https://repo1.maven.org/maven2/org/mockito/mockito-core/4.11.0/mockito-core-4.11.0.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/byte-buddy@1.12.19",
        "*:*:native/jdk@22/bootstrap-maven/byte-buddy-agent@1.12.19",
        "*:*:native/jdk@22/bootstrap-maven/objenesis@3.3",
        "*:*:native/jdk@22/bootstrap-maven/junit@4.13.2",
        "*:*:native/jdk@22/bootstrap-maven/hamcrest-core@1.3",
        "*:*:native/jdk@22/bootstrap-maven/opentest4j@1.3.0"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/mockito-core@4.11.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -XDignore.symbol.file -cp $REPO/net/bytebuddy/byte-buddy/1.12.19/byte-buddy-1.12.19.jar:$REPO/net/bytebuddy/byte-buddy-agent/1.12.19/byte-buddy-agent-1.12.19.jar:$REPO/org/objenesis/objenesis/3.3/objenesis-3.3.jar:$REPO/junit/junit/4.13.2/junit-4.13.2.jar:$REPO/org/hamcrest/hamcrest-core/1.3/hamcrest-core-1.3.jar:$REPO/org/opentest4j/opentest4j/1.3.0/opentest4j-1.3.0.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/mockito-core-4.11.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/mockito/mockito-core/4.11.0",
            "*:*:cp $WORKDIR/mockito-core-4.11.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/mockito/mockito-core/4.11.0/mockito-core-4.11.0.jar",
            "*:*:cp mockito-core-4.11.0.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/mockito/mockito-core/4.11.0/mockito-core-4.11.0.pom"
        ]
    }
}