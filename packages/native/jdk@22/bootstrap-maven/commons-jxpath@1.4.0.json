{
    "package": "native/jdk@22/bootstrap-maven/commons-jxpath@1.4.0",
    "version": "1.4.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "146f2534e885fd7085fba4bf3fb658d434416504",
            "url": "https://github.com/apache/commons-jxpath.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/commons-parent@81",
        "*:*:native/jdk@22/bootstrap-maven/commons-beanutils@1.9.4"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/commons-jxpath@1.4.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' ! -name 'module-info.java' ! -path '*/servlet/*' ! -path '*/jdom/*' ! -name 'JDOMParser.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/commons-beanutils/commons-beanutils/1.9.4/commons-beanutils-1.9.4.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/commons-jxpath-1.4.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-jxpath/commons-jxpath/1.4.0",
            "*:*:cp $WORKDIR/commons-jxpath-1.4.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-jxpath/commons-jxpath/1.4.0/commons-jxpath-1.4.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-jxpath/commons-jxpath/1.4.0/commons-jxpath-1.4.0.pom"
        ]
    }
}