{
    "package": "native/jdk@22/bootstrap-maven/junit@4.13.2",
    "version": "4.13.2",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "05fe2a64f59127c02135be22f416e91260d6ede6",
            "url": "https://github.com/junit-team/junit4.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/hamcrest-core@1.3"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/junit@4.13.2",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/org/hamcrest/hamcrest-core/1.3/hamcrest-core-1.3.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/junit-4.13.2.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/junit/junit/4.13.2",
            "*:*:cp $WORKDIR/junit-4.13.2.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/junit/junit/4.13.2/junit-4.13.2.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/junit/junit/4.13.2/junit-4.13.2.pom"
        ]
    }
}