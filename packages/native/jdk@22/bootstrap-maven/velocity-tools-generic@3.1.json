{
    "package": "native/jdk@22/bootstrap-maven/velocity-tools-generic@3.1",
    "version": "3.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "8e7f20a477351362ab2d29d564e11e4f5b2b3cd5",
            "url": "https://github.com/apache/velocity-tools.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/velocity-tools-parent@3.1",
        "*:*:native/jdk@22/bootstrap-maven/velocity-engine-core@2.4",
        "*:*:native/jdk@22/bootstrap-maven/commons-beanutils@1.9.4",
        "*:*:native/jdk@22/bootstrap-maven/commons-digester3@3.2",
        "*:*:native/jdk@22/bootstrap-maven/commons-lang3@3.17.0",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/json-simple@3.0.2"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/velocity-tools-generic@3.1",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find velocity-tools-generic/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $REPO/org/apache/velocity/velocity-engine-core/2.4/velocity-engine-core-2.4.jar:$REPO/commons-beanutils/commons-beanutils/1.9.4/commons-beanutils-1.9.4.jar:$REPO/org/apache/commons/commons-digester3/3.2/commons-digester3-3.2.jar:$REPO/org/apache/commons/commons-lang3/3.17.0/commons-lang3-3.17.0.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/com/github/cliftonlabs/json-simple/3.0.2/json-simple-3.0.2.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/velocity-tools-generic-3.1.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/velocity/tools/velocity-tools-generic/3.1",
            "*:*:cp $WORKDIR/velocity-tools-generic-3.1.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/velocity/tools/velocity-tools-generic/3.1/velocity-tools-generic-3.1.jar",
            "*:*:cp velocity-tools-generic/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/velocity/tools/velocity-tools-generic/3.1/velocity-tools-generic-3.1.pom"
        ]
    }
}