{
    "package": "native/jdk@22/bootstrap-maven/commons-lang3@3.14.0",
    "version": "3.14.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "c8774fa74adbbbcd4e5f915ab6bc3aa10d877419",
            "url": "https://github.com/apache/commons-lang.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/commons-parent@64"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/commons-lang3@3.14.0"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/commons-lang3-3.14.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/commons/commons-lang3/3.14.0",
            "*:*:cp $WORKDIR/commons-lang3-3.14.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/commons/commons-lang3/3.14.0/commons-lang3-3.14.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/commons/commons-lang3/3.14.0/commons-lang3-3.14.0.pom"
        ]
    }
}