{
    "package": "native/jdk@22/bootstrap-maven/durian-swt.os@4.3.0",
    "version": "4.3.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "e956245cc1f4d445cb1f14ba8ea2536da6351d95",
            "url": "https://github.com/diffplug/durian-swt.git"
        },
        {
            "kind": "blob",
            "path": "./durian-swt.os-4.3.0.pom",
            "sha256": "435cff55789986dedaad717f68fba8d548249478562dcd84b22ad4d6566f440b",
            "url": "https://repo1.maven.org/maven2/com/diffplug/durian/durian-swt.os/4.3.0/durian-swt.os-4.3.0.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/jsr305@3.0.2"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/durian-swt.os@4.3.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find durian-swt.os/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $REPO/com/google/code/findbugs/jsr305/3.0.2/jsr305-3.0.2.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/durian-swt.os-4.3.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/diffplug/durian/durian-swt.os/4.3.0",
            "*:*:cp $WORKDIR/durian-swt.os-4.3.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/diffplug/durian/durian-swt.os/4.3.0/durian-swt.os-4.3.0.jar",
            "*:*:cp durian-swt.os-4.3.0.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/diffplug/durian/durian-swt.os/4.3.0/durian-swt.os-4.3.0.pom"
        ]
    }
}