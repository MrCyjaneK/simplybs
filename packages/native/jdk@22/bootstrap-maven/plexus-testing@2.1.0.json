{
    "package": "native/jdk@22/bootstrap-maven/plexus-testing@2.1.0",
    "version": "2.1.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "d30270ddfadde2963b29fff7e968125a3fba48ca",
            "url": "https://github.com/codehaus-plexus/plexus-testing.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/plexus@25",
        "*:*:native/jdk@22/bootstrap-maven/guava@33.6.0-jre",
        "*:*:native/jdk@22/bootstrap-maven/org.eclipse.sisu.plexus@0.9.0.M4",
        "*:*:native/jdk@22/bootstrap-maven/guice@5.1.0",
        "*:*:native/jdk@22/bootstrap-maven/junit-jupiter-api@5.14.4",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1",
        "*:*:native/jdk@22/bootstrap-maven/apiguardian-api@1.1.2",
        "*:*:native/jdk@22/bootstrap-maven/plexus-classworlds@2.6.0",
        "*:*:native/jdk@22/bootstrap-maven/plexus-utils@3.5.1"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/plexus-testing@2.1.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $REPO/org/eclipse/sisu/org.eclipse.sisu.plexus/0.9.0.M4/org.eclipse.sisu.plexus-0.9.0.M4.jar:$REPO/org/junit/jupiter/junit-jupiter-api/5.14.4/junit-jupiter-api-5.14.4.jar:$REPO/org/junit/platform/junit-platform-commons/1.14.4/junit-platform-commons-1.14.4.jar:$REPO/org/apiguardian/apiguardian-api/1.1.2/apiguardian-api-1.1.2.jar:$REPO/com/google/inject/guice/5.1.0/guice-5.1.0.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/codehaus/plexus/plexus-classworlds/2.6.0/plexus-classworlds-2.6.0.jar:$REPO/org/codehaus/plexus/plexus-utils/3.5.1/plexus-utils-3.5.1.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-testing-2.1.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-testing/2.1.0",
            "*:*:cp $WORKDIR/plexus-testing-2.1.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-testing/2.1.0/plexus-testing-2.1.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-testing/2.1.0/plexus-testing-2.1.0.pom"
        ]
    }
}