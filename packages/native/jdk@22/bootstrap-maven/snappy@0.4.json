{
    "package": "native/jdk@22/bootstrap-maven/snappy@0.4",
    "version": "0.4",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "e02f7c887d666afbdd11763f3a6ba22e68f53f15",
            "url": "https://github.com/dain/snappy.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/snappy@0.4"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' ! -name 'Hadoop*' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/snappy-0.4.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/iq80/snappy/snappy/0.4",
            "*:*:cp $WORKDIR/snappy-0.4.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/iq80/snappy/snappy/0.4/snappy-0.4.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/iq80/snappy/snappy/0.4/snappy-0.4.pom"
        ]
    }
}