{
    "package": "native/jdk@22/bootstrap-maven/plexus-archiver@4.10.4",
    "version": "4.10.4",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "1928ec6cb728f43df3e733ac2e81dfc63cdb3d10",
            "url": "https://github.com/codehaus-plexus/plexus-archiver.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/org.eclipse.sisu.inject@1.0.0",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1",
        "*:*:native/jdk@22/bootstrap-maven/jsr305@3.0.2",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/commons-io@2.20.0",
        "*:*:native/jdk@22/bootstrap-maven/plexus-utils@3.6.0",
        "*:*:native/jdk@22/bootstrap-maven/plexus-io@3.6.0",
        "*:*:native/jdk@22/bootstrap-maven/commons-compress@1.28.0",
        "*:*:native/jdk@22/bootstrap-maven/aircompressor@0.27",
        "*:*:native/jdk@22/bootstrap-maven/xz@1.10",
        "*:*:native/jdk@22/bootstrap-maven/zstd-jni@1.5.7-6",
        "*:*:native/jdk@22/bootstrap-maven/pom/plexus@24"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/plexus-archiver@4.10.4",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/com/google/code/findbugs/jsr305/3.0.2/jsr305-3.0.2.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/commons-io/commons-io/2.20.0/commons-io-2.20.0.jar:$REPO/org/codehaus/plexus/plexus-utils/3.6.0/plexus-utils-3.6.0.jar:$REPO/org/codehaus/plexus/plexus-io/3.6.0/plexus-io-3.6.0.jar:$REPO/org/apache/commons/commons-compress/1.28.0/commons-compress-1.28.0.jar:$REPO/io/airlift/aircompressor/0.27/aircompressor-0.27.jar:$REPO/org/tukaani/xz/1.10/xz-1.10.jar:$REPO/com/github/luben/zstd-jni/1.5.7-6/zstd-jni-1.5.7-6.jar -processorpath $REPO/org/eclipse/sisu/org.eclipse.sisu.inject/1.0.0/org.eclipse.sisu.inject-1.0.0.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar -processor org.eclipse.sisu.space.SisuIndexAPT6 -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-archiver-4.10.4.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-archiver/4.10.4",
            "*:*:cp $WORKDIR/plexus-archiver-4.10.4.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-archiver/4.10.4/plexus-archiver-4.10.4.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-archiver/4.10.4/plexus-archiver-4.10.4.pom"
        ]
    }
}