{
    "package": "native/jdk@22/bootstrap-maven/plexus-archiver@4.10.0",
    "version": "4.10.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "3ea9d5b51f8fa5ebe4bda781f8c23efed9b2978c",
            "url": "https://github.com/codehaus-plexus/plexus-archiver.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1",
        "*:*:native/jdk@22/bootstrap-maven/jsr305@3.0.2",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/commons-io@2.16.1",
        "*:*:native/jdk@22/bootstrap-maven/plexus-utils@4.0.2",
        "*:*:native/jdk@22/bootstrap-maven/plexus-io@3.5.0",
        "*:*:native/jdk@22/bootstrap-maven/commons-compress@1.26.2",
        "*:*:native/jdk@22/bootstrap-maven/aircompressor@0.27",
        "*:*:native/jdk@22/bootstrap-maven/xz@1.9",
        "*:*:native/jdk@22/bootstrap-maven/pom/plexus@18"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/plexus-archiver@4.10.0",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -cp $REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/com/google/code/findbugs/jsr305/3.0.2/jsr305-3.0.2.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/commons-io/commons-io/2.16.1/commons-io-2.16.1.jar:$REPO/org/codehaus/plexus/plexus-utils/4.0.2/plexus-utils-4.0.2.jar:$REPO/org/codehaus/plexus/plexus-io/3.5.0/plexus-io-3.5.0.jar:$REPO/org/apache/commons/commons-compress/1.26.2/commons-compress-1.26.2.jar:$REPO/io/airlift/aircompressor/0.27/aircompressor-0.27.jar:$REPO/org/tukaani/xz/1.9/xz-1.9.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/plexus-archiver-4.10.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-archiver/4.10.0",
            "*:*:cp $WORKDIR/plexus-archiver-4.10.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-archiver/4.10.0/plexus-archiver-4.10.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/codehaus/plexus/plexus-archiver/4.10.0/plexus-archiver-4.10.0.pom"
        ]
    }
}