{
    "package": "native/jdk@22/bootstrap-maven/maven-plugin-tools-annotations@3.15.2",
    "version": "3.15.2",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "f7ed01b82c390ff629cecdb3cda88ec9346cc92a",
            "url": "https://github.com/apache/maven-plugin-tools.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/maven@3.9-bin",
        "*:*:native/jdk@22/bootstrap-maven/maven-plugin-tools-api@3.15.2",
        "*:*:native/jdk@22/bootstrap-maven/maven-plugin-annotations@3.15.2",
        "*:*:native/jdk@22/bootstrap-maven/javax.inject@1",
        "*:*:native/jdk@22/bootstrap-maven/slf4j-api@1.7.36",
        "*:*:native/jdk@22/bootstrap-maven/asm@9.9.1",
        "*:*:native/jdk@22/bootstrap-maven/asm-util@9.9.1",
        "*:*:native/jdk@22/bootstrap-maven/qdox@2.2.0",
        "*:*:native/jdk@22/bootstrap-maven/jsoup@1.22.1",
        "*:*:native/jdk@22/bootstrap-maven/plexus-archiver@4.10.4"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/maven-plugin-tools-annotations@3.15.2",
            "*:*:REPO=$NATIVEPREFIX/share/maven/repository",
            "*:*:BOOT_LIB=$NATIVEPREFIX/maven-3.9-bootstrap/lib"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find maven-plugin-tools-annotations/src/main/java -name '*.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac --release 8 -cp $(printf '%s:' $BOOT_LIB/*.jar)$REPO/org/apache/maven/plugin-tools/maven-plugin-tools-api/3.15.2/maven-plugin-tools-api-3.15.2.jar:$REPO/org/apache/maven/plugin-tools/maven-plugin-annotations/3.15.2/maven-plugin-annotations-3.15.2.jar:$REPO/javax/inject/javax.inject/1/javax.inject-1.jar:$REPO/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar:$REPO/org/ow2/asm/asm/9.9.1/asm-9.9.1.jar:$REPO/org/ow2/asm/asm-util/9.9.1/asm-util-9.9.1.jar:$REPO/com/thoughtworks/qdox/qdox/2.2.0/qdox-2.2.0.jar:$REPO/org/jsoup/jsoup/1.22.1/jsoup-1.22.1.jar:$REPO/org/codehaus/plexus/plexus-archiver/4.10.4/plexus-archiver-4.10.4.jar -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/maven-plugin-tools-annotations-3.15.2.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugin-tools/maven-plugin-tools-annotations/3.15.2",
            "*:*:cp $WORKDIR/maven-plugin-tools-annotations-3.15.2.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugin-tools/maven-plugin-tools-annotations/3.15.2/maven-plugin-tools-annotations-3.15.2.jar",
            "*:*:cp maven-plugin-tools-annotations/pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugin-tools/maven-plugin-tools-annotations/3.15.2/maven-plugin-tools-annotations-3.15.2.pom"
        ]
    }
}