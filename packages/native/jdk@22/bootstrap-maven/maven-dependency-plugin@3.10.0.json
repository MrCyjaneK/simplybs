elocity/tools/velocity-tools-generic/3.1/velocity-tools-generic-3.1.jar",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/maven-dependency-plugin-3.10.0.jar -C $WORKDIR/classes . -C $WORKDIR/pluginxml .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugins/maven-dependency-plugin/3.10.0",
            "*:*:cp $WORKDIR/maven-dependency-plugin-3.10.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugins/maven-dependency-plugin/3.10.0/maven-dependency-plugin-3.10.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/org/apache/maven/plugins/maven-dependency-plugin/3.10.0/maven-dependency-plugin-3.10.0.pom"
