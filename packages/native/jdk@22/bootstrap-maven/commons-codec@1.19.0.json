{
    "package": "native/jdk@22/bootstrap-maven/commons-codec@1.19.0",
    "version": "1.19.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "351cb22e1e1948aaabb39a463dce631bea156125",
            "url": "https://github.com/apache/commons-codec.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/jdk@22/bootstrap-maven/pom/commons-parent@85"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/commons-codec@1.19.0"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/commons-codec-1.19.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-codec/commons-codec/1.19.0",
            "*:*:cp $WORKDIR/commons-codec-1.19.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-codec/commons-codec/1.19.0/commons-codec-1.19.0.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/commons-codec/commons-codec/1.19.0/commons-codec-1.19.0.pom"
        ]
    }
}