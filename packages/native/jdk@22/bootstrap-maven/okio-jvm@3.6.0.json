{
    "package": "native/jdk@22/bootstrap-maven/okio-jvm@3.6.0",
    "version": "3.6.0",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "0b9ace50635c9256cfa66db20a911b2c63c0deb6",
            "url": "https://github.com/square/okio.git"
        },
        {
            "kind": "blob",
            "path": "./okio-jvm-3.6.0.pom",
            "sha256": "61b4d7c515a0894ffad925fd7052620c1425a86433fd35113b5fab0de890a57f",
            "url": "https://repo1.maven.org/maven2/com/squareup/okio/okio-jvm/3.6.0/okio-jvm-3.6.0.pom"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22",
        "*:*:native/kotlin@1.9.10",
        "*:*:native/jdk@22/bootstrap-maven/kotlin-stdlib@1.9.10"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=work/okio-jvm@3.6.0",
            "*:*:KOTLIN_HOME=$NATIVEPREFIX/kotlin-1.9.10"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR/classes",
            "*:*:find okio/src/commonMain/kotlin -name '*.kt' >$WORKDIR/common.sources",
            "*:*:find okio/src/jvmMain/kotlin -name '*.kt' >$WORKDIR/jvm.sources",
            "*:*:if [ -d okio/src/jvmMain/java ]; then find okio/src/jvmMain/java -name '*.java' >>$WORKDIR/jvm.sources; fi",
            "*:*:cat $WORKDIR/common.sources $WORKDIR/jvm.sources >$WORKDIR/sources",
            "*:*:$KOTLIN_HOME/bin/kotlinc -jvm-target 1.8 -Xmulti-platform -Xcommon-sources=$(paste -sd, $WORKDIR/common.sources) -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/okio-jvm-3.6.0.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/squareup/okio/okio-jvm/3.6.0",
            "*:*:cp $WORKDIR/okio-jvm-3.6.0.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/squareup/okio/okio-jvm/3.6.0/okio-jvm-3.6.0.jar",
            "*:*:cp okio-jvm-3.6.0.pom $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/squareup/okio/okio-jvm/3.6.0/okio-jvm-3.6.0.pom"
        ]
    }
}