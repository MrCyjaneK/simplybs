{
    "package": "native/jdk@22/bootstrap-maven/json-simple@3.0.2",
    "version": "3.0.2",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "48cb56e4b5ec1f14860d469cf67f89b0c288c399",
            "url": "https://github.com/cliftonlabs/json-simple.git"
        }
    ],
    "dependencies": [
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/findutils",
        "*:*:native/jdk@22"
    ],
    "build": {
        "env": [
            "*:*:WORKDIR=build/json-simple@3.0.2"
        ],
        "steps": [
            "*:*:mkdir -p $WORKDIR",
            "*:*:find src/main/java -name '*.java' ! -name 'module-info.java' >$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/javac -d $WORKDIR/classes @$WORKDIR/sources",
            "*:*:$JAVA_HOME/bin/jar cf $WORKDIR/json-simple-3.0.2.jar -C $WORKDIR/classes .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/github/cliftonlabs/json-simple/3.0.2",
            "*:*:cp $WORKDIR/json-simple-3.0.2.jar $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/github/cliftonlabs/json-simple/3.0.2/json-simple-3.0.2.jar",
            "*:*:cp pom.xml $STAGING_DIR$NATIVEPREFIX/share/maven/repository/com/github/cliftonlabs/json-simple/3.0.2/json-simple-3.0.2.pom"
        ]
    }
}