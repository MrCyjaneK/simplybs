{
    "package": "native/meson",
    "version": "1.9.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "751b09390996163348612f0b106114256305ee40",
            "url": "https://github.com/mesonbuild/meson.git"
        }
    ],
    "dependencies": [
        "*:*:native/_/_",
        "*:*:native/python@3.11"
    ],
    "build": {
        "env": [],
        "steps": [
            "*:*:python3 ./packaging/create_zipapp.py --outfile meson.pyz --interpreter \"$(which python3)\" .",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/bin/",
            "*:*:mv meson.pyz $STAGING_DIR$NATIVEPREFIX/bin/meson"
        ]
    }
}