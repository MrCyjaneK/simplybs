{
    "package": "native/meson",
    "version": "1.9.1",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "751b09390996163348612f0b106114256305ee40",
            "url": "https://github.com/mesonbuild/meson.git"
        }
    ],
    "dependencies": [
        "all:native/python@3.11.13"
    ],
    "build": {
        "env": [],
        "steps": [
            "all:python3 ./packaging/create_zipapp.py --outfile meson.pyz --interpreter \"$(which python3)\" .",
            "all:mkdir -p $STAGING_DIR$PREFIX/native/bin/",
            "all:mv meson.pyz $STAGING_DIR$PREFIX/native/bin/meson"
        ]
    }
}