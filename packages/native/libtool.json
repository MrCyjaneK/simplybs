{
    "package": "native/libtool",
    "version": "2.5.4",
    "type": "native",
    "download": [
        {
            "kind": "tar.gz",
            "sha256": "da8ebb2ce4dcf46b90098daf962cffa68f4b4f62ea60f798d0ef12929ede6adf",
            "url": "http://ftpmirror.gnu.org/gnu/libtool/libtool-2.5.4.tar.gz"
        }
    ],
    "dependencies": [
        "*:*:native/_/_",
        "*:*:native/bash",
        "*:*:native/grep",
        "*:*:native/m4",
        "*:*:native/make",
        "*:*:native/sed"
    ],
    "build": {
        "env": [],
        "steps": [
            "*:*:bash ./configure --prefix=$NATIVEPREFIX",
            "*:*:make -j$NUM_CORES",
