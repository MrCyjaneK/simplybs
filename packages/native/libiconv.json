{
    "package": "native/libiconv",
    "version": "1.17",
    "type": "native",
    "download": [
        {
            "kind": "tar.gz",
            "sha256": "8f74213b56238c85a50a5329f77e06198771e70dd9a739779f4c02f65d971313",
            "url": "http://ftpmirror.gnu.org/gnu/libiconv/libiconv-1.17.tar.gz"
        }
    ],
    "dependencies": [
        "*:native/config",
        "*:native/make"
    ],
    "build": {
        "env": [
            "*:CFLAGS=$CFLAGS -fPIC",
            "*:config_opts=--prefix=$PREFIX/native --disable-nls --enable-static --disable-shared",
            "*:config_opts=$config_opts",
            "*linux:config_opts=$config_opts --with-pic"
        ],
        "steps": [
            "*:cp -f $PREFIX/native/share/config/config.guess build-aux/",
            "*:cp -f $PREFIX/native/share/config/config.sub build-aux/",
            "*:./configure $config_opts",
            "*:make -j$NUM_CORES",
            "*:make DESTDIR=$STAGING_DIR install"
        ]
    }
}