{
    "package": "native/make",
    "version": "4.4",
    "type": "native",
    "download": [
        {
            "kind": "tar.gz",
            "sha256": "581f4d4e872da74b3941c874215898a7d35802f03732bdccee1d4a7979105d18",
            "url": "http://ftpmirror.gnu.org/gnu/make/make-4.4.tar.gz"
        }
    ],
    "build": {
        "env": [],
        "steps": [
            "*:*:./configure --disable-dependency-tracking",
            "*:*:./build.sh",
            "*:*:mkdir -p $STAGING_DIR$PREFIX/native/bin",
            "*:*:cp make $STAGING_DIR/$PREFIX/native/bin/make",
            "*:*:ln -s make $STAGING_DIR$PREFIX/native/bin/gmake",
            "*:*:ln -s make $STAGING_DIR$PREFIX/native/bin/gnumake"
        ]
    }
}