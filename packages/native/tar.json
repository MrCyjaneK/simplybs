{
    "package": "native/tar",
    "version": "1.35",
    "type": "native",
    "download": [
        {
            "kind": "tar.xz",
            "sha256": "4d62ff37342ec7aed748535323930c7cf94acf71c3591882b26a7ea50f3edc16",
            "url": "http://ftpmirror.gnu.org/gnu/tar/tar-1.35.tar.xz"
        }
    ],
    "dependencies": [
        "*:*:native/libiconv",
        "*:*:native/make"
    ],
    "build": {
        "env": [
            "*:*:config_opts=--prefix=$PREFIX/native",
            "*:*:LIBS=-liconv"
