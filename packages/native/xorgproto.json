{
    "package": "native/xorgproto",
    "version": "2025.1",
    "type": "native",
    "download": [
        {
            "kind": "tar.gz",
            "sha256": "d6f89f65bafb8c9b735e0515882b8a1511e8e864dde5e9513e191629369f2256",
            "url": "https://xorg.freedesktop.org/archive/individual/proto/xorgproto-2025.1.tar.gz"
        }
    ],
    "dependencies": [
        "linux_*:*:native/_/_",
        "linux_*:*:native/bash",
        "linux_*:*:native/coreutils",
        "linux_*:*:native/findutils",
        "linux_*:*:native/gawk",
        "linux_*:*:native/grep",
        "linux_*:*:native/make",
        "linux_*:*:native/pkgconf",
        "linux_*:*:native/sed"
    ],
    "build": {
        "env": [],
        "steps": [
            "linux_*:*:bash ./configure --prefix=$NATIVEPREFIX --disable-dependency-tracking --enable-option-checking --without-fop --without-xmlto --without-xsltproc --disable-specs",
            "linux_*:*:make -j$NUM_CORES",
            "linux_*:*:make DESTDIR=$STAGING_DIR install",
            "linux_*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/lib/pkgconfig && if [ -d $STAGING_DIR$NATIVEPREFIX/share/pkgconfig ]; then mv $STAGING_DIR$NATIVEPREFIX/share/pkgconfig/*.pc $STAGING_DIR$NATIVEPREFIX/lib/pkgconfig/ 2>/dev/null || true; fi",
            "linux_*:*:rm -rf $STAGING_DIR$NATIVEPREFIX/share/doc $STAGING_DIR$NATIVEPREFIX/share/man $STAGING_DIR$NATIVEPREFIX/lib/*.la"
        ]
    }
}