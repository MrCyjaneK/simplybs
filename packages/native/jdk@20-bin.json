{
    "package": "native/jdk@20-bin",
    "version": "20.0.2",
    "type": "native",
    "download": [
        {
            "kind": "blob",
            "path": "./OpenJDK20U-jdk_x64_linux_hotspot_20.0.2_9.tar.gz",
            "sha256": "3d91842e9c172967ac397076523249d05a82ead51b0006838f5f0315ad52222c",
            "url": "https://github.com/adoptium/temurin20-binaries/releases/download/jdk-20.0.2%2B9/OpenJDK20U-jdk_x64_linux_hotspot_20.0.2_9.tar.gz"
        },
        {
            "kind": "blob",
            "path": "./OpenJDK20U-jdk_aarch64_linux_hotspot_20.0.2_9.tar.gz",
            "sha256": "b475bcc23db0bd618c815bb8f11d8e084dc58288ea3bcdf4e7f389ed41c89f56",
            "url": "https://github.com/adoptium/temurin20-binaries/releases/download/jdk-20.0.2%2B9/OpenJDK20U-jdk_aarch64_linux_hotspot_20.0.2_9.tar.gz"
        },
        {
            "kind": "blob",
            "path": "./OpenJDK20U-jdk_aarch64_mac_hotspot_20.0.2_9.tar.gz",
            "sha256": "6ef42b63581c0265c5a6b734e203bb922ee720571a8de46532ecca50a804c596",
            "url": "https://github.com/adoptium/temurin20-binaries/releases/download/jdk-20.0.2%2B9/OpenJDK20U-jdk_aarch64_mac_hotspot_20.0.2_9.tar.gz"
        }
    ],
    "dependencies": [
        "*:*:native/_/_",
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/gzip",
        "*:*:native/sed",
        "*:*:native/tar"
    ],
    "build": {
        "env": [
            "*:*:JDK_VERSION=20"
        ],
        "steps": [
            "linux_amd64:*:tar -xzf OpenJDK20U-jdk_x64_linux_hotspot_20.0.2_9.tar.gz",
            "linux_arm64:*:tar -xzf OpenJDK20U-jdk_aarch64_linux_hotspot_20.0.2_9.tar.gz",
            "darwin_arm64:*:tar -xzf OpenJDK20U-jdk_aarch64_mac_hotspot_20.0.2_9.tar.gz",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/jdk-20 $STAGING_DIR$NATIVEPREFIX/bin",
            "linux_*:*:cp -a jdk-20.0.2+9/. $STAGING_DIR$NATIVEPREFIX/jdk-20/",
            "darwin_arm64:*:cp -a jdk-20.0.2+9/Contents/Home/. $STAGING_DIR$NATIVEPREFIX/jdk-20/",
            "*:*:for tool in java javac jar javadoc javap jlink jmod jdeps keytool; do test -x $STAGING_DIR$NATIVEPREFIX/jdk-20/bin/$tool || continue; sed -e s/@JDK_VERSION@/20/g -e s/@TOOL@/$tool/g $PATCH_DIR/jdk/wrapper.sh > $STAGING_DIR$NATIVEPREFIX/bin/$tool; chmod +x $STAGING_DIR$NATIVEPREFIX/bin/$tool; cp $STAGING_DIR$NATIVEPREFIX/bin/$tool $STAGING_DIR$NATIVEPREFIX/bin/${tool}20; done",
            "*:*:$STAGING_DIR$NATIVEPREFIX/jdk-20/bin/jlink --module-path $STAGING_DIR$NATIVEPREFIX/jdk-20/jmods --add-modules ALL-MODULE-PATH --strip-debug --no-header-files --no-man-pages --output $STAGING_DIR$NATIVEPREFIX/jre-20",
            "*:*:$STAGING_DIR$NATIVEPREFIX/jdk-20/bin/java -version"
        ]
    }
}