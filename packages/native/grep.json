{
    "package": "native/grep",
    "version": "3.12",
    "type": "native",
    "download": [
        {
            "kind": "tar.xz",
            "sha256": "2649b27c0e90e632eadcd757be06c6e9a4f48d941de51e7c0f83ff76408a07b9",
            "url": "http://ftpmirror.gnu.org/gnu/grep/grep-3.12.tar.xz"
        }
    ],
    "dependencies": [
        "*:*:native/_/_",
        "*:*:native/bash",
        "*:*:native/make"
    ],
    "build": {
        "env": [
            "*:*:config_opts=--prefix=$NATIVEPREFIX",
            "windows_*:*:config_opts=$config_opts gl_cv_have_weak=no"
        ],
        "steps": [
            "*:*:bash ./configure $config_opts",
            "windows_*:*:bash $PATCH_DIR/native/_/drop-gnulib-wint-wrappers.sh",
            "*:*:make -j$NUM_CORES",
            "*:*:make DESTDIR=$STAGING_DIR install"
        ]
    }
}