{
    "package": "native/graalvm",
    "version": "22.0.2",
    "type": "native",
    "download": [
        {
            "kind": "git",
            "sha256": "1f72d5384cbf5a744b8284f874ad77947d2710bc",
            "url": "https://github.com/oracle/graal.git"
        },
        {
            "kind": "git",
            "path": "mx",
            "sha256": "5eb6d6f73d16a37f52c9d69815af479523513bdd",
            "url": "https://github.com/graalvm/mx.git"
        },
        {
            "kind": "blob",
            "path": "libffi-3.4.4.tar.gz",
            "sha256": "d66c56ad259a82cf2a9dfc408b32bf5da52371500b84745f7fb8b645712df676",
            "url": "https://github.com/libffi/libffi/releases/download/v3.4.4/libffi-3.4.4.tar.gz"
        },
        {
            "kind": "blob",
            "path": "ninja_syntax-1.7.2.tar.gz",
            "sha256": "342dc97b9e88a6495bae22953ee6063f91d2f03db6f727b62ba5c3092a18ef1f",
            "url": "https://files.pythonhosted.org/packages/source/n/ninja_syntax/ninja_syntax-1.7.2.tar.gz"
        }
    ],
    "dependencies": [
        "*:*:native/_/_",
        "*:*:native/bash",
        "*:*:native/coreutils",
        "*:*:native/git",
        "*:*:native/grep",
        "*:*:native/make",
        "*:*:native/ninja",
        "*:*:native/patch",
        "*:*:native/pkgconf",
        "*:*:native/python@3.14",
        "*:*:native/sed",
        "*:*:native/unzip",
        "*:*:native/zip",
        "*:*:native/zlib",
        "*:*:native/jdk",
        "*:*:native/findutils",
        "*:*:native/jdk@22/mvn/asm@9.5",
        "*:*:native/jdk@22/mvn/asm-tree@9.5",
        "*:*:native/jdk@22/mvn/asm-analysis@9.5",
        "*:*:native/jdk@22/mvn/asm-commons@9.5",
        "*:*:native/jdk@22/mvn/asm-util@9.5",
        "*:*:native/jdk@22/mvn/hamcrest-core@1.3",
        "*:*:native/jdk@22/mvn/commons-math3@3.2",
        "*:*:native/jdk@22/mvn/jopt-simple@4.6",
        "*:*:native/jdk@22/mvn/json@20231013",
        "*:*:native/jdk@22/mvn/antlr4-runtime@4.12.0",
        "*:*:native/jdk@22/mvn/jline-native@3.23.0",
        "*:*:native/jdk@22/mvn/jline-terminal@3.23.0",
        "*:*:native/jdk@22/mvn/jline-reader@3.23.0",
        "*:*:native/jdk@22/mvn/jline-style@3.23.0",
        "*:*:native/jdk@22/mvn/jline-builtins@3.23.0",
        "*:*:native/jdk@22/mvn/jmh-core@1.21",
        "*:*:native/jdk@22/mvn/jmh-generator-annprocess@1.21",
        "*:*:native/jdk@22/mvn/guava@31.0.1-jre",
        "*:*:native/jdk@22/mvn/jimfs@1.2",
        "*:*:native/jdk@22/mvn/icu4j@74.1",
        "*:*:native/jdk@22/mvn/icu4j-charset@74.1",
        "*:*:native/jdk@22/mvn/org-graalvm-visualvm-lib-jfluid-heap@2.1.4"
    ],
    "export-env": [
        "*:*:JAVA_HOME=$NATIVEPREFIX/graalvm",
        "*:*:GRAALVM_HOME=$NATIVEPREFIX/graalvm"
    ],
    "build": {
        "env": [
            "*:*:JAVA_HOME=$NATIVEPREFIX/jdk-22",
            "*:*:GRAALVM_HOME=$NATIVEPREFIX/graalvm",
            "*:*:MX_PYTHON=$NATIVEPREFIX/bin/python3.14",
            "*:*:JVMCI_VERSION_CHECK=ignore",
            "*:*:PYTHONPATH=$PATCH_DIR/graalvm/pylib",
            "linux_amd64:*:PATH=./.graal-tools:./mx:$NATIVEPREFIX/bin:$NATIVEPREFIX/_/bin",
            "linux_amd64:*:CC=./.graal-tools/gcc",
            "linux_amd64:*:CXX=./.graal-tools/g++",
            "linux_amd64:*:LIBRARY_PATH=$NATIVEPREFIX/_/sysroot/lib",
            "linux_arm64:*:PATH=./.graal-tools:./mx:$NATIVEPREFIX/bin:$NATIVEPREFIX/_/bin",
            "linux_arm64:*:CC=./.graal-tools/gcc",
            "linux_arm64:*:CXX=./.graal-tools/g++",
            "linux_arm64:*:LIBRARY_PATH=$NATIVEPREFIX/_/sysroot/lib",
            "darwin_arm64:*:PATH=./mx:$NATIVEPREFIX/bin:$NATIVEPREFIX/_/bin"
        ],
        "steps": [
            "linux_amd64:*:mkdir -p .graal-tools",
            "linux_amd64:*:ln -sf $NATIVEPREFIX/_/sysroot/lib/x86_64-linux-gnu/libc.so.6 .graal-tools/ldd",
            "linux_amd64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-objdump .graal-tools/objdump",
            "linux_amd64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-nm .graal-tools/nm",
            "linux_amd64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-ar .graal-tools/ar",
            "linux_amd64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-cxxfilt .graal-tools/c++filt",
            "linux_amd64:*:cp $PATCH_DIR/jdk/which .graal-tools/which",
            "linux_amd64:*:chmod +x .graal-tools/which",
            "linux_amd64:*:sed -e s|@CLANG21@|$NATIVEPREFIX/_/bin/clang-21|g -e s|@DRV@||g -e s|@SYSROOT@|$NATIVEPREFIX/_/sysroot|g -e s|@DUMPMACHINE@|x86_64-linux-gnu|g $PATCH_DIR/graalvm/cc > .graal-tools/gcc",
            "linux_amd64:*:sed -e s|@CLANG21@|$NATIVEPREFIX/_/bin/clang-21|g -e 's|@DRV@|--driver-mode=g++|g' -e s|@SYSROOT@|$NATIVEPREFIX/_/sysroot|g -e s|@DUMPMACHINE@|x86_64-linux-gnu|g $PATCH_DIR/graalvm/cc > .graal-tools/g++",
            "linux_amd64:*:chmod +x .graal-tools/gcc .graal-tools/g++",
            "linux_amd64:*:cp .graal-tools/gcc $NATIVEPREFIX/_/libexec/gcc-toolchain/bin/gcc",
            "linux_amd64:*:cp .graal-tools/g++ $NATIVEPREFIX/_/libexec/gcc-toolchain/bin/g++",
            "linux_amd64:*:cp .graal-tools/gcc $NATIVEPREFIX/_/libexec/gcc-toolchain/bin/x86_64-linux-gnu-gcc",
            "linux_amd64:*:cp .graal-tools/g++ $NATIVEPREFIX/_/libexec/gcc-toolchain/bin/x86_64-linux-gnu-g++",
            "linux_arm64:*:mkdir -p .graal-tools",
            "linux_arm64:*:ln -sf $NATIVEPREFIX/_/sysroot/lib/aarch64-linux-gnu/libc.so.6 .graal-tools/ldd",
            "linux_arm64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-objdump .graal-tools/objdump",
            "linux_arm64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-nm .graal-tools/nm",
            "linux_arm64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-ar .graal-tools/ar",
            "linux_arm64:*:ln -sf $NATIVEPREFIX/_/bin/llvm-cxxfilt .graal-tools/c++filt",
            "linux_arm64:*:cp $PATCH_DIR/jdk/which .graal-tools/which",
            "linux_arm64:*:chmod +x .graal-tools/which",
            "linux_arm64:*:sed -e s|@CLANG21@|$NATIVEPREFIX/_/bin/clang-21|g -e s|@DRV@||g -e s|@SYSROOT@|$NATIVEPREFIX/_/sysroot|g -e s|@DUMPMACHINE@|aarch64-linux-gnu|g $PATCH_DIR/graalvm/cc > .graal-tools/gcc",
            "linux_arm64:*:sed -e s|@CLANG21@|$NATIVEPREFIX/_/bin/clang-21|g -e 's|@DRV@|--driver-mode=g++|g' -e s|@SYSROOT@|$NATIVEPREFIX/_/sysroot|g -e s|@DUMPMACHINE@|aarch64-linux-gnu|g $PATCH_DIR/graalvm/cc > .graal-tools/g++",
            "linux_arm64:*:chmod +x .graal-tools/gcc .graal-tools/g++",
            "*:*:patch -p1 < $PATCH_DIR/graalvm/disable-exec-static-tramp.patch",
            "*:*:patch -p1 -d mx < $PATCH_DIR/graalvm/mx-file-digest.patch",
            "*:*:sed -i 's|\"https://repo1.maven.org/maven2/\",|\"file://'$NATIVEPREFIX'/share/maven/repository/\", \"https://repo1.maven.org/maven2/\",|' mx/src/mx/_impl/mx.py",
            "*:*:find . -path ./mx/tests -prune -o -name suite.py -exec sed -i /sourceDigest/d {} +",
            "*:*:sed -i 's|\"LLVM_ORG\" : {|\"LLVM_ORG\" : { \"optional\": True,|' sdk/mx.sdk/suite.py",
            "*:*:sed -i 's|\"LLVM_ORG_COMPILER_RT_LINUX\" : {|\"LLVM_ORG_COMPILER_RT_LINUX\" : { \"optional\": True,|' sdk/mx.sdk/suite.py",
            "*:*:sed -i 's|\"LLVM_ORG_SRC\" : {|\"LLVM_ORG_SRC\" : { \"optional\": True,|' sdk/mx.sdk/suite.py",
            "*:*:sed -i 's|\"LLVM_TOOLCHAIN\": {|\"LLVM_TOOLCHAIN\": { \"defaultBuild\": False,|' sdk/mx.sdk/suite.py",
            "*:*:sed -i 's|\"LLVM_NINJA_TOOLCHAIN\": {|\"LLVM_NINJA_TOOLCHAIN\": { \"defaultBuild\": False,|' sdk/mx.sdk/suite.py",
            "*:*:sed -i 's|\"org.graalvm.toolchain.test\" : {|\"org.graalvm.toolchain.test\" : { \"defaultBuild\": False,|' sdk/mx.sdk/suite.py",
            "*:*:sed -i 's|https://lafo.ssw.uni-linz.ac.at/pub/graal-external-deps/libffi-{version}.tar.gz|file://'$PWD'/libffi-3.4.4.tar.gz|' truffle/mx.truffle/suite.py",
            "*:*:sed -i 's|https://github.com/libffi/libffi/releases/download/v{version}/libffi-{version}.tar.gz|file://'$PWD'/libffi-3.4.4.tar.gz|' truffle/mx.truffle/suite.py",
            "*:*:sed -i 's|https://lafo.ssw.uni-linz.ac.at/pub/graal-external-deps/ninja_syntax-1.7.2.tar.gz|file://'$PWD'/ninja_syntax-1.7.2.tar.gz|' mx/mx.mx/suite.py",
            "*:*:cp $PATCH_DIR/graalvm/ce.env vm/mx.vm/simplybs",
            "*:*:$JAVA_HOME/bin/java -version",
            "*:*:mx/mx --version",
            "linux_amd64:*:cd vm && CPLUS_INCLUDE_PATH=$(echo $NATIVEPREFIX/_/include/c++/*):$(echo $NATIVEPREFIX/_/include/c++/*)/x86_64-linux-gnu LIBRARY_PATH=$NATIVEPREFIX/_/sysroot/lib ../mx/mx --java-home $JAVA_HOME --env simplybs build",
            "linux_arm64:*:cd vm && CPLUS_INCLUDE_PATH=$(echo $NATIVEPREFIX/_/include/c++/*):$(echo $NATIVEPREFIX/_/include/c++/*)/aarch64-linux-gnu LIBRARY_PATH=$NATIVEPREFIX/_/sysroot/lib ../mx/mx --java-home $JAVA_HOME --env simplybs build",
            "darwin_arm64:*:cd vm && ../mx/mx --java-home $JAVA_HOME --env simplybs build",
            "*:*:cd vm && ../mx/mx --java-home $JAVA_HOME --env simplybs graalvm-home > ../.graalvm-home",
            "*:*:mkdir -p $STAGING_DIR$NATIVEPREFIX/graalvm $STAGING_DIR$NATIVEPREFIX/bin",
            "*:*:cp -a $(cat .graalvm-home)/. $STAGING_DIR$NATIVEPREFIX/graalvm/",
            "*:*:sed -e s/@TOOL@/java/g $PATCH_DIR/graalvm/wrapper.sh > $STAGING_DIR$NATIVEPREFIX/bin/java",
            "*:*:sed -e s/@TOOL@/javac/g $PATCH_DIR/graalvm/wrapper.sh > $STAGING_DIR$NATIVEPREFIX/bin/javac",
            "*:*:sed -e s/@TOOL@/jar/g $PATCH_DIR/graalvm/wrapper.sh > $STAGING_DIR$NATIVEPREFIX/bin/jar",
            "*:*:sed -e s/@TOOL@/native-image/g $PATCH_DIR/graalvm/wrapper.sh > $STAGING_DIR$NATIVEPREFIX/bin/native-image",
            "*:*:chmod +x $STAGING_DIR$NATIVEPREFIX/bin/java $STAGING_DIR$NATIVEPREFIX/bin/javac $STAGING_DIR$NATIVEPREFIX/bin/jar $STAGING_DIR$NATIVEPREFIX/bin/native-image",
            "*:*:$STAGING_DIR$NATIVEPREFIX/graalvm/bin/java -version",
            "*:*:$STAGING_DIR$NATIVEPREFIX/graalvm/bin/native-image --version"
        ]
    }
}