{
    "package": "libffi",
    "version": "v3.5.2",
    "type": "host",
    "download": [
        {
            "kind": "git",
            "sha256": "e2eda0cf72a0598b44278cc91860ea402273fa29",
            "url": "https://github.com/libffi/libffi.git"
        }
    ],
    "dependencies": [
        "*:*-linux-gnu:native/_",
        "*:*-linux-gnu:native/autoconf",
        "*:*-linux-gnu:native/automake",
        "*:*-linux-gnu:native/libtool",
        "*:*-linux-gnu:native/m4",
        "*:*-linux-gnu:native/perl"
    ],
    "build": {
        "steps": [
            "*:*-linux-gnu:./autogen.sh",
            "*:*-linux-gnu:./configure --host=$HOST --prefix=$PREFIX --enable-static --disable-shared --disable-docs --with-pic",
            "*:*-linux-gnu:make -j$NUM_CORES",
            "*:*-linux-gnu:make install DESTDIR=$STAGING_DIR"
        ]
    }
}